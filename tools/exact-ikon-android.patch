+/** The launcher icon's resources from app.json's `icons` (the web manifest's `src`, `sizes`, `purpose`), or null when
+ * it names no PNG: the largest `maskable` PNG becomes an adaptive icon's foreground on white (Android keeps the middle
+ * 72 of its 108 dp, so its art belongs in the middle two thirds), the largest `any` one the legacy icon. */
+function androidIconRes(app) {
+  const icons = (Array.isArray(app.manifest?.icons) ? app.manifest.icons : [])
+    .filter((i) => typeof i?.src === 'string' && /\.png$/i.test(i.src) && existsSync(resolve(app.dir, i.src)));
+  const size = (i) => Math.max(0, ...String(i.sizes ?? '').split(/\s+/).map((s) => Number(s.split('x')[0]) || 0));
+  const largest = (purpose) => icons.filter((i) => String(i.purpose ?? 'any').split(/\s+/).includes(purpose)).sort((a, b) => size(b) - size(a))[0];
+  const maskable = largest('maskable'), any = largest('any') ?? maskable;
+  if (!any) return null;
+  const dir = resolve(apkDirs(app).app, 'icon-res');
+  rmSync(dir, { recursive: true, force: true });
+  mkdirSync(resolve(dir, 'mipmap-xxxhdpi'), { recursive: true });
+  copyFileSync(resolve(app.dir, any.src), resolve(dir, 'mipmap-xxxhdpi/ic_launcher.png'));
+  if (maskable) {
+    copyFileSync(resolve(app.dir, maskable.src), resolve(dir, 'mipmap-xxxhdpi/ic_launcher_foreground.png'));
+    mkdirSync(resolve(dir, 'mipmap-anydpi-v26'), { recursive: true });
+    writeFileSync(resolve(dir, 'mipmap-anydpi-v26/ic_launcher.xml'), ['<?xml version="1.0" encoding="utf-8"?>',
+      '<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">',
+      '    <background android:drawable="@android:color/white" />',
+      '    <foreground android:drawable="@mipmap/ic_launcher_foreground" />', '</adaptive-icon>', ''].join('\n'));
+  }
+  return dir;
+}
