// Laporin di Exact: tampilan laporin-apps (bahasa rupa SAKSI) di atas inti Rust (data/).
// Setiap sumber data di bawah dijawab oleh data/src/lib.rs: umpan & komentar dari LAPORIN_SITUS
// (bawaan mock-server, yang meneruskan fire.nusantara.earth plus suka & komentar mock), laporan dikirim ke
// server laporan (LAPORIN_API, mock-server laporin-apps) dan salinannya di app:/data. Foto bukti dari galeri
// lewat @exact/photos. Akun (Google lewat paket/masuk-google, email), verifikasi KTP, suka dan "Laporan saya" dari server laporan; peta dari
// laporin.app dan peta laporan di sekitar (MapLibre lokal di assets/peta), keduanya WebView paket lokal
// paket/web; video diputar MediaPlayer (paket lokal paket/video); kamera Lapor dari @exact/camera di atas
// @exact/media-capture.

use getUserMedia, applyConstraints, stopTrack, mediaStreamTrack, enumerateDevices, cameraStatus, MediaStream, MediaStreamTrack, MediaDeviceList, CameraStatus, MediaTrackConstraints from "@exact/media-capture"
use takePhoto, Photo from "@exact/camera"
use photoAssets, photoLibraryStatus, copyPhotoAsset, PhotoAssetList, PhotoLibraryStatus, PhotoCopy from "@exact/photos"
use getCurrentPosition, geolocationStatus, GeolocationPosition, GeolocationStatus from "@exact/geolocation"

font "Poppins"
  400 = "assets/fonts/Poppins-Regular.ttf"
  500 = "assets/fonts/Poppins-Medium.ttf"
  600 = "assets/fonts/Poppins-SemiBold.ttf"
  700 = "assets/fonts/Poppins-Bold.ttf"

routes nav
  tab beranda "/"
    laporan "/laporan/:id"
    komentar "/komentar/:id"
    foto "/foto/:id/:indeks"
    laporkan "/laporkan/:id"
    cari "/cari"
    lapor "/lapor"
    galeri "/galeri"
    kamera "/kamera"
    live "/live"
    tonton "/tonton/:ruang"
    terkirim "/terkirim"
    pengaturan "/pengaturan"
    verifikasi "/verifikasi"
  tab peta "/peta"
  tab siaran "/siaran"
  tab profil "/profil"

shape Waktu
  epochAtZero: number
  utcOffset: number

shape Laporan
  id: string
  slug: string
  judul: string
  pulau: string
  tempat: string
  desa: string
  tanggal: string
  tanggalPendek: string
  lokasi: string
  lintang: string
  bujur: string
  lat: number
  lng: number
  deskripsi: string
  sampul: string
  sampulKecil: string
  kredit: string
  inisial: string
  jumlahKredit: number
  galeri: string[]
  // Sejajar dengan `galeri`: alamat video media itu, "" untuk foto.
  galeriVideo: string[]
  jumlahMedia: number
  adaVideo: bool
  vertikal: bool
  suka: number
  komentar: number

shape Pulau
  nama: string
  jumlah: number

shape Sumber
  nama: string
  inisial: string
  jumlah: number

shape Umpan
  laporan: Laporan[]
  pulau: Pulau[]
  provinsi: Pulau[]
  sumber: Sumber[]

shape Komentar
  id: string
  nama: string
  inisial: string
  isi: string
  waktu: string
  balasan: number

shape LaporanSaya
  id: string
  judul: string
  deskripsi: string
  pengirim: string
  status: string
  dibuat: string
  lampiran: number
  anonim: bool

shape Sesi
  masuk: bool
  nama: string
  inisial: string
  email: string
  laporan: number
  tayang: number
  disukai: number

shape LaporanAkun
  id: string
  judul: string
  status: string
  dibuat: string
  sampul: string
  berkas: number

// Siaran langsung (data/src/siaran.rs): token LiveKit dari server laporan, galat di `galat`.
shape TokenLive
  url: string
  token: string
  ruang: string
  galat: string

// pratinjauUrl/pratinjauToken: token peserta tersembunyi untuk video bisu di kartu (kosong bila belum ada).
shape SiaranPublik
  ruang: string
  judul: string
  nama: string
  mulai: number
  penonton: number
  pratinjauUrl: string
  pratinjauToken: string

shape Viewport
  width: number
  height: number
  prefersColorScheme: string

shape Balasan
  ok: bool
  galat: string

// Alamat yang dicek paket notifikasi di latar (alamatKabar()).
shape AlamatKabar
  umpan: string
  live: string
  situs: string

// Verifikasi KTP akun (GET /api/mobile/saya/verifikasi): "belum", "menunggu", "disetujui", "ditolak"; "" = tamu atau
// belum termuat.
shape StatusKtp
  status: string
  alasan: string
  diajukan: string

// Angka ringkas: "1,2 rb" / "1.2K" diisi pemanggil lewat t("angka.ribuan", utuh=ribuUtuh(n), desimal=ribuDesimal(n)).
fn hitung(n: number, ribuan: string): string = n >= 1000 ? ribuan : n.toString()
fn ribuUtuh(n: number): number = floor(round(n / 100) / 10)
fn ribuDesimal(n: number): number = round(n / 100) % 10
fn ribuan(n: number): string = n >= 1000 ? `${floor(n / 1000)}.${(n % 1000 + 1000).toString().slice(1)}` : n.toString()
fn cocokTeks(t: string, q: string): bool = t.toLowerCase().includes(q.trim().toLowerCase())
fn cocok(l: Laporan, q: string): bool = cocokTeks(l.judul, q) or cocokTeks(l.lokasi, q) or cocokTeks(l.tempat, q) or cocokTeks(l.pulau, q) or cocokTeks(l.deskripsi, q) or cocokTeks(l.kredit, q)
fn gambarKe(l: Laporan, s: string): string = match parseNumber(s) { case some(n) => (match l.galeri.at(n) { case some(g) => g, case none => l.sampul }), case none => l.sampul }
fn videoKe(l: Laporan, i: number): string = match l.galeriVideo.at(i) { case some(v) => v, case none => "" }
// Suka efektif: daftar server, ditambah atau dibatalkan dari HP ini sejak daftar itu dimuat.
fn sukaDari(id: string, server: string[], tambah: string[], batal: string[]): bool = (server.includes(id) and not batal.includes(id)) or tambah.includes(id)
// Angka suka di Detail: angka umpan ditambah/dikurangi suka dari HP ini sejak umpan dimuat.
fn jumlahSuka(n: number, awal: bool, kini: bool): number = kini and n < 1 ? 1 : n + (kini and not awal ? 1 : 0) - (awal and not kini and n > 0 ? 1 : 0)
fn videoDari(l: Laporan, s: string): string = match parseNumber(s) { case some(n) => videoKe(l, n), case none => "" }
// Satu laporan [id, lat, lng, pulau] dan lokasiku untuk JSON peta (assets/peta/sekitar.html).
fn titikPeta(l: Laporan): string = `["${l.id}",${l.lat},${l.lng},"${l.pulau}"]`
// Keterangan satelit di lembar Lapisan: "MODIS · 1.234 titik" dari info hotspot halaman peta. Halaman peta hanya
// mengunduh dan mengabarkan hotspot selama satu satelit menyala; sebelum itu (info kosong) cukup nama sensornya.
// `galat`, `memuat`, `titik` = teks terjemahan dari pemanggil (t() tidak boleh di fungsi tingkat atas).
fn ketSatelit(alat: string, info: string, i: number, galat: string, memuat: string, titik: string): string = info == "" ? alat : bagian(info, 0) == "galat" ? galat : bagian(info, 0) == "memuat" or bagian(info, i) == "" ? `${alat} · ${memuat}` : `${alat} · ${bagian(info, i)} ${titik}`
fn lokasikuPeta(ada: bool, lat: number, lng: number): string = ada ? `[${lat},${lng}]` : "null"
// Baris keterangan kartu peta: tempat · jarak · tanggal, seperti BarisKejadian laporin-apps.
fn keteranganPeta(l: Laporan, jarak: string): string = [l.tempat != "" ? l.tempat : l.pulau, jarak, l.tanggalPendek].filter(x => x != "" and x != "-").join(" · ").toUpperCase()
// Siaran langsung: durasi "mm:ss" (menit terus naik lewat 60), waktu sejak mulai, inisial, komentar "nama\tisi".
fn dua(n: number): string = n < 10 ? `0${n}` : `${n}`
fn durasiTeks(ms: number): string = `${dua(floor(max(ms, 0) / 60000))}:${dua(floor(max(ms, 0) / 1000) % 60)}`
// Teks "baru saja" / "N menit lalu" / "N jam lalu" sudah diterjemahkan pemanggil; fungsi ini hanya memilih.
fn lalu(mulai: number, kini: number, baru: string, menit: string, jam: string): string = kini - mulai < 60000 ? baru : kini - mulai < 3600000 ? menit : jam
fn inisialNama(n: string): string = n.trim() == "" ? "W" : n.trim().slice(0, 1).toUpperCase()
fn angkaDari(t: string): number = match parseNumber(t) { case some(n) => n, case none => 0 }
// Komentar siaran "peran\tnama\tisi" (peran dari identitas LiveKit: petugas, pelapor, warga; "saya" = komentar sendiri).
fn bagian(c: string, i: number): string = match c.split("\t").at(i) { case some(n) => n, case none => "" }
fn komentarPeran(c: string): string = bagian(c, 0)
fn komentarNama(c: string): string = bagian(c, 1)
fn komentarIsi(c: string): string = c.slice(komentarPeran(c).length + komentarNama(c).length + 2)
// `anda`, `petugas`, `pelapor` = teks terjemahan dari pemanggil.
fn labelKomentar(c: string, anda: string, petugas: string, pelapor: string): string = komentarPeran(c) == "saya" ? anda.toUpperCase() : komentarNama(c).toUpperCase() + (komentarPeran(c) == "petugas" ? ` · ${petugas.toUpperCase()}` : komentarPeran(c) == "pelapor" ? ` · ${pelapor.toUpperCase()}` : "")
fn warnaKomentar(c: string): string = komentarPeran(c) == "petugas" ? "aksen.isi" : komentarPeran(c) == "warga" ? "media.warga" : "media.teks"
fn hitungHati(n: number, ribuan: string): string = n >= 1000 ? ribuan : `${n}`
// Kualitas video (PROFIL_SIARAN laporin-apps) dan warna ikon sinyal menurut mutu sambungan LiveKit.
// Teks terjemahan (t()) datang dari pemanggil sebagai parameter; fungsi hanya memilih menurut kode mutu.
fn labelMutuSiar(m: string, hemat: string, otomatis: string): string = m == "fhd60" ? "Full HD 60 fps" : m == "hd30" ? "HD 30 fps" : m == "hemat" ? hemat : otomatis
fn ketMutuSiar(m: string, fhd60: string, hd30: string, hemat: string, otomatis: string): string = m == "fhd60" ? fhd60 : m == "hd30" ? hd30 : m == "hemat" ? hemat : otomatis
fn warnaSinyal(q: string, tertahan: bool): string = tertahan ? "media.oranye" : q == "excellent" ? "media.hijau" : q == "good" ? "media.kuning" : q == "poor" ? "media.oranye" : q == "lost" ? "aksen.isi" : "media.mati"
// Penonton: lapisan simulcast "label\tlaju" dari yang tertinggi; pilihan "0".."2" = lapisan dari yang terendah.
fn labelLapisanKe(lapisan: string[], m: string): string = match lapisan.at(lapisan.length - 1 - angkaDari(m)) { case some(l) => bagian(l, 0), case none => "" }
fn labelMutuTonton(m: string, kini: string, lapisan: string[]): string = m == "otomatis" ? (kini == "" ? "AUTO" : `AUTO · ${kini}`) : labelLapisanKe(lapisan, m)
fn ketOtomatis(kini: string, laju: string, dasar: string, sekarang: string): string = dasar + (kini != "" ? ` · ${sekarang}` : "") + (laju != "" ? ` · ${laju}` : "")
fn ketLapisan(laju: string, i: number, n: number, asli: string, hemat: string): string = i == 0 ? asli : i == n - 1 ? hemat : laju

// Titik live berdenyut (TitikLive) dan titik LIVE berkedip (LencanaLive) laporin-apps.
keyframes denyut
  from opacity=0.5 scale=0.5
  to opacity=0 scale=1.4
keyframes kedip
  0% opacity=1
  50% opacity=0.15
  100% opacity=0.15
fn videoPertama(l: Laporan): string = match first(l.galeriVideo.filter(v => v != "")) { case some(v) => v, case none => "" }
fn angkaKe(xs: string[], i: number): number = match xs.at(i) { case some(x) => (match parseNumber(x) { case some(n) => n, case none => 0 }), case none => 0 }
// 75000 ms → "1:15".
fn jam(ms: number): string = `${floor(ms / 60000)}:${floor(ms / 1000) % 60 < 10 ? "0" : ""}${floor(ms / 1000) % 60}`
// Tinggi kartu kisi berundak (tinggi sampul seperti aslinya, 160–250). Kisi bertambah 15 kartu sekali: kolom kiri
// mendapat 8 dan kanan 7, jadi 15 pertama membuat kanan lebih tinggi ±satu jarak kartu dan 15 berikutnya sebaliknya;
// ujung setiap tambahan rata dan kolom tidak timpang saat gulir tanpa ujung memuat ratusan kartu.
fn rasioKisi(i: number): string = `174 / ${match [220, 250, 170, 230, 190, 220, 160, 250, 230, 190, 170, 230, 200, 200, 160, 190, 250, 160, 220, 230, 190, 170, 250, 220, 230, 160, 200, 200, 230, 170].at(i % 30) { case some(h) => h, case none => 200 }}`
fn mutlak(n: number): number = n < 0 ? 0 - n : n
// Sampul dari simpanan HP bila siapkanSampul sudah menyimpannya (urls dan lokal sejajar), selain itu alamat server.
fn sampulDari(url: string, urls: string[], lokal: string[]): string = urls.indexOf(url) < 0 ? url : (match lokal.at(urls.indexOf(url)) { case some(p) => (p != "" ? p : url), case none => url })
// Letak media i di penggeser Detail yang berputar (n media, k tampil): 0 tampil, 1 kanan, -1 kiri, 9 tak dipasang.
// Dua media: tetangga yang sama ada di sisi arah geseran, dan saat diam di sisi yang baru ditinggalkan (arah 1 = maju).
fn letakMedia(i: number, k: number, n: number, geser: number, arah: number): number = i == k ? 0 : n == 2 ? (geser < 0 ? 1 : geser > 0 ? -1 : 0 - arah) : (i - k + n) % n == 1 ? 1 : (k - i + n) % n == 1 ? -1 : 9
fn hanyaAngka(v: string): string = v.split("").filter(c => "0123456789".includes(c)).join("")

component Laporin
  state pulau = ""
  state urutan = "terbaru"
  state kueri = ""
  state judul = ""
  state deskripsi = ""
  state nama = ""
  state anonim = false
  state galat = ""
  state pilihan = []
  // Jalur salinan tiap foto terpilih (dari balasan copyPhotoAsset), sejajar dengan `pilihan`.
  state berkasFoto = []
  // Galeri dibaca dengan limit baru saat formulir dibuka: bacaan saat boot mendahului terikatnya modul foto
  // native dan tertahan di tiket izin pengganti (Exact pre-1.0), jadi argumen baru meminta lagi ke modulnya.
  state batasGaleri = 1
  // Masuk dengan Google: nomor permintaan untuk paket/masuk-google (naik = buka pemilih akun) dan galatnya.
  state nomorGoogle = 0
  state galatGoogle = ""
  // Kisi Beranda tampil 15 kartu sekali, ditambah saat penanda di bawahnya mendekati layar (gulir tanpa ujung).
  // Sampul 15 kartu berikutnya diunduh diam-diam lebih dulu (pramuatKisi), selagi 15 kartu yang tampil digulir,
  // jadi kartu baru menggambar sampulnya dari HP, bukan dari jaringan.
  state batasKisi = 15
  state pramuatKisi = false
  // Kamera dipakai formulir Lapor ("lapor") atau verifikasi KTP ("ktp"); foto KTP yang sedang diperiksa dan yang dipakai.
  state kameraUntuk = "lapor"
  state fotoKtpBaru = ""
  state fotoKtp = ""
  state nikKtp = ""
  state galatKtp = ""
  state bidangKtp = ""
  state verifikasiDariLive = false
  // Halaman kosong 1×1 yang memanaskan mesin WebView, dilepas lagi begitu dimuat (lihat task panaskanWeb).
  state panasWeb = "belum"
  // Lembar "Verifikasi singkat" (Turnstile) sebelum laporan tamu/anonim dikirim; nomor naik = muat ulang halamannya.
  state captchaTerbuka = false
  state nomorCaptcha = 0
  state galatCaptcha = ""
  // Tab Peta: mode (laporan, asap, angin), saringan pulau, lapisan (titik laporan, asap, tiga satelit FIRMS), bola dunia,
  // palet asap, lembar yang terbuka, dan kabar halaman peta (siap, hotspot yang diketuk, info hotspot & asap, tinggi
  // bilah waktu dalam px).
  state modePeta = "laporan"
  state pulauPeta = ""
  state lapisanTitik = true
  state lapisanAsap = true
  state satelitPeta = [false, false, false]
  state globePeta = false
  state gayaAsap = 0 persist
  state lembarPeta = ""
  state topikPanduan = "hotspot"
  state petaSiap = false
  state hotspotPeta = ""
  state infoHotspot = ""
  state infoAsap = ""
  state tinggiBilahPeta = 0
  // Laporan yang diketuk di peta sekitar, jaraknya dari lokasiku (dihitung halaman peta: Contract tanpa akar
  // kuadrat), dan perintah kamera terakhir (nomornya naik tiap tombol, jenisnya: rumah, lokasi, masuk, keluar).
  state idPetaSekitar = ""
  state jarakPetaSekitar = "-"
  state nomorPerintahPeta = 0
  state jenisPerintahPeta = ""
  // Lokasiku ditekan: peta terbang ke posisi baru begitu GPS menjawab.
  state ikutiLokasiPeta = false
  // Siaran langsung. Layar Live: tahap "siapkan" → "siaran" (halaman assets/live/siar.html) → "selesai". Nomor yang
  // naik (akhiri, komentar, suka) adalah perintah ke halaman. Komentar terakhir "nama\tisi", paling baru di akhir.
  state judulLive = ""
  state tahapLive = "siapkan"
  state galatLive = ""
  state liveTerhubung = false
  state akhiriDiminta = false
  state livePutus = false
  state mulaiLiveMs = 0
  state durasiLiveAkhir = 0
  state kiniMs = 0
  state penontonLive = 0
  state sukaLive = 0
  state komentarLive = []
  state hadapLive = "environment"
  state bisuLive = false
  state nomorAkhiriLive = 0
  state isiKomentarLive = ""
  state nomorKomentarLive = 0
  state teksKomentarLive = ""
  // Layar Tonton: "" (menyambung), "terhubung", "video", "menunggu" (pelapor terputus), "berakhir", "galat".
  state statusTonton = ""
  state galatTonton = ""
  state ruangTonton = ""
  state judulTonton = ""
  state namaTonton = ""
  state mulaiTonton = 0
  state penontonTonton = 0
  state sukaTonton = 0
  // Kualitas video (diingat untuk siaran berikutnya), lembar di atas siaran ("mutu", "penonton"), sinyal pelapor dari
  // siar.html, daftar penonton ("peran\tnama\t1 bila diri sendiri"), hati, lapisan video Tonton, mode bersih Tonton.
  state mutuSiar = "otomatis" persist
  state mutuTonton = "otomatis" persist
  state lembarLive = ""
  state sinyalLive = "unknown"
  state sinyalTertahan = false
  state sinyalTeks = ""
  state gantiMutuLive = false
  state putusSementara = false
  state daftarPenonton = []
  state nomorSukaLive = 0
  state sukaTotalTonton = 0
  state kualitasTonton = ""
  state lajuTonton = ""
  state lapisanTonton = []
  state bersihTonton = false
  // Lapor konten: laporan (umpan) atau siaran (Tonton), judul siaran yang dilaporkan.
  state jenisLapor = "laporan"
  state judulLapor = ""
  // Tema dipaksa dari tombol bulan/matahari di Beranda (kosong = ikut HP); bahasa hanya preferensi, seperti aslinya.
  state tema = "" persist
  state bahasa = "ID" persist
  // Notifikasi (paket notifikasi, tanpa Firebase): pilihan tersimpan; izin dari HP ("diberi", "ditolak", "tanya");
  // `mintaIzinNotif` bertambah = minta izin (dialog Android, atau pengaturan notifikasi HP bila sudah ditolak).
  state notifLive = true persist
  state notifLaporan = true persist
  state izinNotif = ""
  state mintaIzinNotif = 0
  state menyalin = ""
  state menyalinGambar = ""
  state gambarFoto = []
  state simpanan = [] persist
  // Yang membuat tamu diminta masuk: "menyukai" atau "menyimpan" (teks dialog perlu-masuk).
  state perluMasukUntuk = "menyukai"
  state filterCari = "semua"
  state isiKomentar = ""
  state alasanLapor = ""
  state catatanLapor = ""
  // Suka dari HP ini di atas daftar server (`disukai`): ditambah atau dibatalkan sejak daftar itu dimuat.
  state sukaTambah = []
  state sukaBatal = []
  state idSuka = ""
  // Video kartu sorotan diputar tanpa suara sampai warga menyalakannya, seperti aslinya.
  state bisuSorotan = true
  // Kamera Lapor: trek video yang dipegang, kamera yang dipakai, dan lampu kilat untuk foto berikutnya.
  state track = ""
  state hadap = "environment"
  state lampu = false
  resource waktu = exactTime() as shape Waktu
  resource viewport = exactViewport() as shape Viewport
  // Tampilan yang sedang terlihat: tema yang dikunci, atau skema HP saat ikut HP (ikon Tema di Pengaturan).
  derive gelapKini = tema == "gelap" or (tema == "" and viewport.prefersColorScheme == "dark")
  // Umpan yang tersimpan di HP (app:/data/umpan.json, ditulis muatUmpan) tampil seketika saat aplikasi dibuka, lalu
  // diganti umpan baru dari server begitu tiba; tanpa jaringan yang tersimpan tetap tampil.
  resource umpanBaru = muatUmpan() as shape Umpan else empty()
  resource umpanTersimpan = muatUmpanTersimpan() as shape Umpan else empty()
  derive umpanMentah = umpanBaru.laporan.length > 0 ? umpanBaru : umpanTersimpan
  // Preload seperti Instagram: logo di tengah setiap kali aplikasi dibuka (bukan saat kembali dari latar belakang),
  // paling sebentar 1 detik. Pembukaan pertama (belum ada umpan tersimpan) menunggu umpan tiba dan sampul sorotan + 4
  // kartu pertama termuat (pengamatnya di lapisan preload, berbagi unduhan dengan kartu di bawahnya), atau umpan gagal
  // (tanpa jaringan: Beranda menawarkan coba lagi); bukan siapkanSampul, yang mengunduh satu per satu (±8 detik).
  // Berikutnya: umpan tersimpan tampil dan sampulnya sudah berkas di HP, paling lama 2,5 detik. Batas 15 detik.
  state preloadSelesai = false
  state preloadMinimal = false
  state preloadCukup = false
  state probeTermuat = 0
  derive tampilPreload = not preloadSelesai
  derive pembukaanPertama = not pending(umpanTersimpan) and umpanTersimpan.laporan.length == 0
  derive urlProbe = pembukaanPertama ? urlSampulAwal.slice(0, 5) : []
  derive siapAwal = (pembukaanPertama ? ((umpanBaru.laporan.length > 0 and probeTermuat >= urlProbe.length) or failed(umpanBaru))
    : (umpanTersimpan.laporan.length > 0 and (not pending(sampulLokal) or preloadCukup)))
  // Sampul yang tampil pertama (sorotan + 16 kartu teratas; pulau dan urutan tidak disimpan, jadi selalu Semua ·
  // Terbaru saat dibuka) juga disimpan di HP: cache gambar Exact di Android hilang setiap aplikasi ditutup.
  derive urlSorotanAwal = match first(umpanMentah.laporan.filter(l => l.sampul != "")) { case some(l) => [l.sampul], case none => [] }
  derive urlSampulAwal = urlSorotanAwal.concat(umpanMentah.laporan.slice(0, 16).map(l => l.sampulKecil).filter(u => u != ""))
  resource sampulLokal = siapkanSampul(urlSampulAwal) as shape string[] else empty()
  // Pembukaan pertama (tanpa umpan tersimpan) tetap memakai alamat server yang sudah termuat: menukarnya ke berkas
  // begitu siapkanSampul selesai akan memuat ulang setiap sampul di depan mata.
  derive umpan = umpanTersimpan.laporan.length == 0 ? umpanMentah : Umpan(umpanMentah, laporan=umpanMentah.laporan.map(l => Laporan(l,
    sampul=sampulDari(l.sampul, urlSampulAwal, sampulLokal), sampulKecil=sampulDari(l.sampulKecil, urlSampulAwal, sampulLokal))))
  // Putaran memuat: saat belum ada laporan sama sekali, atau saat umpan dimuat ulang (ketuk Beranda lagi); bukan
  // saat umpan tersimpan sedang diperbarui di belakang.
  derive memuatUmpan = pending(umpanBaru) and (umpanBaru.laporan.length > 0 or umpanTersimpan.laporan.length == 0)
  resource saya = muatLaporanSaya() as shape LaporanSaya[] else empty()
  derive idTerbuka = top(nav).name == "laporan" or top(nav).name == "komentar" ? top(nav).params.id : ""
  resource komentar = muatKomentar(idTerbuka) as shape Komentar[] else empty()
  mutation terkirim as shape Balasan refreshes saya, laporanAkun, sesi then setelahKirim
  resource sesi = muatSesi() as shape Sesi else empty()
  // Bergantung pada email sesi: dimuat ulang begitu sesi dipulihkan dari app:/data/sesi.json saat aplikasi dibuka.
  resource laporanAkun = muatLaporanAkun(sesi.email) as shape LaporanAkun[] else empty()
  resource disukai = muatDisukai(sesi.email) as shape string[] else empty()
  mutation masuk as shape Balasan refreshes sesi, laporanAkun, disukai, ktp then setelahMasuk
  resource klien = klienGoogle() as shape string else empty()
  // Halaman Turnstile server untuk laporan tanpa akun ("" = mock-server, yang meloloskan tanpa halaman).
  resource alamatCaptcha = alamatCaptcha() as shape string else empty()
  resource alamatKabar = alamatKabar() as shape AlamatKabar else empty()
  // Siaran sendiri tidak dikabarkan ke HP sendiri.
  derive ruangSiarku = match tokenSiar { case some(t) => t.ruang, case none => "" }
  resource ktp = muatVerifikasi(sesi.email) as shape StatusKtp else empty()
  mutation ktpDikirim as shape Balasan refreshes ktp then setelahKtp
  mutation keluarSesi as shape Balasan refreshes sesi, laporanAkun, disukai
  // Hapus akun (wajib Google Play bagi aplikasi yang bisa membuat akun), seperti Pengaturan aslinya.
  mutation akunDihapus as shape Balasan refreshes sesi, laporanAkun, disukai, ktp then setelahHapusAkun
  mutation sukaDikirim as shape Balasan refreshes sesi then setelahSuka
  derive galatMasuk = match masuk { case some(b) => b.galat, case none => "" }
  resource statusFoto = photoLibraryStatus() as shape PhotoLibraryStatus else empty()
  resource galeri = photoAssets(limit=batasGaleri) as shape PhotoAssetList else empty()
  mutation salinan as shape PhotoCopy then setelahSalin
  mutation lokasi as shape GeolocationPosition then setelahLokasi
  // Izin lokasi (hidup: dibaca ulang saat aplikasi kembali dari Pengaturan HP). "denied" = Android tidak lagi
  // menampilkan dialog izin, jadi "Coba lagi" diganti "Buka pengaturan".
  resource statusLokasi = geolocationStatus() as shape GeolocationStatus else empty()
  resource siaranPublik = muatSiaranLangsung() as shape SiaranPublik[] else empty()
  mutation tokenSiar as shape TokenLive then setelahTokenSiar
  mutation tokenTonton as shape TokenLive
  // Daftar komentar dari LAPORIN_SITUS (mock) sudah memuat komentar yang baru dikirim: dimuat ulang setelah kirim.
  mutation komentarDikirim as shape Balasan refreshes komentar then setelahKomentar
  mutation dilaporkan as shape Balasan
  // Bahasa teks buatan inti Rust (tanggal, koordinat, galat, label): aturBahasa("ID"|"EN") lalu sumber yang memuat
  // teks itu dimuat ulang.
  mutation bahasaData as shape Balasan refreshes umpanBaru, komentar, saya, laporanAkun, ktp, siaranPublik
  resource statusKamera = cameraStatus() as shape CameraStatus else empty()
  resource perangkatKamera = enumerateDevices() as shape MediaDeviceList else empty()
  resource trekKamera = mediaStreamTrack(track=track) as shape MediaStreamTrack else empty()
  mutation kameraDibuka as shape MediaStream then pasangTrek
  mutation dijepret as shape Photo then setelahJepret
  mutation kameraDisetel as shape MediaStreamTrack
  mutation kameraDitutup as shape MediaStreamTrack
  // Trek yang masih hidup dipakai lagi saat kamera dibuka lagi, bukan meminta yang baru.
  derive memegangKamera = track != "" and trekKamera.readyState == "live"
  derive bisaBalik = perangkatKamera.devices.map(d => d.facingMode == some("user")).includes(true) and perangkatKamera.devices.map(d => d.facingMode == some("environment")).includes(true)
  derive hadapSaja = MediaTrackConstraints(deviceId=none, groupId=none, facingMode=some(hadap), width=none, height=none, aspectRatio=none, frameRate=none, resizeMode=none, zoom=none, torch=none, sampleRate=none, sampleSize=none, channelCount=none, echoCancellation=none, autoGainControl=none, noiseSuppression=none, latency=none)
  derive galatKamera = match failure(kameraDibuka) { case some(f) => f.code, case none => "" }
  derive galatJepret = match failure(dijepret) { case some(f) => f.code, case none => "" }
  derive adaLokasi = match lokasi { case some(p) => true, case none => false }
  derive lokasiDitolak = statusLokasi.state == "denied"
  derive latKini = match lokasi { case some(p) => p.coords.latitude, case none => 0 }
  derive lngKini = match lokasi { case some(p) => p.coords.longitude, case none => 0 }
  derive akurasiKini = match lokasi { case some(p) => p.coords.accuracy, case none => 0 }
  // Isi untuk window.terima di assets/peta/sekitar.html (JSON).
  // Ruang kartu di bawah peta (laporan 82 px, hotspot ±150 px, ditambah jarak 10): bilah waktu halaman naik di atasnya.
  derive padKartuPeta = hotspotPeta != "" ? 160 : lapPetaSekitar.length > 0 ? 92 : 0
  derive dataPetaSekitar = `{"mode":"${modePeta}","laporan":[${umpan.laporan.map(l => titikPeta(l)).join(",")}],"pilih":"${idPetaSekitar}","pulau":"${pulauPeta}","titik":${lapisanTitik ? "true" : "false"},"asap":${lapisanAsap ? "true" : "false"},"satelit":[${satelitPeta.map(x => x ? "true" : "false").join(",")}],"globe":${globePeta ? "true" : "false"},"gaya":${gayaAsap},"tema":"${tema == "gelap" ? "dark" : "light"}","lokasiku":${lokasikuPeta(adaLokasi, latKini, lngKini)},"padBawah":${padKartuPeta},"perintah":{"n":${nomorPerintahPeta},"jenis":"${jenisPerintahPeta}"},"bahasa":"${bahasa == "EN" ? "en" : "id"}"}`
  derive lapPetaSekitar = umpan.laporan.filter(x => x.id == idPetaSekitar)
  derive urlSiar = match tokenSiar { case some(t) => t.url, case none => "" }
  derive kunciSiar = match tokenSiar { case some(t) => t.token, case none => "" }
  derive galatSiar = match tokenSiar { case some(t) => t.galat, case none => "" }
  derive urlTonton = match tokenTonton { case some(t) => t.url, case none => "" }
  derive kunciTonton = match tokenTonton { case some(t) => t.token, case none => "" }
  derive galatTokenTonton = match tokenTonton { case some(t) => t.galat, case none => "" }
  // Isi untuk window.terima di assets/live/siar.html dan tonton.html (JSON; teks komentar dikodekan URI).
  derive komentarHalaman = `{"n":${nomorKomentarLive},"teks":"${encodeURIComponent(teksKomentarLive)}"}`
  derive isiSiar = `{"url":"${urlSiar}","token":"${kunciSiar}","publik":true,"hadap":"${hadapLive}","bisu":${bisuLive ? "true" : "false"},"lokasi":${lokasikuPeta(adaLokasi, latKini, lngKini)},"akhiri":${nomorAkhiriLive},"komentar":${komentarHalaman},"mutu":"${mutuSiar}","suka":${nomorSukaLive},"bahasa":"${bahasa == "EN" ? "en" : "id"}"}`
  derive isiTonton = `{"url":"${urlTonton}","token":"${kunciTonton}","suka":${sukaTonton},"komentar":${komentarHalaman},"mutu":"${mutuTonton}","bahasa":"${bahasa == "EN" ? "en" : "id"}"}`
  derive lokasiLiveTeks = adaLokasi ? t("live.lokasiPublik", lat=latKini.toFixed(6), lng=lngKini.toFixed(6), akurasi=round(akurasiKini)) : t("live.mencariGpsPublik")
  derive galatKomentar = match komentarDikirim { case some(b) => b.galat, case none => "" }
  derive laporanSelesai = match dilaporkan { case some(b) => b.ok, case none => false }
  derive galatLaporkan = match dilaporkan { case some(b) => b.galat, case none => "" }

  derive saring = umpan.laporan.filter(l => pulau == "" or l.pulau == pulau)
  derive tampil = urutan == "komentar" ? sortBy(saring, l => l.komentar, "desc") : urutan == "suka" ? sortBy(saring, l => l.suka, "desc") : saring
  // Selama ada siaran publik (tanpa saringan pulau), sorotan Beranda adalah siarannya dan laporan sorotan ikut ke kisi.
  derive sorotanLive = pulau == "" and siaranPublik.length > 0
  derive idSorotan = sorotanLive ? "" : match first(tampil.filter(l => l.sampul != "")) { case some(l) => l.id, case none => "" }
  derive kisiSemua = tampil.filter(l => l.id != idSorotan)
  // Kiriman tanpa akun (tamu, atau anonim) ke server sungguhan butuh captcha; kiriman akun memakai Bearer token.
  derive perluCaptcha = alamatCaptcha != "" and (anonim or not sesi.masuk)
  derive sukaSorotan = sukaDari(idSorotan, disukai, sukaTambah, sukaBatal)
  derive jumlahSukaSorotan = match first(umpan.laporan.filter(l => l.id == idSorotan)) { case some(l) => jumlahSuka(l.suka, disukai.includes(l.id), sukaSorotan), case none => 0 }
  derive kisi = kisiSemua.slice(0, batasKisi)
  derive kisiBerikut = kisiSemua.slice(batasKisi, batasKisi + 15).filter(l => l.sampulKecil != "")
  derive dasarCari = kueri.trim() == "" ? umpan.laporan : umpan.laporan.filter(l => cocok(l, kueri))
  derive hasilCari = filterCari == "video" ? dasarCari.filter(l => l.adaVideo) : filterCari == "suka" ? sortBy(dasarCari, l => l.suka, "desc") : filterCari == "terdekat" and adaLokasi ? sortBy(dasarCari, l => (l.lat - latKini) * (l.lat - latKini) + (l.lng - lngKini) * (l.lng - lngKini)) : dasarCari
  derive mencariLaporan = kueri.trim() != "" or filterCari != "semua"
  // Bilah bawah tersembunyi di layar penuh dan lembar (Lapor, Galeri, Foto, Komentar, Laporkan, Terkirim), seperti aslinya.
  // Keyboard terbuka di HP potret: viewport menyusut di bawah ±1,6× lebarnya. Bilah bawah tidak ikut naik di atas
  // keyboard (aslinya tersembunyi di belakangnya), supaya isian yang sedang diketik tidak tertutup.
  derive papanKetik = viewport.width > 0 and viewport.width < 600 and viewport.height < viewport.width * 1.6
  derive bilahTampil = not papanKetik and not (nav.tab == "peta" and lembarPeta != "") and not ["lapor", "terkirim", "galeri", "kamera", "foto", "komentar", "laporkan", "live", "tonton"].includes(top(nav).name)
  // Video sorotan hanya berjalan selama Beranda tampil paling atas.
  derive berandaAktif = nav.tab == "beranda" and top(nav).name == "beranda"

  // Keluar dari kamera (tombol kembali HP) melepas kameranya.
  action back
    if top(nav).name == "kamera" and track != ""
      send kameraDitutup = stopTrack(track=track)
    if top(nav).name == "live" and tahapLive == "siaran"
      showModal("akhiri-siaran")
    else
      nav = back(nav)
  // Tautan masuk, termasuk ketukan notifikasi (app://tonton/<ruang>, app://laporan/<id>) saat aplikasi berjalan.
  action ikuti(url: string)
    if url.startsWith("/tonton/")
      siapkanTonton(url.slice(8))
    // Laporan yang baru dikabarkan bisa belum ada di umpan HP.
    if url.startsWith("/laporan/") and umpan.laporan.filter(x => `/laporan/${x.id}` == url).length == 0
      refresh umpanBaru
    nav = go(nav, url)
  // Dibuka dari notifikasi siaran saat aplikasi belum berjalan: Tonton jadi lokasi peluncuran tanpa bukaTonton.
  task tontonDariTautan when top(nav).name == "tonton" and ruangTonton == ""
    after(1, siapkanTontonTautan)
  action siapkanTontonTautan
    siapkanTonton(top(nav).params.ruang)
  // Dibuka sebelum daftar siaran termuat (lokasi peluncuran): judul, nama dan waktu mulai menyusul dari daftarnya.
  task lengkapiTonton when top(nav).name == "tonton" and mulaiTonton == 0 and siaranPublik.filter(x => x.ruang == ruangTonton).length > 0
    after(1, lengkapiTontonDariDaftar)
  action lengkapiTontonDariDaftar
    let s = first(siaranPublik.filter(x => x.ruang == ruangTonton))
    judulTonton = match s { case some(x) => x.judul, case none => judulTonton }
    namaTonton = match s { case some(x) => x.nama, case none => namaTonton }
    mulaiTonton = match s { case some(x) => x.mulai, case none => mulaiTonton }
  action catatIzinNotif(s: string)
    izinNotif = s
  // Sakelar Pengaturan › Notifikasi. Tanpa izin: pilihan itu dinyalakan lalu izin diminta.
  action gantiNotif(jenis: string)
    if izinNotif != "diberi"
      if jenis == "live"
        notifLive = true
      else
        notifLaporan = true
      mintaIzinNotif = mintaIzinNotif + 1
    else if jenis == "live"
      notifLive = not notifLive
    else
      notifLaporan = not notifLaporan
  action bukaIzinNotif
    mintaIzinNotif = mintaIzinNotif + 1
  // Peta memakai lokasiku (titik biru, jarak kejadian) sejak dibuka, seperti aslinya.
  action pilihTab(nama: string)
    // Beranda diketuk lagi saat sudah tampil di puncaknya: kembali ke atas dan muat ulang umpan serta siaran. Di
    // layar lain tab Beranda (Detail, Cari, …), select() sudah kembali ke Beranda.
    if nama == "beranda" and berandaAktif
      scrollIntoView("atas-beranda", block="start", behavior="smooth")
      refresh umpanBaru
      refresh siaranPublik
    nav = select(nav, nama)
    if nama == "peta" and not adaLokasi and not pending(lokasi)
      send lokasi = getCurrentPosition(maximumAge=600000)
  action bukaLapor
    galat = ""
    batasGaleri = 24
    nav = push(nav, "/lapor")
    if not adaLokasi and not pending(lokasi)
      send lokasi = getCurrentPosition(maximumAge=600000)
  action perbaruiLokasi
    if not pending(lokasi)
      send lokasi = getCurrentPosition(maximumAge=0)
  action bukaGaleri
    batasGaleri = batasGaleri == 60 ? 61 : 60
    nav = push(nav, "/galeri")
  // Ambil foto: jendela bidik layar penuh; setiap jepretan (app:/tmp/camera/N.jpg) langsung jadi lampiran.
  action bukaKamera
    galat = ""
    kameraUntuk = "lapor"
    if not memegangKamera and not pending(kameraDibuka)
      send kameraDibuka = getUserMedia(video=true, videoConstraints=hadapSaja)
    nav = push(nav, "/kamera")
  // Daftar kamera dibaca lagi setelah kamera terbuka: bacaan saat boot mendahului terikatnya modul native
  // (NotSupportedError), seperti galeri.
  action pasangTrek
    match kameraDibuka
      case some(m)
        track = match m.tracks.at(0) { case some(t) => t.id, case none => "" }
      case none
        track = track
    refresh perangkatKamera
  action balikKamera
    send kameraDisetel = applyConstraints(track=track, facingMode=(hadap == "environment" ? "user" : "environment"))
    hadap = hadap == "environment" ? "user" : "environment"
  action gantiLampu
    lampu = not lampu
  action jepret
    if track != "" and (kameraUntuk == "ktp" or pilihan.length < 6) and not pending(dijepret)
      send dijepret = takePhoto(track=track, android.flashMode=(lampu ? "on" : "off"))
  action setelahJepret
    match dijepret
      case some(f)
        if kameraUntuk == "ktp"
          fotoKtpBaru = f.path
        else if not pilihan.includes(f.path) and pilihan.length < 6
          pilihan = pilihan.concat([f.path])
          berkasFoto = berkasFoto.concat([f.path])
          gambarFoto = gambarFoto.concat([f.path])
      case none
        galat = galat
  action tutupKamera
    if track != ""
      send kameraDitutup = stopTrack(track=track)
    fotoKtpBaru = ""
    nav = back(nav)
  // Verifikasi KTP (layar Verifikasi, syarat siaran langsung): status dimuat ulang setiap layar dibuka.
  action bukaVerifikasi
    galatKtp = ""
    bidangKtp = ""
    verifikasiDariLive = top(nav).name == "live"
    refresh ktp
    nav = push(nav, "/verifikasi")
  // Terverifikasi: kembali ke persiapan siaran yang membukanya, atau buka persiapan siaran baru.
  action lanjutDariVerifikasi
    if verifikasiDariLive
      nav = back(nav)
    else
      tahapLive = "siapkan"
      galatLive = ""
      nav = replace(nav, "/live")
  action periksaKtp
    refresh ktp
  action ubahNik(v: string)
    nikKtp = hanyaAngka(v).slice(0, 16)
    if bidangKtp == "nik"
      bidangKtp = ""
      galatKtp = ""
  action bukaKameraKtp
    galatKtp = ""
    kameraUntuk = "ktp"
    fotoKtpBaru = ""
    if not memegangKamera and not pending(kameraDibuka)
      send kameraDibuka = getUserMedia(video=true, videoConstraints=hadapSaja)
    nav = push(nav, "/kamera")
  action ulangiKtp
    fotoKtpBaru = ""
  action pakaiKtp
    fotoKtp = fotoKtpBaru
    if bidangKtp == "ktp"
      bidangKtp = ""
      galatKtp = ""
    if track != ""
      send kameraDitutup = stopTrack(track=track)
    fotoKtpBaru = ""
    nav = back(nav)
  action kirimKtp
    if nikKtp.length != 16
      galatKtp = t("ktp.galat.nik")
      bidangKtp = "nik"
    else if fotoKtp == ""
      galatKtp = t("ktp.galat.foto")
      bidangKtp = "ktp"
    else if not pending(ktpDikirim)
      galatKtp = ""
      bidangKtp = ""
      send ktpDikirim = ajukanVerifikasi(nikKtp, fotoKtp)
  // Terkirim: data pribadi tidak dibiarkan tertinggal di layar.
  action setelahKtp
    match ktpDikirim
      case some(b)
        if b.ok
          nikKtp = ""
          fotoKtp = ""
        else
          galatKtp = b.galat
          bidangKtp = b.galat.includes("NIK") ? "nik" : ""
      case none
        galatKtp = t("galat.koneksi")
  action kameraKeGaleri
    if track != ""
      send kameraDitutup = stopTrack(track=track)
    batasGaleri = batasGaleri == 60 ? 61 : 60
    nav = replace(nav, "/galeri")
  action gantiBisuSorotan
    bisuSorotan = not bisuSorotan
  action pilihFilter(f: string)
    filterCari = filterCari == f ? "semua" : f
    if f == "terdekat" and not adaLokasi and not pending(lokasi)
      send lokasi = getCurrentPosition(maximumAge=600000)
  action cariIni(q: string)
    kueri = q
  action kePeta
    nav = select(nav, "peta")
  action keProfilTab
    nav = select(nav, "profil")
  // Menyimpan butuh akun: daftar Tersimpan hanya ada di Profil akun. Tamu diminta masuk dulu, seperti menyukai.
  action toggleSimpan(id: string)
    if not sesi.masuk
      perluMasukUntuk = "menyimpan"
      showModal("perlu-masuk")
    else
      simpanan = simpanan.includes(id) ? simpanan.filter(x => x != id) : simpanan.concat([id])
  action ubahIsiKomentar(v: string)
    isiKomentar = v
  action kirimKomentarIni
    if isiKomentar.trim() != "" and not pending(komentarDikirim)
      send komentarDikirim = kirimKomentar(idTerbuka, isiKomentar.trim())
  action setelahKomentar
    if galatKomentar == ""
      isiKomentar = ""
  action pilihAlasan(a: string)
    alasanLapor = a
  action ubahCatatan(v: string)
    catatanLapor = v
  action kirimLaporkan
    if alasanLapor != "" and not pending(dilaporkan)
      send dilaporkan = laporkanKonten(jenisLapor, top(nav).params.id, alasanLapor, catatanLapor.trim())
  action bukaLaporkan(id: string)
    jenisLapor = "laporan"
    alasanLapor = ""
    catatanLapor = ""
    nav = push(nav, path("laporkan", id))
  // "" = ikut HP; "terang"/"gelap" = dikunci (juga lewat tombol bulan/matahari di Beranda).
  action pilihTema(t: string)
    tema = t
    setScheme(t == "gelap" ? "dark" : t == "terang" ? "light" : "system")
  action bukaIzin
    openURL("app-settings:")
  action bukaSitus
    openURL("https://fire.nusantara.earth/id")
  action tanyaKeluar
    showModal("konfirmasi-keluar")
  state galatHapusAkun = ""
  action tanyaHapusAkun
    if not pending(akunDihapus)
      galatHapusAkun = ""
      showModal("konfirmasi-hapus-akun")
  action tekanHapusAkun
    send akunDihapus = hapusAkun()
  // Terhapus: suka sementara dibuang, kabar "Akun dihapus", lalu kembali ke Profil (tamu) seperti keluar.
  action setelahHapusAkun
    match akunDihapus
      case some(b)
        if b.ok
          sukaTambah = []
          sukaBatal = []
          nav = select(back(nav), "profil")
          showModal("akun-dihapus")
        else
          galatHapusAkun = b.galat
      case none
        galatHapusAkun = t("galat.koneksi")
  // Tamu yang menyukai diminta masuk dulu, seperti popup "masuk dulu" aslinya.
  action tekanSuka(id: string, kini: bool)
    if not sesi.masuk
      perluMasukUntuk = "menyukai"
      showModal("perlu-masuk")
    else if not pending(sukaDikirim)
      idSuka = id
      if kini
        sukaTambah = sukaTambah.filter(x => x != id)
        sukaBatal = sukaBatal.concat([id])
      else
        sukaBatal = sukaBatal.filter(x => x != id)
        sukaTambah = sukaTambah.concat([id])
      send sukaDikirim = aturSuka(id, not kini)
  // Server menolak: kembali ke daftar server untuk laporan itu.
  action setelahSuka
    let ok = match sukaDikirim { case some(b) => b.ok, case none => false }
    if not ok
      sukaTambah = sukaTambah.filter(x => x != idSuka)
      sukaBatal = sukaBatal.filter(x => x != idSuka)
  action muatUlangGaleri
    batasGaleri = batasGaleri == 24 ? 25 : 24
  // Terkirim menggantikan Lapor di tumpukan tab yang membukanya: tutup dulu, lalu pindah tab.
  action keBeranda
    nav = select(back(nav), "beranda")
  action keProfil
    nav = select(back(nav), "profil")
  action pilihPulau(p: string)
    pulau = p
    batasKisi = 15
  action urutkan(u: string)
    urutan = u
    batasKisi = 15
  // Penanda di bawah kisi mendekati layar (800 px sebelumnya): 15 kartu lagi, sampai semua laporan tampil.
  action muatLagiKisi(entry: IntersectionObserverEntry)
    if entry.isIntersecting and batasKisi < kisiSemua.length
      batasKisi = batasKisi + 15
  action nyalakanPramuatKisi
    pramuatKisi = true
  action cari(v: string)
    kueri = v
  action muatUlang
    sukaTambah = []
    sukaBatal = []
    refresh umpanBaru
    refresh disukai
  action ubahJudul(v: string)
    judul = v
  action ubahDeskripsi(v: string)
    deskripsi = v
  action ubahNama(v: string)
    nama = v
  action ubahAnonim(v: bool)
    anonim = v
  // Foto yang dipilih disalin modul foto ke app:/tmp; inti Rust memperkecil dan mengunggah salinannya.
  action pilihFoto(id: string, gambar: string)
    if pilihan.includes(id)
      hapusFoto(id)
    else if pilihan.length < 6 and not pending(salinan)
      menyalin = id
      menyalinGambar = gambar
      galat = ""
      send salinan = copyPhotoAsset(asset=id)
  action hapusFoto(id: string)
    let i = pilihan.indexOf(id)
    pilihan = pilihan.filter(x => x != id)
    berkasFoto = berkasFoto.filter(p => berkasFoto.indexOf(p) != i)
    gambarFoto = gambarFoto.filter(g => gambarFoto.indexOf(g) != i)
  action setelahSalin
    match salinan
      case some(c)
        if menyalin != "" and not pilihan.includes(menyalin)
          pilihan = pilihan.concat([menyalin])
          berkasFoto = berkasFoto.concat([c.path])
          gambarFoto = gambarFoto.concat([menyalinGambar])
      case none
        galat = t("lapor.galat.salin")
    menyalin = ""
  // Tema yang dipilih tersimpan (persist) dan diterapkan lagi tiap aplikasi dibuka.
  // Jam layar siaran dan tab Live (durasi, "5 menit lalu"); daftar siaran publik dimuat ulang tiap 8 detik.
  task jamLive when top(nav).name == "live" or top(nav).name == "tonton" or top(nav).name == "siaran"
    every(1000, detakLive)
  // Daftar siaran publik dimuat ulang selama tab Live atau Beranda (sorotan live, "LAPORIN · N LIVE") tampil.
  task pantauSiaran when top(nav).name == "siaran" or berandaAktif
    every(8000, segarkanSiaran)
  // Izin lokasi baru diberikan (dari Pengaturan HP) selagi formulir Lapor atau persiapan siaran terbuka: ambil lagi.
  task lokasiSetelahIzin when statusLokasi.state == "granted" and not adaLokasi and (top(nav).name == "lapor" or top(nav).name == "live")
    after(1, perbaruiLokasi)
  // Mesin WebView (Chromium) dipanaskan sekali beberapa detik setelah aplikasi terbuka: WebView pertama di proses
  // memuat mesinnya ±1 detik, jadi tab Peta (dan Live) yang dibuka pertama kali tidak lagi tertahan selama itu.
  task panaskanWeb mount
    after(2500, mulaiPanaskanWeb)
  // Pramuat sampul kisi dimulai setelah sorotan dan 15 sampul pertama sempat mengambil jalur unduhan.
  task mulaiPramuatKisi mount
    after(3000, nyalakanPramuatKisi)
  task tutupPreloadSaatSiap when tampilPreload and preloadMinimal and siapAwal
    after(1, tutupPreload)
  task preloadSedetik mount
    after(1000, lewatMinimalPreload)
  task preloadCukupLama mount
    after(2500, cukupPreload)
  task batasPreload mount
    after(15000, tutupPreload)
  action lewatMinimalPreload
    preloadMinimal = true
  action cukupPreload
    preloadCukup = true
  action tutupPreload
    preloadSelesai = true
  action probeSelesai
    probeTermuat = probeTermuat + 1
  action probeGagal(pesan: string)
    probeTermuat = probeTermuat + 1
  task pulihkanTema mount
    after(1, terapkanTema)
  action terapkanTema
    if tema != ""
      setScheme(tema == "gelap" ? "dark" : "light")
  action gantiBahasa
    let b = bahasa == "ID" ? "EN" : "ID"
    bahasa = b
    send bahasaData = aturBahasa(b)
  // Bahasa tersimpan "EN" berlaku di inti Rust sejak aplikasi dibuka ("ID" sudah bawaannya).
  task pulihkanBahasa mount
    after(1, terapkanBahasa)
  action terapkanBahasa
    if bahasa != "ID"
      send bahasaData = aturBahasa(bahasa)
  // Mode peta menutup kartu yang terbuka; lapisan tetap.
  action pilihModePeta(m: string)
    modePeta = m
    idPetaSekitar = ""
    hotspotPeta = ""
  action bukaLembarPeta(j: string)
    if j == "panduan"
      topikPanduan = modePeta == "asap" ? "aerosol" : modePeta == "angin" ? "angin" : "hotspot"
    lembarPeta = j
  action tutupLembarPeta
    lembarPeta = ""
  // Tombol back HP di akar tab Peta, Live dan Profil: tutup lembar Peta, lalu kartu laporan/hotspot Peta, lalu kembali
  // ke Beranda seperti aslinya (tab React Navigation, backBehavior "firstRoute").
  action kembaliDariTab
    if nav.tab == "peta" and lembarPeta != ""
      lembarPeta = ""
    else if nav.tab == "peta" and (idPetaSekitar != "" or hotspotPeta != "")
      idPetaSekitar = ""
      hotspotPeta = ""
    else
      nav = select(nav, "beranda")
  // Pulau: judul berganti, titik pulau lain meredup, peta memaskan laporan pulau itu.
  action pilihPulauPeta(p: string)
    pulauPeta = p
    lembarPeta = ""
    if p != "" and lapPetaSekitar.filter(l => l.pulau != p).length > 0
      idPetaSekitar = ""
    nomorPerintahPeta = nomorPerintahPeta + 1
    jenisPerintahPeta = "paskan"
  action gantiLapisanPeta(n: string)
    if n == "titik"
      lapisanTitik = not lapisanTitik
    else if n == "asap"
      lapisanAsap = not lapisanAsap
    else if n == "s0" or n == "s1" or n == "s2"
      let i = angkaDari(n.slice(1))
      let baru = satelitPeta.map((x, j) => j == i ? not x : x)
      satelitPeta = baru
      // Semua mati selagi memuat atau gagal: halaman peta tak mengabarkan lagi, jadi status itu tak tertinggal.
      if not baru.includes(true) and bagian(infoHotspot, 0) != "ok" and bagian(infoHotspot, 0) != "basi"
        infoHotspot = ""
  action gantiGlobePeta
    if modePeta != "angin"
      globePeta = not globePeta
  action gantiGayaAsap
    gayaAsap = (gayaAsap + 1) % 3
  action pilihTopikPanduan(t: string)
    topikPanduan = t
  action bagikanPeta
    share(text=t("peta.bagikanTeks", url="https://fire.nusantara.earth/id/embed"))
  // Pesan halaman peta (assets/peta/sekitar.html): siap, pilih/jarak/ketuk (kartu laporan), hotspot (kartu hotspot),
  // info hotspot & asap untuk lembar Lapisan dan Legenda, tinggi bilah waktu, tautan luar.
  action pesanPetaSekitar(v: string)
    let kata = v.split(" ")
    if v == "siap"
      petaSiap = true
    else if v.startsWith("pilih ")
      hotspotPeta = ""
      idPetaSekitar = match kata.at(1) { case some(s) => s, case none => "" }
      jarakPetaSekitar = match kata.at(2) { case some(s) => s, case none => "-" }
    else if v.startsWith("jarak ")
      jarakPetaSekitar = match kata.at(1) { case some(s) => s, case none => "-" }
    else if v == "ketuk"
      idPetaSekitar = ""
      hotspotPeta = ""
    else if v.startsWith("hotspot-info ")
      infoHotspot = v.slice(13)
    else if v.startsWith("hotspot ")
      idPetaSekitar = ""
      hotspotPeta = v.slice(8)
    else if v.startsWith("asap-info ")
      infoAsap = v.slice(10)
    else if v.startsWith("bilah ")
      tinggiBilahPeta = angkaDari(v.slice(6))
    else if v.startsWith("buka ")
      openURL(v.slice(5))
  action perintahkanPeta(jenis: string)
    nomorPerintahPeta = nomorPerintahPeta + 1
    jenisPerintahPeta = jenis
  action petaKeLokasiku
    ikutiLokasiPeta = true
    if adaLokasi
      nomorPerintahPeta = nomorPerintahPeta + 1
      jenisPerintahPeta = "lokasi"
    if not pending(lokasi)
      send lokasi = getCurrentPosition(maximumAge=0)
  // Siaran langsung: layar Live.
  action bukaLive
    tahapLive = "siapkan"
    galatLive = ""
    nav = push(nav, "/live")
    if not adaLokasi and not pending(lokasi)
      send lokasi = getCurrentPosition(maximumAge=600000)
  action ubahJudulLive(v: string)
    judulLive = v
  // Seperti laporin-apps, siaran aplikasi selalu publik: butuh akun dengan KTP sah (server menjawab galatnya).
  action mulaiLive
    galatLive = ""
    if judulLive.trim() == ""
      galatLive = t("live.galat.judul")
    else if not sesi.masuk
      galatLive = t("live.galat.masuk")
    else if ktp.status != "" and ktp.status != "disetujui"
      bukaVerifikasi()
    else if not pending(tokenSiar)
      send tokenSiar = mulaiSiaran(judulLive.trim(), true, adaLokasi, latKini, lngKini)
  action setelahTokenSiar
    if galatSiar != ""
      galatLive = galatSiar
    else if kunciSiar != ""
      tahapLive = "siaran"
      liveTerhubung = false
      akhiriDiminta = false
      livePutus = false
      penontonLive = 0
      sukaLive = 0
      komentarLive = []
      bisuLive = false
      hadapLive = "environment"
      lembarLive = ""
      sinyalLive = "unknown"
      sinyalTertahan = false
      sinyalTeks = ""
      gantiMutuLive = false
      putusSementara = false
      daftarPenonton = []
      kiniMs = waktu.epochAtZero + performanceNow()
      mulaiLiveMs = kiniMs
  // Pesan halaman siar.html.
  action pesanSiar(v: string)
    if v == "terhubung"
      liveTerhubung = true
      kiniMs = waktu.epochAtZero + performanceNow()
      mulaiLiveMs = kiniMs
    else if v.startsWith("penonton ")
      penontonLive = angkaDari(v.slice(9))
    else if v == "tanpa-suara"
      bisuLive = true
    else if v.startsWith("suka ")
      sukaLive = angkaDari(v.slice(5))
    else if v.startsWith("komentar ")
      komentarLive = komentarLive.concat([v.slice(9)]).slice(-6)
    else if v.startsWith("daftar ")
      daftarPenonton = v.slice(7) == "" ? [] : v.slice(7).split("\n")
    else if v.startsWith("sinyal ")
      sinyalLive = bagian(v.slice(7), 0)
      sinyalTertahan = bagian(v.slice(7), 1) == "1"
      sinyalTeks = bagian(v.slice(7), 2)
    else if v == "mutu-ganti" or v == "mutu-siap"
      gantiMutuLive = v == "mutu-ganti"
    else if v == "putus-sementara" or v == "pulih"
      putusSementara = v == "putus-sementara"
    else if v == "berakhir"
      durasiLiveAkhir = liveTerhubung ? kiniMs - mulaiLiveMs : 0
      livePutus = not akhiriDiminta
      tahapLive = "selesai"
    else if v.startsWith("galat ")
      if liveTerhubung
        livePutus = true
        durasiLiveAkhir = kiniMs - mulaiLiveMs
        tahapLive = "selesai"
      else
        galatLive = v.slice(6)
        tahapLive = "siapkan"
  action gantiHadapLive
    hadapLive = hadapLive == "environment" ? "user" : "environment"
  action gantiBisuLive
    bisuLive = not bisuLive
  action tanyaAkhiriLive
    showModal("akhiri-siaran")
  action akhiriSiaranIni
    akhiriDiminta = true
    nomorAkhiriLive = nomorAkhiriLive + 1
  action tutupLive
    nav = back(nav)
  action liveKeBeranda
    nav = select(back(nav), "beranda")
  // Lengkapi laporan: formulir Lapor menggantikan layar Live, judulnya dibawa.
  action lengkapiDariLive
    galat = ""
    batasGaleri = 24
    judul = judulLive
    nav = replace(nav, "/lapor")
  action ubahKomentarLive(v: string)
    isiKomentarLive = v
  // Komentar sendiri tidak kembali lewat LiveKit: langsung masuk daftar.
  action kirimKomentarLive
    if isiKomentarLive.trim() != ""
      teksKomentarLive = isiKomentarLive.trim()
      nomorKomentarLive = nomorKomentarLive + 1
      komentarLive = komentarLive.concat([`saya\t${sesi.nama}\t${isiKomentarLive.trim()}`]).slice(-6)
      isiKomentarLive = ""
  // Layar Tonton.
  action bukaTonton(ruang: string)
    siapkanTonton(ruang)
    nav = push(nav, path("tonton", ruang))
  action siapkanTonton(ruang: string)
    let s = first(siaranPublik.filter(x => x.ruang == ruang))
    ruangTonton = ruang
    judulTonton = match s { case some(x) => x.judul, case none => t("live.judulBawaan") }
    namaTonton = match s { case some(x) => x.nama, case none => t("peran.warga") }
    mulaiTonton = match s { case some(x) => x.mulai, case none => 0 }
    statusTonton = ""
    galatTonton = ""
    penontonTonton = 0
    komentarLive = []
    isiKomentarLive = ""
    lembarLive = ""
    daftarPenonton = []
    putusSementara = false
    bersihTonton = false
    sukaTotalTonton = 0
    kualitasTonton = ""
    lajuTonton = ""
    lapisanTonton = []
    kiniMs = waktu.epochAtZero + performanceNow()
    send tokenTonton = tontonSiaran(ruang)
  action sambungLagiTonton
    statusTonton = ""
    galatTonton = ""
    send tokenTonton = tontonSiaran(ruangTonton)
  // Pesan halaman tonton.html.
  // Trek pelapor bisa sudah terpasang ("video") sebelum sambungan selesai ("terhubung").
  action pesanTonton(v: string)
    if v == "terhubung"
      statusTonton = statusTonton == "video" ? "video" : "terhubung"
    else if v == "video" or v == "menunggu" or v == "berakhir"
      statusTonton = v
    else if v.startsWith("pelapor ")
      namaTonton = v.slice(8)
      statusTonton = statusTonton == "menunggu" ? "terhubung" : statusTonton
    else if v.startsWith("penonton ")
      penontonTonton = angkaDari(v.slice(9))
    else if v.startsWith("komentar ")
      komentarLive = komentarLive.concat([v.slice(9)]).slice(-6)
    else if v.startsWith("suka ")
      sukaTotalTonton = angkaDari(v.slice(5))
    else if v.startsWith("daftar ")
      daftarPenonton = v.slice(7) == "" ? [] : v.slice(7).split("\n")
    else if v.startsWith("kualitas ")
      kualitasTonton = bagian(v.slice(9), 0)
      lajuTonton = bagian(v.slice(9), 1)
    else if v.startsWith("lapisan ")
      lapisanTonton = v.slice(8).split("\n")
    else if v == "putus-sementara" or v == "pulih"
      putusSementara = v == "putus-sementara"
    else if v.startsWith("galat ")
      statusTonton = "galat"
      galatTonton = v.slice(6)
  action kirimSukaTonton
    sukaTonton = sukaTonton + 1
  action kirimSukaLive
    nomorSukaLive = nomorSukaLive + 1
  action bukaLembarLive(j: string)
    lembarLive = j
  action tutupLembarLive
    lembarLive = ""
  action pilihMutuSiar(m: string)
    mutuSiar = m
    lembarLive = ""
  action pilihMutuTonton(m: string)
    mutuTonton = m
    lembarLive = ""
  action gantiBersihTonton
    bersihTonton = not bersihTonton
  action laporkanSiaran
    jenisLapor = "siaran"
    judulLapor = `${namaTonton}: ${judulTonton}`
    alasanLapor = ""
    catatanLapor = ""
    nav = push(nav, path("laporkan", ruangTonton))
  action detakLive
    kiniMs = waktu.epochAtZero + performanceNow()
  action segarkanSiaran
    kiniMs = waktu.epochAtZero + performanceNow()
    refresh siaranPublik
  action setelahLokasi
    if ikutiLokasiPeta and adaLokasi
      ikutiLokasiPeta = false
      nomorPerintahPeta = nomorPerintahPeta + 1
      jenisPerintahPeta = "lokasi"
  // Masuk dengan Google: paket/masuk-google membuka pemilih akun (Credential Manager), lalu idToken-nya ditukar
  // dengan sesi di server (POST /api/mobile/masuk/google). "batal" = pemilih ditutup tanpa memilih akun.
  action mintaGoogle
    galatGoogle = ""
    if klien == ""
      galatGoogle = t("profil.galat.googleBelum")
    else if not pending(masuk)
      nomorGoogle = nomorGoogle + 1
  action pesanGoogle(v: string)
    if v.startsWith("token ")
      if not pending(masuk)
        send masuk = masukGoogle(v.slice(6))
    else if v.startsWith("galat ")
      // Rincian teknis sesudah " · " (kelas & kode galat) untuk debug saja, tidak ditampilkan.
      galatGoogle = match v.slice(6).split(" · ").at(0) { case some(t) => t, case none => v.slice(6) }
  action masukLewatEmail(daftar: bool, namaDaftar: string, email: string, sandi: string)
    if not pending(masuk)
      if daftar
        send masuk = daftarEmail(namaDaftar.trim(), email.trim(), sandi)
      else
        send masuk = masukEmail(email.trim(), sandi)
  action setelahMasuk
    if galatMasuk == ""
      galatGoogle = ""
      sukaTambah = []
      sukaBatal = []
  action tekanKeluar
    sukaTambah = []
    sukaBatal = []
    send keluarSesi = keluar()
    nav = select(back(nav), "profil")
  action kirim
    if judul.trim() == ""
      galat = t("lapor.galat.judul")
    else if deskripsi.trim() == ""
      galat = t("lapor.galat.deskripsi")
    else if pilihan.length == 0
      galat = t("lapor.galat.foto")
    else if not pending(terkirim) and not pending(salinan)
      galat = ""
      if perluCaptcha
        galatCaptcha = ""
        nomorCaptcha = nomorCaptcha + 1
        captchaTerbuka = true
      else
        send terkirim = kirimLaporan(judul.trim(), deskripsi.trim(), anonim ? "" : nama.trim(), anonim,
          waktu.epochAtZero + performanceNow(), waktu.utcOffset, berkasFoto, adaLokasi, latKini, lngKini, "")
  // Halaman captcha server (paket/web: "rn <json>" dari ReactNativeWebView.postMessage, "galat: …" bila tak termuat).
  // Token Turnstile langsung ikut kirimLaporan, yang menukarnya dengan tiket sekali pakai di /api/mobile/tiket.
  action pesanCaptcha(v: string)
    if v.startsWith("rn {\"token\":\"")
      if not pending(terkirim)
        send terkirim = kirimLaporan(judul.trim(), deskripsi.trim(), anonim ? "" : nama.trim(), anonim,
          waktu.epochAtZero + performanceNow(), waktu.utcOffset, berkasFoto, adaLokasi, latKini, lngKini,
          v.slice(13, v.length - 2))
    else if v.startsWith("rn {\"galat\":\"")
      galatCaptcha = v.slice(13, v.length - 2)
    else if v.startsWith("galat:")
      galatCaptcha = t("captcha.galat.muat")
  action mulaiPanaskanWeb
    if panasWeb == "belum"
      panasWeb = "memuat"
  action setelahPanasWeb(v: string)
    panasWeb = "selesai"
  action ulangCaptcha
    galatCaptcha = ""
    nomorCaptcha = nomorCaptcha + 1
  action tutupCaptcha
    captchaTerbuka = false
  action masukDariCaptcha
    captchaTerbuka = false
    keProfilTab()
  action setelahKirim
    let balas = match terkirim { case some(b) => b, case none => Balasan(ok=false, galat=t("lapor.galat.tanpaBalasan")) }
    if balas.ok
      captchaTerbuka = false
      judul = ""
      deskripsi = ""
      nama = ""
      anonim = false
      galat = ""
      pilihan = []
      berkasFoto = []
      gambarFoto = []
      nav = replace(nav, "/terkirim")
    else if captchaTerbuka
      // Tiket ditolak (token kedaluwarsa atau terpakai): verifikasi diulang di lembar yang sama.
      galatCaptcha = balas.galat
    else
      galat = balas.galat

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=ikuti testId="app"
      width="100%" height="100%" display="flex" flex-direction="column" position="relative"
      font-family="Poppins" color="teks.utama" accent-color="aksen.isi"
      // Strip status bar tetap latar halaman: ikon status bar Android mengikuti skema aplikasi, bukan warna latar,
      // jadi strip gelap di Detail (seperti aslinya) membuat jam dan baterai tak terlihat.
      background-color="latar.halaman"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              // Detail dan Foto berlatar tinta sampai ke bawah status bar, seperti area media aslinya.
              column navigationKey=`${e.id}` navigationScroll=`isi-${e.id}` position="absolute" inset=0
                display="flex" flex-direction="column"
                background-color=(e.name == "laporan" or e.name == "foto" or e.name == "kamera" or e.name == "tonton" ? "media.tinta" : "latar.halaman")
                // Kontrol Back akar tab Peta, Live dan Profil (`navigationBack="back"`): host Android menekannya saat tombol
                // back HP ditekan (lihat kembaliDariTab). Tak terlihat; tanpanya back di akar tab menutup aplikasi.
                if e.name == "peta" or e.name == "siaran" or e.name == "profil"
                  button id="back" press=kembaliDariTab aria-label=t("umum.kembali") aria-hidden="true" position="absolute" top=0
                    left=0 width=1 height=1 padding=0 border="none" opacity=0 background-color="transparent"
                if e.name == "beranda"
                  scroll id=`isi-${e.id}` flex=1 min-height=0 scrollbar-width="none"
                    column padding-top=6 padding-bottom=120
                      Beranda(umpan=umpan, tampil=tampil, kisi=kisi, idSorotan=idSorotan, pulau=pulau, urutan=urutan,
                        memuat=memuatUmpan, gagal=failed(umpanBaru), pilihPulau=pilihPulau, urutkan=urutkan, muatUlang=muatUlang,
                        bahasa=bahasa, gantiBahasa=gantiBahasa,
                        putarSorotan=berandaAktif, bisuSorotan=bisuSorotan, gantiBisuSorotan=gantiBisuSorotan,
                        live=siaranPublik, sorotanLive=sorotanLive, kini=kiniMs, tonton=bukaTonton, keLive=pilihTab("siaran"),
                        disukaiSorotan=sukaSorotan, jumlahSukaSorotan=jumlahSukaSorotan, sukaSorotan=tekanSuka(idSorotan, sukaSorotan))
                      // Gulir tanpa ujung: penanda berkunci batas, dipasang ulang setiap 15 kartu ditambahkan supaya layar
                      // yang tinggi terus terisi. Putaran memuat hanya terlihat bila gulir mendahului tambahan itu.
                      if batasKisi < kisiSemua.length
                        for b in [batasKisi] key=b
                          row intersect=muatLagiKisi intersect-margin="0px 0px 800px 0px" justify-content="center"
                            padding="24px 0 8px" testId="muat-lagi"
                            progress aria-label=t("beranda.memuatBerikut")
                      else if kisiSemua.length > 15
                        text t("beranda.semuaTampil") font-size=12 font-weight=500 color="teks.redup" text-align="center"
                          padding="20px 16px 0" testId="kisi-habis"
                else if e.name == "peta"
                  HalamanPeta(mode=modePeta, pilihMode=pilihModePeta, pulau=pulauPeta,
                    bisaSaring=(modePeta == "laporan" and (umpan.pulau.length > 1 or pulauPeta != "")), isi=dataPetaSekitar,
                    pesan=pesanPetaSekitar, siap=petaSiap, lap=lapPetaSekitar, jarak=jarakPetaSekitar, hotspot=hotspotPeta,
                    padKartu=padKartuPeta, tinggiBilah=tinggiBilahPeta,
                    legenda=((modePeta == "asap" and lapisanAsap) or modePeta == "angin" or satelitPeta.includes(true)),
                    globe=globePeta, mencariLokasi=(ikutiLokasiPeta and pending(lokasi)),
                    galatLokasi=(ikutiLokasiPeta and failed(lokasi)), bukaLembar=bukaLembarPeta, bagikan=bagikanPeta,
                    gantiGlobe=gantiGlobePeta, keNusantara=perintahkanPeta("rumah"), keLokasiku=petaKeLokasiku)
                else if e.name == "siaran"
                  scroll id=`isi-${e.id}` flex=1 min-height=0 scrollbar-width="none"
                    HalamanSiaran(siaran=siaranPublik, kini=kiniMs, mulai=bukaLive, tonton=bukaTonton, bahasa=bahasa)
                else if e.name == "profil"
                  scroll id=`isi-${e.id}` flex=1 min-height=0 scrollbar-width="none"
                    if sesi.masuk
                      ProfilAkun(sesi=sesi, laporan=laporanAkun, memuat=pending(laporanAkun), gagal=failed(laporanAkun),
                        tersimpan=umpan.laporan.filter(l => simpanan.includes(l.id)), buatLaporan=bukaLapor,
                        disukai=umpan.laporan.filter(l => sukaDari(l.id, disukai, sukaTambah, sukaBatal)),
                        memuatSuka=(pending(disukai) or pending(umpanBaru)))
                    else
                      HalamanProfil(google=mintaGoogle, galatGoogle=galatGoogle, memuatMasuk=pending(masuk),
                        galatMasuk=galatMasuk, masukEmail=masukLewatEmail)
                else if e.name == "laporan"
                  scroll id=`isi-${e.id}` flex=1 min-height=0 background-color="latar.halaman" scrollbar-width="none"
                    for lap in umpan.laporan.filter(x => x.id == e.params.id) key=lap.id
                      // Video hanya diputar selama Detail ini paling atas (bukan di bawah Komentar atau Foto).
                      DetailLaporan(lap=lap, serupa=umpan.laporan.filter(x => x.id != lap.id and x.tempat == lap.tempat).slice(0, 6),
                        tersimpan=(sesi.masuk and simpanan.includes(lap.id)), simpan=toggleSimpan(lap.id), kembali=back,
                        laporkan=bukaLaporkan(lap.id), aktif=(e.id == top(nav).id), disukai=sukaDari(lap.id, disukai, sukaTambah, sukaBatal),
                        jumlahSuka=jumlahSuka(lap.suka, disukai.includes(lap.id), sukaDari(lap.id, disukai, sukaTambah, sukaBatal)),
                        suka=tekanSuka(lap.id, sukaDari(lap.id, disukai, sukaTambah, sukaBatal)))
                    if umpan.laporan.filter(x => x.id == e.params.id).length == 0
                      Kosong(ikon="symbol:icon.luring", pesan=t("detail.belumMuncul"))
                else if e.name == "komentar"
                  HalamanKomentar(komentar=komentar,
                    memuat=pending(komentar), masuk=sesi.masuk, isi=isiKomentar, ubahIsi=ubahIsiKomentar, kirim=kirimKomentarIni,
                    mengirim=pending(komentarDikirim), galat=galatKomentar, keProfil=keProfilTab, kembali=back, idIsi=`isi-${e.id}`)
                else if e.name == "foto"
                  for lap in umpan.laporan.filter(x => x.id == e.params.id) key=lap.id
                    HalamanFoto(gambar=gambarKe(lap, e.params.indeks), video=videoDari(lap, e.params.indeks), kembali=back)
                else if e.name == "laporkan"
                  HalamanLaporkan(judul=(jenisLapor == "siaran" ? judulLapor : match first(umpan.laporan.filter(x => x.id == e.params.id)) { case some(l) => l.judul, case none => "" }),
                    alasan=alasanLapor, pilihAlasan=pilihAlasan, catatan=catatanLapor, ubahCatatan=ubahCatatan,
                    kirim=kirimLaporkan, mengirim=pending(dilaporkan), selesai=laporanSelesai, galat=galatLaporkan, tutup=back,
                    idIsi=`isi-${e.id}`)
                else if e.name == "galeri"
                  HalamanGaleri(galeri=galeri, status=statusFoto, memuat=pending(galeri), pilihan=pilihan, menyalin=pending(salinan),
                    pilihFoto=pilihFoto, muatUlang=muatUlangGaleri, kembali=back, idIsi=`isi-${e.id}`)
                else if e.name == "kamera"
                  HalamanKamera(track=track, status=statusKamera, membuka=pending(kameraDibuka), galatBuka=galatKamera,
                    galatJepret=galatJepret, jumlah=pilihan.length,
                    terakhir=(match gambarFoto.at(gambarFoto.length - 1) { case some(g) => g, case none => "" }),
                    menjepret=pending(dijepret), lampu=lampu, bisaBalik=bisaBalik, jepret=jepret, balik=balikKamera,
                    gantiLampu=gantiLampu, tutup=tutupKamera, keGaleri=kameraKeGaleri, bukaIzin=bukaIzin,
                    ktp=(kameraUntuk == "ktp"), fotoKtp=fotoKtpBaru, ulangi=ulangiKtp, pakai=pakaiKtp)
                else if e.name == "live"
                  HalamanLive(tahap=tahapLive, judul=judulLive, ubahJudul=ubahJudulLive, mulai=mulaiLive,
                    menyiapkan=pending(tokenSiar), galat=galatLive, masuk=sesi.masuk, keProfil=keProfilTab, tutup=tutupLive,
                    lokasiAda=adaLokasi, lat=latKini, lng=lngKini, akurasi=akurasiKini, mencariLokasi=pending(lokasi),
                    gagalLokasi=failed(lokasi),
                    isi=isiSiar, pesan=pesanSiar, terhubung=liveTerhubung, durasi=(kiniMs - mulaiLiveMs),
                    penonton=penontonLive, suka=sukaLive, kirimSuka=kirimSukaLive, komentar=komentarLive, nama=sesi.nama,
                    lokasiTeks=lokasiLiveTeks, mutu=mutuSiar, pilihMutu=pilihMutuSiar, lembar=lembarLive,
                    bukaLembar=bukaLembarLive, tutupLembar=tutupLembarLive, daftar=daftarPenonton, sinyal=sinyalLive,
                    tertahan=sinyalTertahan, sinyalTeks=sinyalTeks, gantiMutu=gantiMutuLive, putusSementara=putusSementara,
                    bisu=bisuLive, gantiBisu=gantiBisuLive, balik=gantiHadapLive, akhiri=tanyaAkhiriLive,
                    isiKomentar=isiKomentarLive, ubahKomentar=ubahKomentarLive, kirimKomentar=kirimKomentarLive,
                    putus=livePutus, durasiAkhir=durasiLiveAkhir, lengkapi=lengkapiDariLive, keBeranda=liveKeBeranda,
                    ktp=ktp.status, verifikasi=bukaVerifikasi)
                else if e.name == "tonton"
                  HalamanTonton(isi=isiTonton, pesan=pesanTonton, menyambung=pending(tokenTonton),
                    status=(galatTokenTonton != "" ? "galat" : statusTonton),
                    galat=(galatTokenTonton != "" ? galatTokenTonton : galatTonton), judul=judulTonton, nama=namaTonton,
                    mulai=mulaiTonton, kini=kiniMs, penonton=penontonTonton, komentar=komentarLive, masuk=sesi.masuk,
                    suka=sukaTotalTonton, kirimSuka=kirimSukaTonton, isiKomentar=isiKomentarLive,
                    ubahKomentar=ubahKomentarLive, kirimKomentar=kirimKomentarLive, tutup=back, keBeranda=liveKeBeranda,
                    sambungLagi=sambungLagiTonton, keProfil=keProfilTab, putus=putusSementara, bersih=bersihTonton,
                    gantiBersih=gantiBersihTonton, laporkan=laporkanSiaran, mutu=mutuTonton, kualitas=kualitasTonton,
                    laju=lajuTonton, lapisan=lapisanTonton, pilihMutu=pilihMutuTonton, lembar=lembarLive,
                    bukaLembar=bukaLembarLive, tutupLembar=tutupLembarLive, daftar=daftarPenonton)
                else if e.name == "pengaturan"
                  HalamanPengaturan(sesi=sesi, ktp=ktp.status, verifikasi=bukaVerifikasi, tema=tema, pilihTema=pilihTema,
                    hapusAkun=tanyaHapusAkun, menghapus=pending(akunDihapus), galatHapus=galatHapusAkun, gelap=gelapKini,
                    bukaIzin=bukaIzin, bukaSitus=bukaSitus, keluar=tanyaKeluar, kembali=back, idIsi=`isi-${e.id}`,
                    notifLive=notifLive, notifLaporan=notifLaporan, izinNotif=izinNotif, gantiNotif=gantiNotif,
                    bukaIzinNotif=bukaIzinNotif)
                else if e.name == "verifikasi"
                  HalamanVerifikasi(masuk=sesi.masuk, status=ktp, memuat=pending(ktp), gagal=failed(ktp), periksa=periksaKtp,
                    nik=nikKtp, ubahNik=ubahNik, foto=fotoKtp, potret=bukaKameraKtp, kirim=kirimKtp,
                    mengirim=pending(ktpDikirim), galat=galatKtp, bidang=bidangKtp, dariLive=verifikasiDariLive,
                    lanjut=lanjutDariVerifikasi, keProfil=keProfilTab, kembali=back, idIsi=`isi-${e.id}`)
                else if e.name == "cari"
                  HalamanCari(kueri=kueri, cari=cari, cariIni=cariIni, saringan=filterCari, pilihFilter=pilihFilter,
                    hasil=hasilCari.slice(0, 60), jumlah=hasilCari.length, mencari=mencariLaporan, umpan=umpan,
                    lokasiGagal=failed(lokasi), kePeta=kePeta, kembali=back, idIsi=`isi-${e.id}`)
                else if e.name == "lapor"
                  FormLapor(judul=judul, deskripsi=deskripsi, nama=nama, anonim=anonim, galat=galat, mengirim=pending(terkirim),
                    akun=(sesi.masuk ? sesi.nama : ""), pilihan=pilihan, gambarFoto=gambarFoto, menyalin=pending(salinan),
                    hapusFoto=hapusFoto, bukaKamera=bukaKamera, bukaGaleri=bukaGaleri, lokasiAda=adaLokasi, lat=latKini, lng=lngKini, akurasi=akurasiKini,
                    mencariLokasi=pending(lokasi), gagalLokasi=failed(lokasi), lokasiDitolak=lokasiDitolak,
                    perbaruiLokasi=perbaruiLokasi, bukaIzin=bukaIzin,
                    ubahJudul=ubahJudul, ubahDeskripsi=ubahDeskripsi, ubahNama=ubahNama, ubahAnonim=ubahAnonim,
                    kirim=kirim, kembali=back, idIsi=`isi-${e.id}`)
                else if e.name == "terkirim"
                  scroll id=`isi-${e.id}` flex=1 min-height=0 scrollbar-width="none"
                    HalamanTerkirim(masuk=sesi.masuk, keBeranda=keBeranda, keProfil=keProfil)
      // Bilah bawah mengambang (BilahBawah): empat tab ikon dan pil LAPOR di tengah.
      row role="tablist" appearance="none" testId="tabs" aria-label=t("tab.navigasi")
        position="absolute" left=16 right=16 bottom="calc(env(safe-area-inset-bottom) + 8px)" height=64
        border-radius=32 padding="0 8px" display=(bilahTampil ? "flex" : "none") align-items="center"
        justify-content="space-between" background-color="bilah.isi" box-shadow="0 10px 30px bayangan.bilah"
        Tab(nama="beranda", label=t("tab.beranda"), ikon="symbol:home", aktif=(nav.tab == "beranda"), pilih=pilihTab("beranda"), titik=false)
        Tab(nama="peta", label=t("tab.peta"), ikon="symbol:icon.peta", aktif=(nav.tab == "peta"), pilih=pilihTab("peta"), titik=false)
        button press=bukaLapor testId="tombol-lapor" aria-label=t("tab.lapor")
          height=48 padding="0 18px" border-radius=24 display="flex" align-items="center" gap=8
          background-color="aksen.isi" color="aksen.di" font-size=19
          image "symbol:camera"
          text t("tab.lapor").toUpperCase() font-size=15 font-weight=700 letter-spacing=0.4
        Tab(nama="siaran", label=t("tab.live"), ikon="symbol:icon.siaran", aktif=(nav.tab == "siaran"), pilih=pilihTab("siaran"),
          titik=(siaranPublik.length > 0))
        Tab(nama="profil", label=t("tab.profil"), ikon="symbol:icon.pengguna", aktif=(nav.tab == "profil"), pilih=pilihTab("profil"), titik=false)
      if top(nav).name == "lapor" and captchaTerbuka
        LembarCaptcha(alamat=`${alamatCaptcha}?n=${nomorCaptcha}`, pesan=pesanCaptcha, galat=galatCaptcha, anonim=anonim,
          mengirim=pending(terkirim), tutup=tutupCaptcha, ulang=ulangCaptcha, masuk=masukDariCaptcha)
      if nav.tab == "peta" and top(nav).name == "peta" and lembarPeta != ""
        LembarPeta(lembar=lembarPeta, tutup=tutupLembarPeta, umpan=umpan, pulau=pulauPeta, pilihPulau=pilihPulauPeta,
          mode=modePeta, titik=lapisanTitik, asap=lapisanAsap, satelit=satelitPeta, gantiLapisan=gantiLapisanPeta,
          hotspot=infoHotspot, infoAsap=infoAsap, gaya=gayaAsap, gantiGaya=gantiGayaAsap, topik=topikPanduan,
          pilihTopik=pilihTopikPanduan)
      // Masuk dengan Google (paket/masuk-google): tak terlihat dan selalu terpasang; `minta` naik = buka pemilih akun.
      // 1×1 px, bukan 0: host Android baru membuat view native yang ikut tergambar (View kosong tidak menggambar apa pun).
      masuk-google klien=klien minta=nomorGoogle message=pesanGoogle position="absolute" top=0 left=0 width=1 height=1
        pointer-events="none"
      // Garis gulir disembunyikan seperti aslinya: host Android belum membaca scrollbar-width (paket/gulir).
      tanpa-garis-gulir position="absolute" top=0 left=0 width=1 height=1 pointer-events="none"
      // Bahasa aplikasi dari tombol ID/EN: locale Android aplikasi, jadi t() memakai strings/id.json atau en.json.
      atur-bahasa bahasa=bahasa position="absolute" top=0 left=0 width=1 height=1 pointer-events="none"
      // Notifikasi siaran langsung dan laporan baru: WorkManager memeriksa server berkala (paket/notifikasi).
      atur-notifikasi live=notifLive laporan=notifLaporan umpan=alamatKabar.umpan siaran=alamatKabar.live
        situs=alamatKabar.situs bahasa=bahasa minta=mintaIzinNotif abaikan=ruangSiarku message=catatIzinNotif
        position="absolute" top=0 left=0 width=1 height=1 pointer-events="none"
      if panasWeb == "memuat"
        web-halaman alamat="about:blank" message=setelahPanasWeb position="absolute" top=0 left=0 width=1 height=1
          pointer-events="none" aria-hidden="true"
      // Pramuat sampul 15 kartu kisi berikutnya: gambar 1×1 nyaris transparan mengisi cache unduhan, jadi kartu yang
      // ditambahkan nanti menggambar sampulnya dari HP, bukan dari jaringan. Tanpa `load=`: setiap aksi menggambar
      // ulang, dan 15 aksi per tambahan membuat gulir patah-patah.
      if pramuatKisi
        for l in kisiBerikut key=l.id
          image l.sampulKecil alt="" position="absolute" top=0 left=0 width=1 height=1 opacity=0.01
            pointer-events="none" aria-hidden="true"
      // Hanya logo, seperti Instagram (dan tanpa teks: locale aplikasi baru diterapkan atur-bahasa setelah tampilan
      // pertama, jadi teks di sini bisa sekilas berbahasa HP sebelum berganti).
      if tampilPreload
        column position="absolute" inset=0 background-color="latar.halaman" align-items="center" justify-content="center"
          testId="preload" role="status" aria-label=t("preload.menyiapkan")
          Merek(tinggi=46)
          for u, i in urlProbe key=i
            image u alt="" position="absolute" top=0 left=0 width=1 height=1 opacity=0.01 pointer-events="none"
              aria-hidden="true" load=probeSelesai error=probeGagal
      dialog id="konfirmasi-hapus-akun" role="alertdialog" aria-label=t("hapusAkun.judul")
        text t("hapusAkun.pesan")
        button commandfor="konfirmasi-hapus-akun" command="close" testId="hapus-akun-batal"
          text t("umum.batal")
        button press=tekanHapusAkun commandfor="konfirmasi-hapus-akun" command="close" destructive=true
          testId="hapus-akun-ya"
          text t("hapusAkun.tombol")
      dialog id="akun-dihapus" role="alertdialog" aria-label=t("hapusAkun.selesaiJudul")
        text t("hapusAkun.selesaiPesan")
        button commandfor="akun-dihapus" command="close" testId="akun-dihapus-tutup"
          text t("umum.tutup")
      dialog id="konfirmasi-keluar" role="alertdialog" aria-label=t("keluar.judul")
        text t("keluar.pesan")
        button commandfor="konfirmasi-keluar" command="close" testId="keluar-batal"
          text t("umum.batal")
        button press=tekanKeluar commandfor="konfirmasi-keluar" command="close" destructive=true testId="keluar-ya"
          text t("umum.keluar")
      dialog id="perlu-masuk" role="alertdialog" aria-label=t("perluMasuk.judul")
        text (perluMasukUntuk == "menyimpan" ? t("perluMasuk.menyimpan") : t("perluMasuk.menyukai")) testId="perlu-masuk-pesan"
        button commandfor="perlu-masuk" command="close" testId="perlu-masuk-nanti"
          text t("umum.nanti")
        button press=keProfilTab commandfor="perlu-masuk" command="close" testId="perlu-masuk-ya"
          text t("umum.masuk")
      dialog id="akhiri-siaran" role="alertdialog" aria-label=t("akhiri.judul")
        text t("akhiri.pesan")
        button commandfor="akhiri-siaran" command="close" testId="akhiri-lanjut"
          text t("akhiri.lanjut")
        button press=akhiriSiaranIni commandfor="akhiri-siaran" command="close" destructive=true testId="akhiri-ya"
          text t("akhiri.ya")

component Tab
  props
    nama: string
    label: string
    ikon: string
    aktif: bool
    pilih: action
    titik: bool
  view
    button role="tab" aria-controls=`panel-${nama}` aria-selected=aktif aria-label=label press=pilih testId=`tab-${nama}`
      width=48 height=48 border-radius=24 display="flex" align-items="center" justify-content="center" font-size=21
      background-color=(aktif ? "bilah.ikon" : "transparent") color=(aktif ? "bilah.isi" : "bilah.ikon") position="relative"
      image ikon
      // Titik aksen di ikon Live selama ada siaran publik, seperti aslinya.
      if titik
        box position="absolute" top=11 right=10 width=7 height=7 border-radius=4 background-color="aksen.isi"
          testId=`titik-${nama}`

// Label kecil huruf kapital (gaya "mono" Laporin: Poppins 600, 11, renggang).
component Alis
  props
    teks: string
    aksen: bool
  view
    text teks.toUpperCase() font-size=11 font-weight=600 letter-spacing=0.9 color=(aksen ? "aksen.teks" : "teks.redup")

component Pil
  props
    label: string
  view
    row align-items="center" gap=6 padding="6px 10px" border-radius=10 background-color="media.tinta"
      box width=7 height=7 border-radius=4 background-color="aksen.isi"
      text label.toUpperCase() font-size=11 font-weight=600 letter-spacing=0.7 color="media.teks" line-clamp=1

component Chip
  props
    label: string
    aktif: bool
    pilih: action
    uji: string
  view
    button press=pilih testId=uji height=36 padding="0 14px" border-radius=18 display="flex" align-items="center"
      flex-shrink=0 border=(aktif ? "1px solid chip.aktif" : "1px solid garis.tipis")
      background-color=(aktif ? "chip.aktif" : "transparent") color=(aktif ? "chip.di-aktif" : "teks.utama")
      text label.toUpperCase() font-size=11 font-weight=600 letter-spacing=0.7

// ChipFilter laporin-apps: titik 7 px beraksen sebelum label; `netral` (Semua) bertitik warna teksnya.
component ChipTitik
  props
    label: string
    aktif: bool
    netral: bool
    pilih: action
    uji: string
  view
    button press=pilih testId=uji height=36 padding="0 14px 0 12px" border-radius=18 display="flex" align-items="center"
      gap=6 flex-shrink=0 border=(aktif ? "1px solid chip.aktif" : "1px solid garis.tipis")
      background-color=(aktif ? "chip.aktif" : "transparent") color=(aktif ? "chip.di-aktif" : "teks.utama")
      box width=7 height=7 border-radius=4
        background-color=(netral ? (aktif ? "chip.di-aktif" : "teks.utama") : "aksen.isi")
      text label.toUpperCase() font-size=11 font-weight=600 letter-spacing=0.7

component Kosong
  props
    ikon: string
    pesan: string
  slot
  view
    column align-items="center" gap=12 padding="28px 22px" margin="12px 16px" border-radius=28
      background-color="latar.permukaan"
      box width=50 height=50 border-radius=25 display="flex" align-items="center" justify-content="center"
        background-color="latar.redup" font-size=22
        image ikon
      text pesan font-size=13.5 line-height=1.48 color="teks.redup" text-align="center" testId="pesan-kosong"
      children

// TombolIkon laporin-apps: lingkaran 44 px bergaris 1 px, ikon 19 px.
component TombolBulat
  props
    ikon: string
    label: string
    tekan: action
    uji: string
  view
    button press=tekan aria-label=label testId=uji width=44 height=44 border-radius=22 border="1px solid garis.tipis"
      display="flex" align-items="center" justify-content="center" font-size=19 color="teks.utama" flex-shrink=0
      image ikon

component Beranda
  props
    umpan: Umpan
    tampil: Laporan[]
    kisi: Laporan[]
    idSorotan: string
    pulau: string
    urutan: string
    memuat: bool
    gagal: bool
    pilihPulau: action
    urutkan: action
    muatUlang: action
    bahasa: string
    gantiBahasa: action
    putarSorotan: bool
    bisuSorotan: bool
    gantiBisuSorotan: action
    live: SiaranPublik[]
    sorotanLive: bool
    kini: number
    tonton: action
    keLive: action
    disukaiSorotan: bool
    jumlahSukaSorotan: number
    sukaSorotan: action
  view
    // scroll-margin besar: scrollIntoView berhenti di puncak gulungan (dibatasi 0), termasuk jarak status bar di atas.
    column id="atas-beranda" scroll-margin-top=400
      // Kepala: logo Laporin (· N LIVE, ketuk = tab Live), lalu cari dan bahasa (tema ada di Pengaturan).
      row padding="0 16px" align-items="center" justify-content="space-between" gap=12
        // Logo Laporin; selama ada siaran publik, "● N LIVE" di sebelahnya (ketuk = tab Live).
        row align-items="center" gap=10 min-width=0
          Merek(tinggi=24)
          if live.length > 0
            button press=keLive testId="status-live" aria-label=t("beranda.statusLive", n=live.length)
              padding="3px 8px" border="none" border-radius=10 background-color="transparent" color="teks.utama"
              display="flex" align-items="center" gap=5
              TitikLive(warna="aksen.isi", ukuran=8, berdenyut=true)
              text `${live.length} LIVE` font-size=11 font-weight=600 letter-spacing=0.9
        row gap=8
          link href=path("cari") testId="buka-cari" aria-label=t("beranda.cari")
            box width=34 height=34 border-radius=17 border="1px solid garis.tipis" display="flex" align-items="center"
              justify-content="center" font-size=17
              image "symbol:search"
          button press=gantiBahasa aria-label=t("beranda.bahasa") testId="ganti-bahasa" width=34 height=34 border-radius=17
            border="1px solid garis.tipis" display="flex" align-items="center" justify-content="center" flex-shrink=0
            padding=0 background-color="transparent"
            text bahasa font-size=11 font-weight=600 letter-spacing=0.6
      // Memuat ulang (ketuk Beranda lagi) sementara laporan lama tetap tampil.
      if memuat and umpan.laporan.length > 0
        row justify-content="center" padding="10px 0 0" testId="memuat-ulang"
          progress aria-label=t("beranda.memuatUlang")
      if gagal and umpan.laporan.length > 0
        text t("beranda.gagalPerbarui") font-size=12.5 font-weight=500 color="status.bahaya"
          padding="6px 20px 0"
      if umpan.pulau.length >= 2
        scroll overflow-x="auto" overflow-y="hidden" padding-top=14 testId="chip-pulau" scrollbar-width="none"
          row gap=6 padding="0 16px"
            ChipTitik(label=t("umum.semua"), aktif=(pulau == ""), netral=true, pilih=pilihPulau(""), uji="pulau-semua")
            for p in umpan.pulau key=p.nama
              ChipTitik(label=p.nama, aktif=(pulau == p.nama), netral=false, pilih=pilihPulau(p.nama), uji=`pulau-${p.nama}`)
      // Kartu sorotan: siaran live yang paling baru, atau laporan pertama yang punya foto.
      if sorotanLive
        for s in live.slice(0, 1) key=s.ruang
          SorotanLive(s=s, lainnya=(live.length - 1), kini=kini, tonton=tonton(s.ruang), keLive=keLive, bahasa=bahasa)
      else if idSorotan != ""
        for l in tampil.filter(x => x.id == idSorotan) key=l.id
          KartuSorotan(lap=l, video=videoPertama(l), putar=putarSorotan, bisu=bisuSorotan, gantiBisu=gantiBisuSorotan,
            disukai=disukaiSorotan, jumlahSuka=jumlahSukaSorotan, suka=sukaSorotan)
      else
        column margin="12px 16px 0" min-height=260 border-radius=28 background-color="latar.permukaan"
          align-items="center" justify-content="center" gap=12 padding="0 28px"
          if memuat
            progress aria-label=t("beranda.memuat")
          else if gagal
            box font-size=28 color="teks.redup"
              image "symbol:icon.luring"
            text t("galat.periksaKoneksi") font-size=13.5 line-height=1.48
              color="teks.redup" text-align="center"
            button press=muatUlang testId="coba-lagi" height=48 padding="0 22px" border-radius=26
              border="1px solid garis.tegas" display="flex" align-items="center" gap=8 font-size=18
              image "symbol:refresh"
              text t("umum.cobaLagi") font-size=15 font-weight=700
          else
            box font-size=28 color="teks.redup"
              image "symbol:search"
            text t("beranda.kosong") font-size=13.5 line-height=1.48
              color="teks.redup" text-align="center"
      // Kepala kisi: urutan + LIHAT SEMUA.
      row padding="14px 20px 8px 16px" align-items="center" justify-content="space-between"
        button popovertarget="menu-urut" testId="urut" padding="6px 9px 6px 12px" border-radius=18
          border="1px solid garis.tipis" display="flex" align-items="center" gap=4
          text (urutan == "komentar" ? t("urut.komentar") : urutan == "suka" ? t("urut.suka") : t("urut.terbaru")).toUpperCase() font-size=11 font-weight=600 letter-spacing=1.1
          box font-size=14
            image "symbol:icon.bawah"
        link href=path("cari") testId="lihat-semua"
          text t("beranda.lihatSemua") font-size=11 font-weight=600 letter-spacing=1.1 color="teks.utama"
      column id="menu-urut" popover="auto" role="menu" aria-label=t("urut.label")
        button press=urutkan("terbaru") popovertarget="menu-urut" popovertargetaction="hide" testId="urut-terbaru"
          text t("urut.terbaru")
        button press=urutkan("komentar") popovertarget="menu-urut" popovertargetaction="hide" testId="urut-komentar"
          text t("urut.komentar")
        button press=urutkan("suka") popovertarget="menu-urut" popovertargetaction="hide" testId="urut-suka"
          text t("urut.suka")
      KisiUndak(daftar=kisi, versi=`${pulau}|${urutan}`)

// Kartu sorotan: video laporan diputar otomatis tanpa suara selama Beranda tampil (sampul menutupinya sampai bingkai
// pertama), tombol suara di kanan atas, seperti aslinya.
component KartuSorotan
  props
    lap: Laporan
    video: string
    putar: bool
    bisu: bool
    gantiBisu: action
    disukai: bool
    jumlahSuka: number
    suka: action
  state bingkai = false
  // Video berhenti selama kartunya di luar layar (seperti aslinya): bingkai video tidak lagi menggambar ulang kanvas
  // saat Beranda digulir. Pesan waktu dimatikan (waktu=false): tiap pesan menjalankan aksi dan menggambar ulang.
  state terlihat = true
  action pesan(v: string)
    if v == "main"
      bingkai = true
  action amati(e: IntersectionObserverEntry)
    terlihat = e.isIntersecting
  view
    box position="relative" margin="12px 16px 0" intersect=amati
      column position="relative" height="clamp(380px, 115vw, 560px)" border-radius=28 overflow="hidden"
        background-color="media.kartu"
        // Media selebar kartu dan judul membuka laporan; suka dan komentar tombol sendiri, seperti aslinya.
        link href=path("laporan", lap.id) testId="sorotan" display="block" position="absolute" inset=0
          if video != ""
            video-putar sumber=video bisu=bisu putar=(putar and terlihat) waktu=false pas="cover" message=pesan
              position="absolute" inset=0
              width="100%" height="100%" aria-label=t("sorotan.video") testId="video-sorotan"
          if video == "" or not bingkai
            image lap.sampul alt=lap.judul position="absolute" inset=0 width="100%" height="100%" object-fit="cover"
        row position="absolute" top=16 left=16 right=16 justify-content="space-between" align-items="center"
          pointer-events="none"
          Pil(label=lap.tempat)
          if lap.adaVideo and video == ""
            box width=36 height=30 border-radius=10 background-color="media.tinta" color="media.teks" display="flex"
              align-items="center" justify-content="center" font-size=14
              image "symbol:icon.senyap"
        column position="absolute" left=0 right=0 bottom=0 min-height=124 padding="14px 18px 16px" gap=8
          background-color="media.pita"
          link href=path("laporan", lap.id) display="block"
            text lap.judul font-size=20 line-height=1.3 font-weight=700 color="media.teks" line-clamp=3 testId="judul-sorotan"
          row align-items="center" gap=16 color="media.teks"
            text lap.kredit font-size=13 font-weight=600 flex=1 min-width=0 line-clamp=1
            button press=suka testId="sorotan-suka" aria-label=(disukai ? t("suka.labelBatal", n=jumlahSuka) : t("suka.label", n=jumlahSuka))
              min-height=36 padding="0 2px" border="none" background-color="transparent"
              color=(disukai ? "aksen.isi" : "media.teks") display="flex" align-items="center" gap=6 font-size=18
              image (disukai ? "symbol:heart-fill" : "symbol:heart")
              if jumlahSuka > 0
                text hitung(jumlahSuka, t("angka.ribuan", utuh=ribuUtuh(jumlahSuka), desimal=ribuDesimal(jumlahSuka))) font-size=13 font-weight=600 color="media.teks"
            link href=path("komentar", lap.id) testId="sorotan-komentar" aria-label=t("umum.komentar")
              row min-height=36 align-items="center" gap=6 font-size=17 color="media.teks"
                image "symbol:icon.komentar"
                if lap.komentar > 0
                  text hitung(lap.komentar, t("angka.ribuan", utuh=ribuUtuh(lap.komentar), desimal=ribuDesimal(lap.komentar))) font-size=13 font-weight=600
      if video != ""
        button press=gantiBisu aria-label=(bisu ? t("video.nyalakanSuara") : t("video.matikanSuara")) testId="sorotan-suara"
          position="absolute" top=16 right=16 width=36 height=30 border-radius=10 padding=0 display="flex"
          align-items="center" justify-content="center" background-color="media.tinta" color="media.teks" font-size=14
          image (bisu ? "symbol:icon.senyap" : "symbol:speaker")

// KartuLive Beranda laporin-apps: video bisu siaran (pratinjau) di atas avatar penyiar bercincin aksen, lencana LIVE &
// penonton di kiri atas, "+N LIVE" ke tab Live di kanan atas, judul dan penyiar di bawah. Ketuk = tonton dengan suara.
component SorotanLive
  props
    s: SiaranPublik
    lainnya: number
    kini: number
    tonton: action
    keLive: action
    bahasa: string
  view
    box position="relative" margin="12px 16px 0"
      button press=tonton testId="sorotan-live" aria-label=t("live.tontonLabel", nama=s.nama, judul=s.judul, n=s.penonton)
        width="100%" padding=0 border="none" display="block" text-align="left" background-color="transparent"
        column position="relative" height="clamp(380px, 115vw, 560px)" border-radius=28 overflow="hidden"
          background-color="media.kartu"
          column position="absolute" inset=0 align-items="center" justify-content="center" padding-bottom=124
            box padding=3 border="2px solid aksen.isi" border-radius=60
              box width=96 height=96 border-radius=48 background-color="media.teks" color="media.tinta" display="flex"
                align-items="center" justify-content="center"
                text inisialNama(s.nama) font-size=38 font-weight=700
          if s.pratinjauToken != ""
            PratinjauSiaran(s=s, bahasa=bahasa)
          // Gradasi tipis, bukan pita gelap: video siaran terlihat sampai ke bawah kartu, teks tetap terbaca.
          column position="absolute" left=0 right=0 bottom=0 min-height=190 padding="56px 18px 16px" gap=8
            justify-content="flex-end" background-image="linear-gradient(180deg, transparent 0%, media.kepala 100%)"
            pointer-events="none"
            text s.judul font-size=20 line-height=1.3 font-weight=700 color="media.teks" line-clamp=3
              testId="judul-sorotan-live"
            text t("live.namaMulai", nama=s.nama, lalu=lalu(s.mulai, kini, t("waktu.baruSaja"), t("waktu.menitLalu", n=floor((kini - s.mulai) / 60000)), t("waktu.jamLalu", n=floor((kini - s.mulai) / 3600000)))) font-size=13 font-weight=600 color="media.teks" line-clamp=1
      row position="absolute" top=16 left=16 right=16 justify-content="space-between" align-items="center" gap=10
        row gap=6 align-items="center" pointer-events="none"
          row padding="6px 10px 6px 6px" border-radius=10 align-items="center" gap=4 background-color="aksen.isi"
            color="aksen.di"
            TitikLive(warna="aksen.di", ukuran=6, berdenyut=true)
            text "LIVE" font-size=11 font-weight=600 letter-spacing=0.7
          row padding="6px 10px" border-radius=10 align-items="center" gap=6 background-color="media.tinta"
            color="media.teks" font-size=12
            image "symbol:icon.mata"
            text hitung(s.penonton, t("angka.ribuan", utuh=ribuUtuh(s.penonton), desimal=ribuDesimal(s.penonton))) font-size=11 font-weight=600 letter-spacing=0.7
        if lainnya > 0
          button press=keLive testId="live-lainnya" aria-label=t("live.lainnya", n=lainnya)
            padding="6px 10px" border-radius=10 border="none" background-color="media.tinta" color="media.teks"
            text `+${lainnya} LIVE` font-size=11 font-weight=600 letter-spacing=0.7

// KisiUndak laporin-apps: dua kolom berundak; tinggi sampul bergiliran (rasioKisi) × lebar/174.
// `versi` (pulau dan urutan) ikut kunci potong: isi kisi berganti, tinggi yang tercatat tidak berlaku lagi.
component KisiUndak
  props
    daftar: Laporan[]
    versi: string
  view
    column gap=16
      for c in range(ceil(daftar.length / 15)) key=`${versi}:${c}`
        PotongKisi(daftar=daftar.slice(c * 15, c * 15 + 15), awal=c * 15)

// Satu potong 15 kartu (satu tambahan gulir tanpa ujung): dua kolom berundak yang ujungnya rata (rasioKisi).
// Kartunya hanya terpasang selama potong ini berada ±800 px dari layar; lebih jauh, potong menjadi satu kotak kosong
// setinggi ukuran terakhirnya. Exact menelusuri seluruh isi gulungan di setiap gambar ulang (sampul tiba, kartu
// ditambah) dan di setiap geser (scroll anchoring), jadi biayanya mengikuti kartu yang terpasang, bukan yang
// tampil. Melepas kartu juga melepas sampulnya: setiap gambar yang terpasang memegang sumbernya di pipeline gambar
// Exact, dan tanpa pembatas sampul setelah ±100 kartu tidak pernah dimuat di Android. Satu pengamat per potong,
// bukan per kartu: setiap aksinya commit dan menggambar ulang, jadi gulir hanya memicunya tiap ±2000 px.
component PotongKisi
  props
    daftar: Laporan[]
    awal: number
  state dekat = true
  state tinggi = 0
  action amati(e: IntersectionObserverEntry)
    dekat = e.isIntersecting
  action ukur(w: number, h: number)
    tinggi = h
  view
    column intersect=amati intersect-margin="800px 0px 800px 0px"
      if dekat or tinggi == 0
        row padding="0 16px" gap=10 align-items="flex-start" resize=ukur
          column flex=1 min-width=0 gap=16
            for l, i in daftar key=l.id
              if (awal + i) % 2 == 0
                KartuUndak(lap=l, rasio=rasioKisi(awal + i), sampul=dekat)
          column flex=1 min-width=0 gap=16
            for l, i in daftar key=l.id
              if (awal + i) % 2 == 1
                KartuUndak(lap=l, rasio=rasioKisi(awal + i), sampul=dekat)
      else
        box height=tinggi

// `sampul` = potongnya dekat layar (PotongKisi); kartu yang kembali mendekat menggambar sampulnya lagi dari cache.
component KartuUndak
  props
    lap: Laporan
    rasio: string
    sampul: bool
  view
    link href=path("laporan", lap.id) testId=`kartu-${lap.id}` display="block"
      column gap=8
        box position="relative" aspect-ratio=rasio border-radius=20 overflow="hidden" background-color="latar.redup"
          min-height=0
          if lap.sampulKecil != ""
            if sampul
              image lap.sampulKecil alt=lap.judul position="absolute" inset=0 width="100%" height="100%" object-fit="cover"
          else
            column position="absolute" inset=0 align-items="center" justify-content="center" font-size=28 color="teks.redup"
              image "symbol:icon.api"
          if lap.jumlahMedia > 1
            box position="absolute" top=8 right=8 padding=5 border-radius=6 background-color="media.kaca"
              color="media.teks" font-size=12 display="flex"
              image "symbol:icon.salin"
        column gap=4 padding="0 4px"
          text lap.judul font-size=14 line-height=1.25 font-weight=600 line-clamp=2
          row gap=0 min-width=0
            text lap.desa.toUpperCase() font-size=9 font-weight=600 letter-spacing=0.54 color="aksen.teks" line-clamp=1
              flex-shrink=1 min-width=0
            text ` · ${lap.tanggalPendek}` font-size=9 font-weight=600 letter-spacing=0.54 color="teks.redup" flex-shrink=0

component DetailLaporan
  props
    lap: Laporan
    serupa: Laporan[]
    tersimpan: bool
    simpan: action
    kembali: action
    laporkan: action
    aktif: bool
    disukai: bool
    jumlahSuka: number
    suka: action
  // Penggeser media: geser ke samping (atau ketuk sisi kanan/kiri) untuk maju/mundur, berputar: setelah media terakhir
  // kembali ke yang pertama, dan sebaliknya. Host Android belum membaca scroll-snap, jadi geseran dibaca `pan`: media
  // ini dan tetangganya mengikuti jari, lalu saat jari dilepas pindah bila sudah lewat 48 poin atau dilempar cepat,
  // selain itu kembali. Video diputar PemutarVideo dengan suara menyala seperti aslinya.
  state indeks = 0
  state bisu = false
  state geser = 0
  state menyeret = false
  state lebarMedia = 0
  state arah = 1
  derive video = videoKe(lap, indeks)
  derive banyak = lap.galeri.length > 1
  action maju
    if banyak
      arah = 1
      indeks = (indeks + 1) % lap.galeri.length
  action mundur
    if banyak
      arah = -1
      indeks = indeks > 0 ? indeks - 1 : lap.galeri.length - 1
  action ukurMedia(w: number, h: number)
    lebarMedia = w
  action geserMedia(dx: number, dy: number)
    if banyak
      menyeret = true
      geser = geser + dx
  action lepasMedia(vx: number, vy: number)
    if banyak and (mutlak(geser) > 48 or mutlak(vx) > 400)
      if geser + vx * 0.1 < 0
        maju()
      else
        mundur()
    geser = 0
    menyeret = false
  action gantiBisu
    bisu = not bisu
  action bagikan
    share(title=lap.judul, text=lap.judul, url=`https://fire.nusantara.earth/id/fire/${lap.slug}`)
  view
    column padding-bottom=120
      column background-color="media.tinta"
        column position="relative" height="56vw" overflow="hidden" resize=ukurMedia pan=geserMedia panrelease=lepasMedia
          touch-action="pan-y" testId="penggeser-media"
          if lap.galeri.length == 0 and lap.sampul != ""
            image lap.sampul alt=lap.judul position="absolute" inset=0 width="100%" height="100%" object-fit="cover"
          // Media ini dan kedua tetangganya (berputar: tetangga kanan media terakhir adalah yang pertama), berjajar
          // selebar layar; tetangga baru dipasang setelah lebarnya terukur.
          for g, i in lap.galeri key=g
            if i == indeks or (lebarMedia > 0 and letakMedia(i, indeks, lap.galeri.length, geser, arah) != 9)
              box position="absolute" inset=0
                translate=`${letakMedia(i, indeks, lap.galeri.length, geser, arah) * lebarMedia + geser}px 0px`
                transition=(menyeret ? "none" : "translate 280ms ease-out")
                if i == indeks and video != ""
                  // Kunci = alamat video: pindah media memasang pemutar baru, dengan kontrol dan posisinya sendiri.
                  for v in [video] key=v
                    PemutarVideo(sumber=v, sampul=g, aktif=aktif, bisu=bisu, pas="contain", adaSebelum=false,
                      adaSesudah=false, sebelum=mundur, sesudah=maju)
                else
                  image g alt=lap.judul position="absolute" inset=0 width="100%" height="100%" object-fit="cover"
          row position="absolute" top=8 left=8 right=12 align-items="center" justify-content="space-between"
            button press=kembali aria-label=t("umum.kembali") testId="kembali" width=44 height=44 border-radius=22
              display="flex" align-items="center" justify-content="center" background-color="media.kaca"
              color="media.teks" font-size=19
              image "symbol:icon.kiri"
            row align-items="center" gap=8
              row align-items="center" gap=6 padding="7px 11px" border-radius=12 background-color="media.kaca"
                box width=7 height=7 border-radius=4 background-color="aksen.isi"
                text lap.tempat.toUpperCase() font-size=11 font-weight=600 letter-spacing=0.6 color="media.teks" line-clamp=1
              if video != ""
                button press=gantiBisu aria-label=(bisu ? t("video.nyalakan") : t("video.bisukan")) testId="video-suara" width=44
                  height=44 border-radius=22 display="flex" align-items="center" justify-content="center" padding=0
                  background-color="media.kaca" color="media.teks" font-size=19
                  image (bisu ? "symbol:speaker-mute" : "symbol:speaker")
              link href=path("foto", lap.id, `${indeks}`) aria-label=t("media.layarPenuh") testId="layar-penuh"
                box width=44 height=44 border-radius=22 display="flex" align-items="center" justify-content="center"
                  background-color="media.kaca" color="media.teks" font-size=19
                  image "symbol:icon.penuh"
        if lap.galeri.length > 1
          row padding="12px 20px 18px" gap=4
            for g, i in lap.galeri key=g
              box flex=1 height=3 border-radius=2 background-color=(i <= indeks ? "media.teks" : "media.garis")
      column padding="18px 20px 0" gap=14 background-color="latar.halaman"
        row align-items="center" gap=10
          box width=38 height=38 border-radius=19 display="flex" align-items="center" justify-content="center"
            background-color="avatar.isi" color="avatar.teks" flex-shrink=0
            text lap.inisial font-size=14 font-weight=700
          column flex=1 min-width=0 gap=2
            row align-items="center" gap=6
              text lap.kredit font-size=15 font-weight=700 line-clamp=1 flex-shrink=1 min-width=0
              text t("status.terverifikasi") font-size=8.5 font-weight=600 letter-spacing=0.5 padding="2px 5px" border-radius=4
                border="1px solid garis.tegas" flex-shrink=0
            text t("detail.jumlahKredit", n=lap.jumlahKredit) font-size=12 color="teks.redup"
          button press=simpan testId="simpan" height=38 padding="0 14px" border-radius=19 border="1px solid teks.utama"
            display="flex" align-items="center" gap=6 font-size=14 flex-shrink=0
            background-color=(tersimpan ? "chip.aktif" : "transparent") color=(tersimpan ? "chip.di-aktif" : "teks.utama")
            image (tersimpan ? "symbol:checkmark" : "symbol:icon.simpan")
            text (tersimpan ? t("detail.tersimpan") : t("detail.simpan")) font-size=13 font-weight=700
        text lap.judul role="heading" aria-level=1 font-size=24 line-height=1.21 font-weight=700 letter-spacing=-0.4
          testId="judul-detail"
        if lap.deskripsi != ""
          text lap.deskripsi font-size=14 line-height=1.5 white-space="pre-line" color="teks.utama" opacity=0.82
        // Pita data: LOKASI · TANGGAL · SUMBER.
        row border-top="1px solid garis.tipis" border-bottom="1px solid garis.tipis"
          column flex=1 min-width=0 gap=4 padding="10px 0"
            row align-items="center" gap=4
              text t("detail.lokasi") font-size=9 font-weight=500 letter-spacing=0.7 color="teks.redup"
              box font-size=10 color="aksen.isi"
                image "symbol:icon.titik"
            text lap.lintang font-size=11 line-height=1.36 font-weight=600
            text lap.bujur font-size=11 line-height=1.36 font-weight=600
          column flex=1 min-width=0 gap=4 padding="10px 0 10px 12px" border-left="1px solid garis.tipis"
            text t("detail.tanggal") font-size=9 font-weight=500 letter-spacing=0.7 color="teks.redup"
            text lap.tanggalPendek font-size=11 line-height=1.36 font-weight=600
          column flex=1 min-width=0 gap=4 padding="10px 0 10px 12px" border-left="1px solid garis.tipis"
            text t("detail.sumber") font-size=9 font-weight=500 letter-spacing=0.7 color="teks.redup"
            text lap.kredit.toUpperCase() font-size=11 line-height=1.36 font-weight=600 line-clamp=2
        row gap=8 align-items="center" margin-bottom=22
          button press=suka testId="suka" aria-label=(disukai ? t("suka.labelBatal", n=jumlahSuka) : t("suka.label", n=jumlahSuka))
            height=44 padding="0 16px" border-radius=22 display="flex" align-items="center" gap=6 font-size=18
            border=(disukai ? "1px solid aksen.isi" : "1px solid garis.tipis")
            background-color=(disukai ? "aksen.isi" : "transparent") color=(disukai ? "aksen.di" : "teks.utama")
            image (disukai ? "symbol:heart-fill" : "symbol:heart")
            if jumlahSuka > 0
              text hitung(jumlahSuka, t("angka.ribuan", utuh=ribuUtuh(jumlahSuka), desimal=ribuDesimal(jumlahSuka))) font-size=13 font-weight=700 testId="jumlah-suka"
          link href=path("komentar", lap.id) testId="buka-komentar"
            row height=44 padding="0 16px" border-radius=22 border="1px solid garis.tipis" align-items="center" gap=6
              font-size=17
              image "symbol:icon.komentar"
              if lap.komentar > 0
                text hitung(lap.komentar, t("angka.ribuan", utuh=ribuUtuh(lap.komentar), desimal=ribuDesimal(lap.komentar))) font-size=13 font-weight=700
          TombolBulat(ikon="symbol:icon.bagikan", label=t("umum.bagikan"), tekan=bagikan, uji="bagikan")
          box flex=1
          button press=laporkan testId="laporkan" display="flex" align-items="center" gap=6 padding=0 font-size=16
            background-color="transparent" color="teks.redup"
            image "symbol:icon.bendera"
            text t("detail.laporkan") font-size=13 font-weight=600
      if serupa.length > 0
        column gap=14 background-color="latar.halaman"
          row padding="0 16px 12px" margin="0 0 0" border-bottom="1px solid garis.tipis"
            text t("detail.serupa") font-size=11 font-weight=600 letter-spacing=0.7 padding="10px 14px" border-radius=18
              background-color="chip.aktif" color="chip.di-aktif"
          KisiUndak(daftar=serupa, versi="serupa")

// Pemutar video laporan (Detail dan layar penuh) dengan kontrol gaya Netflix seperti KontrolVideo aslinya: ketuk video
// = kontrol muncul (mundur/maju 10 detik, putar/jeda, penggeser posisi, waktu), hilang sendiri setelah video berjalan
// 3 detik tanpa disentuh; tanpa kontrol hanya garis tipis posisi, dan ketuk sisi kiri/kanan berpindah media. Sampul
// menutupi video sampai bingkai pertamanya tampil; video yang gagal dimuat ulang dengan ketukan.
component PemutarVideo
  props
    sumber: string
    sampul: string
    aktif: bool
    bisu: bool
    pas: string
    adaSebelum: bool
    adaSesudah: bool
    sebelum: action
    sesudah: action
  state jeda = false
  state bingkai = false
  state galat = false
  state coba = 0
  state kontrol = false
  // Posisi dan durasi dalam ms dari pesan "waktu" pemutar; `sentuh` = posisi saat kontrol terakhir disentuh.
  state posisi = 0
  state durasi = 0
  state sentuh = 0
  // Lompatan (detik) dikirim ke pemutar setiap kali `lompatKe` naik.
  state lompat = 0
  state lompatKe = 0
  state seret = false
  state posSeret = 0
  derive persen = durasi > 0 ? min(100, posisi * 100 / durasi) : 0
  action pesan(v: string)
    if v.startsWith("waktu ")
      let p = angkaKe(v.split(" "), 1)
      if p < sentuh
        sentuh = p
      posisi = p
      durasi = angkaKe(v.split(" "), 2)
      if kontrol and not seret and not jeda and p - sentuh >= 3000
        kontrol = false
    else
      if v == "main" or v == "jeda"
        bingkai = true
      galat = v.startsWith("galat")
  action tampilkan
    kontrol = true
    sentuh = posisi
  action sembunyikan
    kontrol = false
  action gantiJeda
    jeda = not jeda
    sentuh = posisi
  action cobaLagi
    galat = false
    bingkai = false
    jeda = false
    coba = coba + 1
  action geser(detik: number)
    let ke = max(0, min(durasi / 1000, posisi / 1000 + detik))
    lompat = ke
    lompatKe = lompatKe + 1
    posisi = ke * 1000
    sentuh = ke * 1000
  action seretKe(v: number)
    seret = true
    posSeret = v
  action lepasKe(v: number)
    seret = false
    lompat = v
    lompatKe = lompatKe + 1
    posisi = v * 1000
    sentuh = v * 1000
  view
    column position="absolute" inset=0
      if sampul != "" and not bingkai
        image sampul alt=t("video.sampul") position="absolute" inset=0 width="100%" height="100%" object-fit=pas
      // Coba lagi = pemutar baru (kunci baru), yang memuat sumbernya dari awal.
      for k in [`${coba}`] key=k
        video-putar sumber=sumber bisu=bisu putar=(aktif and not jeda) pas=pas lompat=lompat lompatKe=lompatKe
          message=pesan position="absolute" inset=0 width="100%" height="100%" aria-label=t("video.laporan") testId="video"
      if galat
        button press=cobaLagi aria-label=t("video.muatUlang") testId="video-galat" position="absolute" inset=0 padding=0
          display="flex" flex-direction="column" align-items="center" justify-content="center" gap=10
          background-color="media.redam" color="media.teks"
          box font-size=26
            image "symbol:refresh"
          text t("video.galat") font-size=12.5 text-align="center"
      else if not kontrol
        row position="absolute" inset=0
          if adaSebelum
            button press=sebelum aria-label=t("media.sebelumnya") testId="media-mundur" flex=1 height="100%" padding=0
              background-color="transparent"
          button press=tampilkan aria-label=t("video.kontrol") testId="video-ketuk" flex=2 height="100%" padding=0
            display="flex" align-items="center" justify-content="center" background-color="transparent"
            if jeda
              box width=64 height=64 border-radius=32 display="flex" align-items="center" justify-content="center"
                background-color="media.teks" color="media.tinta" font-size=28
                image "symbol:play-fill"
          if adaSesudah
            button press=sesudah aria-label=t("media.berikutnya") testId="media-maju" flex=1 height="100%" padding=0
              background-color="transparent"
        box position="absolute" left=0 right=0 bottom=0 height=2 background-color="media.garis"
          box width=`${persen}%` height="100%" background-color="aksen.isi"
      else
        button press=sembunyikan aria-label=t("video.sembunyikanKontrol") testId="video-sembunyi" position="absolute" inset=0
          padding=0 background-color="media.redam"
        row position="absolute" inset=0 align-items="center" justify-content="center" gap=44
          button press=geser(-10) aria-label=t("video.mundur10") testId="video-mundur" width=52 height=52 padding=0
            display="flex" align-items="center" justify-content="center" background-color="transparent"
            color="media.teks"
            LambangLompat(ikon="symbol:icon.mundur")
          button press=gantiJeda aria-label=(jeda ? t("video.putar") : t("video.jeda")) testId="video-jeda" width=64 height=64
            border-radius=32 padding=0 display="flex" align-items="center" justify-content="center"
            background-color="media.teks" color="media.tinta" font-size=28
            image (jeda ? "symbol:play-fill" : "symbol:pause-fill")
          button press=geser(10) aria-label=t("video.maju10") testId="video-maju" width=52 height=52 padding=0
            display="flex" align-items="center" justify-content="center" background-color="transparent"
            color="media.teks"
            LambangLompat(ikon="symbol:icon.maju")
        row position="absolute" left=14 right=12 bottom=1 align-items="center" gap=10 color="media.teks"
          text jam(seret ? posSeret * 1000 : posisi) font-size=11 font-weight=600 min-width=34
            font-variant-numeric="tabular-nums" testId="video-waktu"
          input type="range" min=0 max=max(1, durasi / 1000) step=0.1 value=(seret ? posSeret : posisi / 1000)
            input=seretKe change=lepasKe aria-label=t("video.posisi", posisi=jam(posisi), durasi=jam(durasi)) testId="video-posisi"
            accent-color="aksen.isi" flex=1 min-width=0 height=44
          text jam(durasi) font-size=11 font-weight=600 min-width=34 text-align="right"
            font-variant-numeric="tabular-nums"

// Ikon mundur/maju dengan angka 10 di tengah lingkarannya.
component LambangLompat
  props
    ikon: string
  view
    box position="relative" width=34 height=34 display="flex" align-items="center" justify-content="center"
      box position="absolute" inset=0 font-size=34 display="flex"
        image ikon
      text "10" font-size=9.5 font-weight=700 padding-top=2

// Tab Peta (peta-laporan.tsx laporin-apps): "Di sekitar Anda", tiga mode (Laporan, Aerosol Karhutla, Angin dan Kualitas
// Udara), peta MapLibre di assets/peta/sekitar.html (citra satelit, titik laporan, asap CAMS, hotspot FIRMS, bilah waktu,
// Windy). Kepala, chip, tombol bulat, kartu dan lembar digambar di sini. Host Android Exact tidak menyentuhkan apa pun ke
// WebView, jadi hatch `sentuh-web` (modules/android) meneruskan pointer yang mendarat di peta (satu jari: tanpa cubit).
component HalamanPeta
  props
    mode: string
    pilihMode: action
    pulau: string
    bisaSaring: bool
    isi: string
    pesan: action
    siap: bool
    lap: Laporan[]
    jarak: string
    hotspot: string
    padKartu: number
    tinggiBilah: number
    legenda: bool
    globe: bool
    mencariLokasi: bool
    galatLokasi: bool
    bukaLembar: action
    bagikan: action
    gantiGlobe: action
    keNusantara: action
    keLokasiku: action
  view
    column flex=1 min-height=0
      row padding="12px 16px 14px 20px" gap=8 align-items="center" background-color="latar.halaman"
        text (pulau == "" ? t("peta.judul") : pulau) font-size=25 line-height=1.2 font-weight=700 letter-spacing=-0.4
          flex=1 min-width=0 line-clamp=1 testId="judul-peta"
        if bisaSaring
          TombolKecil(ikon="symbol:filter", label=t("peta.pilihPulau"), tekan=bukaLembar("pulau"), uji="peta-saring")
        TombolKecil(ikon="symbol:share", label=t("peta.bagikan"), tekan=bagikan, uji="peta-bagikan")
        TombolKecil(ikon="symbol:info", label=t("peta.panduan"), tekan=bukaLembar("panduan"), uji="peta-panduan")
      scroll overflow-x="auto" overflow-y="hidden" flex-shrink=0 background-color="latar.halaman" testId="chip-peta" scrollbar-width="none"
        row gap=8 padding="0 20px 12px"
          ChipTitik(label=t("peta.mode.laporan"), aktif=(mode == "laporan"), netral=false, pilih=pilihMode("laporan"), uji="mode-laporan")
          ChipTitik(label=t("peta.mode.asap"), aktif=(mode == "asap"), netral=false, pilih=pilihMode("asap"), uji="mode-asap")
          ChipTitik(label=t("peta.mode.angin"), aktif=(mode == "angin"), netral=false, pilih=pilihMode("angin"),
            uji="mode-angin")
      box flex=1 min-height=0 position="relative" background-color="latar.halaman"
        // Hatch di pembungkus seukuran WebView: view modul tidak menerima `hatch`.
        column position="absolute" top=0 left=0 right=0 bottom="calc(env(safe-area-inset-bottom) + 80px)"
          hatch="sentuh-web" data-kunci="sekitar" background-color="media.tinta"
          web-halaman alamat="file:///android_asset/app/assets/peta/sekitar.html" kunci="sekitar" isi=isi message=pesan
            flex=1 min-height=0 aria-label=t("peta.label") testId="peta-sekitar"
        if not siap
          column position="absolute" top=0 left=0 right=0 bottom="calc(env(safe-area-inset-bottom) + 80px)"
            align-items="center" justify-content="center" gap=14 padding="0 32px"
            pointer-events="none" color="media.redup"
            progress aria-label=t("peta.memuat")
            text t("peta.memuatCitra") font-size=13.5 line-height=1.48 text-align="center" testId="peta-memuat"
        if galatLokasi
          text t("peta.galatLokasi") position="absolute" top=60 left=28
            right=28 padding="9px 14px" border-radius=12 background-color="media.lembar" color="media.teks"
            font-size=13.5 font-weight=500 text-align="center" testId="peta-lokasi-galat"
        column position="absolute" left=0 right=0 top=0 bottom="calc(env(safe-area-inset-bottom) + 80px)"
          pointer-events="none"
          if legenda
            button press=bukaLembar("legenda") testId="peta-legenda" position="absolute" left=12
              bottom=(12 + padKartu + (tinggiBilah > 0 ? tinggiBilah + 10 : 0)) min-height=36 padding="0 12px"
              border-radius=18 border="1px solid garis.tipis" background-color="latar.halaman" color="teks.utama"
              display="flex" align-items="center" gap=6 box-shadow="0 4px 14px bayangan.bilah" pointer-events="auto"
              box font-size=15 display="flex"
                image "symbol:icon.daftar"
              text t("peta.legenda").toUpperCase() font-size=11 font-weight=600 letter-spacing=0.6
          column position="absolute" right=12 bottom=(12 + padKartu + (tinggiBilah > 0 ? tinggiBilah + 10 : 0)) gap=8
            pointer-events="auto"
            TombolPeta(ikon="symbol:layers", label=t("peta.lapisan"), tekan=bukaLembar("lapisan"), sibuk=false,
              redup=false, uji="peta-lapisan")
            TombolPeta(ikon=(globe ? "symbol:icon.peta" : "symbol:icon.bola"), label=(globe ? t("peta.datar") : t("peta.bola")),
              tekan=gantiGlobe, sibuk=false, redup=(mode == "angin"), uji="peta-globe")
            TombolPeta(ikon="symbol:home", label=t("peta.nusantara"), tekan=keNusantara, sibuk=false, redup=false,
              uji="peta-nusantara")
            TombolPeta(ikon="symbol:icon.bidik", label=t("peta.lokasiku"), tekan=keLokasiku, sibuk=mencariLokasi, redup=false,
              uji="peta-lokasiku")
          for l in lap key=l.id
            box position="absolute" left=12 right=12 bottom=12 pointer-events="auto"
              BarisKejadian(lap=l, jarak=jarak)
          if hotspot != ""
            box position="absolute" left=12 right=12 bottom=12 pointer-events="auto"
              KartuHotspot(info=hotspot)

// Tombol bulat kolom kanan peta (TombolPeta laporin-apps): 36 px; `redup` = tidak tersedia di mode ini.
component TombolPeta
  props
    ikon: string
    label: string
    tekan: action
    sibuk: bool
    redup: bool
    uji: string
  view
    button press=tekan aria-label=label testId=uji width=36 height=36 padding=0 border-radius=18
      border="1px solid garis.tipis" background-color="latar.halaman" color="teks.utama" display="flex"
      align-items="center" justify-content="center" font-size=17 box-shadow="0 4px 14px bayangan.bilah"
      opacity=(redup ? 0.45 : 1)
      if sibuk
        progress aria-label=t("peta.mencariLokasi") width=18 height=18
      else
        image ikon

// KartuHotspot laporin-apps: provinsi, tingkat kepercayaan, lalu waktu deteksi, satelit, dan FRP.
// `info` = "provinsi\tkepercayaan 0-2\twaktu\tsatelit\tfrp" dari halaman peta.
component KartuHotspot
  props
    info: string
  view
    column padding=12 border="1px solid garis.tipis" border-radius=20 background-color="latar.permukaan"
      color="teks.utama" box-shadow="0 10px 30px bayangan.kartu" testId="kartu-hotspot"
      text bagian(info, 0) font-size=17 line-height=1.29 font-weight=700
      row gap=6 align-items="center" margin-top=4
        box width=12 height=12 border-radius=6 border="1.5px solid media.tinta"
          background-color=(bagian(info, 1) == "2" ? "kepercayaan.tinggi" : bagian(info, 1) == "1" ? "kepercayaan.sedang" : "kepercayaan.rendah")
        text (bagian(info, 1) == "2" ? t("peta.hotspot.tinggi") : bagian(info, 1) == "1" ? t("peta.hotspot.sedang") : t("peta.hotspot.rendah"))
          font-size=10.5 font-weight=500 letter-spacing=0.6 color="teks.redup"
      column margin-top=8 padding-top=8 gap=4 border-top="1px solid garis.tipis"
        BarisDetailPeta(label=t("peta.hotspot.waktu"), nilai=bagian(info, 2))
        BarisDetailPeta(label=t("peta.hotspot.satelit"), nilai=bagian(info, 3))
        BarisDetailPeta(label="FRP", nilai=bagian(info, 4))

component BarisDetailPeta
  props
    label: string
    nilai: string
  view
    row gap=12 align-items="baseline"
      text label font-size=13 font-weight=500 color="teks.redup"
      text nilai font-size=13 font-weight=600 flex=1 min-width=0 text-align="right"

// Lembar tab Peta (LembarBawah laporin-apps): pilih pulau, lapisan peta, legenda, panduan.
component LembarPeta
  props
    lembar: string
    tutup: action
    umpan: Umpan
    pulau: string
    pilihPulau: action
    mode: string
    titik: bool
    asap: bool
    satelit: bool[]
    gantiLapisan: action
    hotspot: string
    infoAsap: string
    gaya: number
    gantiGaya: action
    topik: string
    pilihTopik: action
  view
    if lembar == "pulau"
      LembarPilihanLive(judul=t("peta.pulau.judul"), tutup=tutup)
        scroll max-height=420 scrollbar-width="none"
          column
            BarisPilihanLive(label=t("peta.pulau.semua"), keterangan=t("peta.jumlahLaporan", n=umpan.laporan.length), dipilih=(pulau == ""),
              pilih=pilihPulau(""), uji="pulau-peta-semua")
            for p in sortBy(umpan.pulau, x => x.jumlah, "desc") key=p.nama
              BarisPilihanLive(label=p.nama, keterangan=t("peta.jumlahLaporan", n=p.jumlah), dipilih=(pulau == p.nama),
                pilih=pilihPulau(p.nama), uji=`pulau-peta-${p.nama}`)
    else if lembar == "lapisan"
      LembarPilihanLive(judul=t("peta.lapisan"), tutup=tutup)
        scroll max-height=480 scrollbar-width="none"
          column
            if mode == "angin"
              BarisSakelar(label=t("peta.mode.angin"), keterangan=t("peta.lapisan.angin"), nyala=true,
                tekan=gantiLapisan("angin"), uji="lapisan-angin")
            else if mode == "asap"
              BarisSakelar(label=t("peta.mode.asap"), keterangan=t("peta.lapisan.asap"), nyala=asap,
                tekan=gantiLapisan("asap"), uji="lapisan-asap")
            else
              BarisSakelar(label=t("peta.lapisan.titik"), keterangan=t("peta.lapisan.titikKet"), nyala=titik,
                tekan=gantiLapisan("titik"), uji="lapisan-titik")
            text t("peta.lapisan.firms") font-size=11 font-weight=600 letter-spacing=0.8 color="teks.redup" margin-top=18
              margin-bottom=2
            BarisSakelar(label="NASA-TERRA/AQUA", keterangan=ketSatelit("MODIS", hotspot, 1, t("peta.satelit.galat"), t("peta.satelit.memuat"), t("peta.satelit.titik")), nyala=satelit.at(0) == some(true),
              tekan=gantiLapisan("s0"), uji="lapisan-s0")
            BarisSakelar(label="NASA-SNPP", keterangan=ketSatelit("VIIRS", hotspot, 2, t("peta.satelit.galat"), t("peta.satelit.memuat"), t("peta.satelit.titik")), nyala=satelit.at(1) == some(true),
              tekan=gantiLapisan("s1"), uji="lapisan-s1")
            BarisSakelar(label="NASA-NOAA20", keterangan=ketSatelit("VIIRS", hotspot, 3, t("peta.satelit.galat"), t("peta.satelit.memuat"), t("peta.satelit.titik")), nyala=satelit.at(2) == some(true),
              tekan=gantiLapisan("s2"), uji="lapisan-s2")
    else if lembar == "legenda"
      LembarPilihanLive(judul=t("peta.legenda"), tutup=tutup)
        scroll max-height=520 scrollbar-width="none"
          column gap=20 padding-bottom=8
            if mode == "asap" and asap
              column gap=10 testId="legenda-asap"
                row gap=6 align-items="center"
                  box font-size=15 display="flex" color=(gaya == 1 ? "palet.bara" : gaya == 2 ? "palet.spektrum" : "palet.firewatch")
                    image "symbol:icon.api"
                  text t("peta.mode.asap") font-size=14 font-weight=600
                row justify-content="space-between" align-items="center"
                  text t("peta.legenda.kepekatan") font-size=10 font-weight=500 letter-spacing=0.6 color="teks.redup"
                  button press=gantiGaya testId="ganti-palet" padding=0 border="none" background-color="transparent"
                    color="teks.utama" display="flex" align-items="center" gap=5
                    text (gaya == 1 ? t("peta.palet.bara") : gaya == 2 ? t("peta.palet.spektrum") : "Fire Watch") font-size=11 font-weight=600
                    box font-size=11 display="flex"
                      image "symbol:refresh"
                box height=8 border-radius=4 border="1px solid garis.tipis"
                  background-image=(gaya == 1 ? "linear-gradient(90deg, palet.bara-0 0%, palet.bara-1 30%, palet.bara-2 60%, palet.bara-3 85%, palet.bara-4 100%)" : gaya == 2 ? "linear-gradient(90deg, palet.spektrum-0 0%, palet.spektrum-1 20%, palet.spektrum-2 40%, palet.spektrum-3 60%, palet.spektrum-4 80%, palet.spektrum-5 100%)" : "linear-gradient(90deg, palet.fw-0 0%, palet.fw-1 12%, palet.fw-2 24%, palet.fw-3 36%, palet.fw-4 48%, palet.fw-5 60%, palet.fw-6 72%, palet.fw-7 82%, palet.fw-8 92%, palet.fw-9 100%)")
                row justify-content="space-between"
                  text t("peta.legenda.bersih") font-size=10 font-weight=500 letter-spacing=0.6 color="teks.redup"
                  text t("peta.legenda.sedang") font-size=10 font-weight=500 letter-spacing=0.6 color="teks.redup"
                  text t("peta.legenda.pekat") font-size=10 font-weight=500 letter-spacing=0.6 color="teks.redup"
                row justify-content="space-between" align-items="center" padding-top=8 border-top="1px solid garis.tipis"
                  text t("peta.legenda.siklus") font-size=10 font-weight=500 letter-spacing=0.6 color="teks.redup"
                  text (bagian(infoAsap, 1) != "" ? bagian(infoAsap, 1) : "—") font-size=11 font-weight=600
                    color="status.peringatan"
                text "Contains modified Copernicus Atmosphere Monitoring Service information 2026." font-size=10.5
                  line-height=1.43 color="teks.redup"
            if mode == "angin"
              column gap=8 testId="legenda-angin"
                text t("peta.legenda.skalaAqi") font-size=11 font-weight=600 letter-spacing=0.6
                BarisAqi(warna="aqi.baik", label=t("aqi.baik"), rentang="0–50")
                BarisAqi(warna="aqi.sedang", label=t("aqi.sedang"), rentang="51–100")
                BarisAqi(warna="aqi.sensitif", label=t("aqi.sensitif"), rentang="101–150")
                BarisAqi(warna="aqi.buruk", label=t("aqi.buruk"), rentang="151–200")
                BarisAqi(warna="aqi.parah", label=t("aqi.parah"), rentang="201–300")
                BarisAqi(warna="aqi.bahaya", label=t("aqi.bahaya"), rentang="301+")
                text t("panduan.angin.data")
                  font-size=12.5 line-height=1.44 color="teks.redup" margin-top=4
            if satelit.includes(true)
              column gap=8 testId="legenda-hotspot"
                row gap=6 align-items="center"
                  TitikLive(warna="kepercayaan.tinggi", ukuran=6, berdenyut=(bagian(hotspot, 0) == "memuat"))
                  text t("peta.legenda.hotspot", rentang=(bagian(hotspot, 4) != "" ? bagian(hotspot, 4) : t("peta.legenda.24jam"))) font-size=14
                    font-weight=600
                if bagian(hotspot, 0) == "memuat"
                  text t("peta.legenda.memuat") font-size=12.5 color="teks.redup"
                else if bagian(hotspot, 0) == "galat"
                  text t("peta.legenda.galat") font-size=12.5 color="status.peringatan"
                else if bagian(hotspot, 0) == "basi"
                  text t("peta.legenda.basi") font-size=12.5 color="status.peringatan"
                if satelit.at(0) == some(true)
                  BarisSatelit(nama="TERRA/AQUA", jumlah=bagian(hotspot, 1))
                if satelit.at(1) == some(true)
                  BarisSatelit(nama="SNPP", jumlah=bagian(hotspot, 2))
                if satelit.at(2) == some(true)
                  BarisSatelit(nama="NOAA20", jumlah=bagian(hotspot, 3))
                row gap=14 align-items="center" margin-top=2
                  for k in ["rendah", "sedang", "tinggi"] key=k
                    row gap=5 align-items="center"
                      box width=6 height=6 border-radius=3 background-color=`kepercayaan.${k}`
                      text (k == "rendah" ? t("peta.kepercayaan.rendah") : k == "sedang" ? t("peta.kepercayaan.sedang") : t("peta.kepercayaan.tinggi")) font-size=11.5 color="teks.redup"
            if not (mode == "asap" and asap) and mode != "angin" and not satelit.includes(true)
              text t("peta.legenda.kosong") font-size=13 color="teks.redup"
    else if lembar == "panduan"
      LembarPilihanLive(judul=t("panduan.judul"), tutup=tutup)
        scroll overflow-x="auto" overflow-y="hidden" flex-shrink=0 margin="0 -20px" scrollbar-width="none"
          row gap=8 padding="0 20px 12px"
            ChipTitik(label=t("peta.mode.asap"), aktif=(topik == "aerosol"), netral=true, pilih=pilihTopik("aerosol"),
              uji="topik-aerosol")
            ChipTitik(label=t("peta.mode.angin"), aktif=(topik == "angin"), netral=true, pilih=pilihTopik("angin"),
              uji="topik-angin")
            ChipTitik(label=t("panduan.topik.hotspot"), aktif=(topik == "hotspot"), netral=true, pilih=pilihTopik("hotspot"),
              uji="topik-hotspot")
            ChipTitik(label=t("panduan.topik.peringkat"), aktif=(topik == "peringkat"), netral=true, pilih=pilihTopik("peringkat"),
              uji="topik-peringkat")
        scroll max-height=460 scrollbar-width="none"
          column gap=14 padding-bottom=8 testId=`panduan-${topik}`
            if topik == "aerosol"
              text t("panduan.aerosol.pembuka") font-size=15
                line-height=1.47 font-weight=500
              BagianPanduan(judul=t("panduan.bagian.data"), isi=t("panduan.aerosol.data"))
              BagianPanduan(judul=t("panduan.bagian.caraMembaca"), isi=t("panduan.aerosol.caraMembaca"))
              BagianPanduan(judul=t("panduan.bagian.rentangWaktu"), isi=t("panduan.aerosol.rentangWaktu"))
              BagianPanduan(judul=t("panduan.bagian.lapisan"), isi=t("panduan.aerosol.lapisan"))
              BagianPanduan(judul=t("panduan.bagian.sumber"), isi=t("panduan.aerosol.sumber"))
            else if topik == "angin"
              text t("panduan.angin.pembuka") font-size=15 line-height=1.47
                font-weight=500
              BagianPanduan(judul=t("panduan.bagian.data"), isi=t("panduan.angin.data"))
              BagianPanduan(judul=t("panduan.bagian.skalaAqi"), isi=t("panduan.angin.skalaAqi"))
              BagianPanduan(judul=t("panduan.bagian.rentangWaktu"), isi=t("panduan.angin.rentangWaktu"))
              BagianPanduan(judul=t("panduan.bagian.lapisan"), isi=t("panduan.angin.lapisan"))
              BagianPanduan(judul=t("panduan.bagian.sumber"), isi=t("panduan.angin.sumber"))
            else if topik == "peringkat"
              text t("panduan.peringkat.pembuka") font-size=15
                line-height=1.47 font-weight=500
              BagianPanduan(judul=t("panduan.bagian.dihitung"), isi=t("panduan.peringkat.dihitung"))
              BagianPanduan(judul=t("panduan.bagian.caraMembaca"), isi=t("panduan.peringkat.caraMembaca"))
              BagianPanduan(judul=t("panduan.bagian.batasWilayah"), isi=t("panduan.peringkat.batasWilayah"))
            else
              text t("panduan.hotspot.pembuka")
                font-size=15 line-height=1.47 font-weight=500
              BagianPanduan(judul=t("panduan.bagian.satelit"), isi=t("panduan.hotspot.satelit"))
              BagianPanduan(judul=t("panduan.bagian.warna"), isi=t("panduan.hotspot.warna"))
              BagianPanduan(judul=t("panduan.bagian.rentangWaktu"), isi=t("panduan.hotspot.rentangWaktu"))
              BagianPanduan(judul=t("panduan.bagian.detailTitik"), isi=t("panduan.hotspot.detailTitik"))
              BagianPanduan(judul=t("panduan.bagian.catatan"), isi=t("panduan.hotspot.catatan"))
              BagianPanduan(judul=t("panduan.bagian.sumber"), isi=t("panduan.hotspot.sumber"))

component BarisSakelar
  props
    label: string
    keterangan: string
    nyala: bool
    tekan: action
    uji: string
  view
    button press=tekan testId=uji role="switch" aria-checked=nyala aria-label=label min-height=56 padding="10px 0"
      border="none" border-bottom="1px solid garis.tipis" background-color="transparent" color="teks.utama"
      display="flex" align-items="center" gap=12 text-align="left"
      column flex=1 min-width=0 gap=3 align-items="flex-start"
        text label font-size=15 font-weight=600
        text keterangan.toUpperCase() font-size=10.5 font-weight=500 letter-spacing=0.5 color="teks.redup"
      // Ukuran Contract tidak memuat padding (box-sizing CSS), jadi 40×22 + padding 3 = 46×28 dengan kenop di tengah.
      row width=40 height=22 border-radius=14 padding=3 flex-shrink=0 background-color=(nyala ? "aksen.isi" : "garis.tegas")
        align-items="center" justify-content=(nyala ? "flex-end" : "flex-start")
        box width=22 height=22 border-radius=11 background-color="media.teks"

component BarisAqi
  props
    warna: string
    label: string
    rentang: string
  view
    row gap=10 align-items="center"
      box width=20 height=10 border-radius=2 background-color=warna
      text label font-size=13 flex=1 min-width=0
      text rentang font-size=12 color="teks.redup" font-variant-numeric="tabular-nums"

component BarisSatelit
  props
    nama: string
    jumlah: string
  view
    row gap=8 align-items="center"
      text nama font-size=13 font-weight=600 flex=1
      text (jumlah != "" ? jumlah : "—") font-size=13 font-variant-numeric="tabular-nums"

component BagianPanduan
  props
    judul: string
    isi: string
  view
    column gap=4
      text judul.toUpperCase() font-size=11 font-weight=600 letter-spacing=0.8 color="teks.redup"
      text isi font-size=14 line-height=1.5

// Laporan yang diketuk di peta (BarisKejadian laporin-apps): sampul, judul, tempat · jarak · tanggal.
component BarisKejadian
  props
    lap: Laporan
    jarak: string
  view
    link href=path("laporan", lap.id) testId="kartu-peta-sekitar" display="block"
      row padding=8 gap=12 align-items="center" border="1px solid garis.tipis" border-radius=20
        background-color="latar.permukaan" color="teks.utama" box-shadow="0 10px 30px bayangan.kartu"
        box width=92 height=64 flex-shrink=0 border-radius=13 overflow="hidden" background-color="latar.redup"
          display="flex" align-items="center" justify-content="center" font-size=20 color="teks.redup"
          if lap.sampul != ""
            image (lap.sampulKecil != "" ? lap.sampulKecil : lap.sampul) alt=lap.judul width="100%" height="100%"
              object-fit="cover"
          else
            image "symbol:icon.api"
        column flex=1 min-width=0 gap=4
          text lap.judul font-size=15 line-height=1.2 font-weight=600 line-clamp=2
          text keteranganPeta(lap, jarak) font-size=10 font-weight=500 letter-spacing=0.5 color="teks.redup"
            line-clamp=1
        box font-size=19 color="teks.redup" flex-shrink=0 display="flex"
          image "symbol:icon.kanan"

// Tab Live (siaran.tsx laporin-apps): siaran publik yang sedang berjalan, paling banyak penonton dulu, dimuat ulang tiap
// 8 detik selama tab ini tampil. Kartu memutar video bisu pelapor (peserta tersembunyi) di atas inisialnya.
component HalamanSiaran
  props
    siaran: SiaranPublik[]
    kini: number
    mulai: action
    tonton: action
    bahasa: string
  view
    column padding="20px 0 120px"
      column padding="0 20px"
        text (siaran.length > 0 ? t("siaran.judulAda", n=siaran.length) : t("siaran.judul1")) font-size=36 line-height=1.22 font-weight=700
          letter-spacing=-0.4 color="aksen.teks" testId="judul-siaran"
        text (siaran.length > 0 ? t("siaran.judulAda2") : t("siaran.judul2")) font-size=36 line-height=1.22 font-weight=700
          letter-spacing=-0.4
        text (siaran.length > 0 ? t("siaran.subAda") : t("siaran.subKosong")) font-size=11
          font-weight=500 letter-spacing=0.4 color="teks.redup" padding-top=8
      column margin="18px 16px 28px" padding=22 border-radius=28 background-color="aksen.isi" color="aksen.di"
        align-items="flex-start"
        row align-items="center" gap=4 margin-left=-4
          TitikLive(warna="aksen.di", ukuran=7, berdenyut=true)
          text t("siaran.lapangan") font-size=11 font-weight=600 letter-spacing=0.9
        text t("siaran.ajakan") font-size=25 line-height=1.2 font-weight=700 letter-spacing=-0.4 margin-top=10
        text t("siaran.ajakanSub") font-size=14 line-height=1.43 font-weight=500
          margin-top=8 max-width=300
        button press=mulai testId="mulai-live" margin-top=18 min-height=48 padding="0 22px" border-radius=26
          background-color="chip.aktif" color="chip.di-aktif" display="flex" align-items="center" gap=8 font-size=18
          image "symbol:icon.siaran"
          text t("siaran.mulai") font-size=15 font-weight=700
      if siaran.length > 0
        text t("siaran.sedang") font-size=21 line-height=1.24 font-weight=700 padding="0 20px 12px" role="heading"
          aria-level=2
        row flex-wrap="wrap" gap=10 padding="0 16px"
          for s in sortBy(siaran, x => x.penonton, "desc") key=s.ruang
            KartuSiaran(s=s, kini=kini, buka=tonton(s.ruang), bahasa=bahasa)
      else
        Kosong(ikon="symbol:icon.siaran", pesan=t("siaran.kosong"))

component KartuSiaran
  props
    s: SiaranPublik
    kini: number
    buka: action
    bahasa: string
  view
    button press=buka testId=`siaran-${s.ruang}` aria-label=t("siaran.kartuLabel", judul=s.judul, nama=s.nama, n=s.penonton)
      width="calc((100% - 10px) / 2)" padding=0 border-radius=20 overflow="hidden" background-color="latar.permukaan"
      color="teks.utama" display="flex" flex-direction="column" text-align="left"
      box position="relative" width="100%" aspect-ratio="1.05" overflow="hidden" background-color="latar.redup"
        display="flex" align-items="center" justify-content="center"
        box width=66 height=66 border-radius=33 border="2px solid aksen.isi" padding=2 display="flex"
          box flex=1 border-radius=29 background-color="chip.aktif" color="chip.di-aktif" display="flex"
            align-items="center" justify-content="center"
            text inisialNama(s.nama) font-size=19 font-weight=700
        if s.pratinjauToken != ""
          PratinjauSiaran(s=s, bahasa=bahasa)
        row position="absolute" top=10 left=10 height=24 padding="0 8px" border-radius=7 align-items="center" gap=5
          background-color="aksen.isi" color="aksen.di"
          box width=6 height=6 border-radius=3 background-color="aksen.di"
          text "LIVE" font-size=12 font-weight=700 letter-spacing=0.4
        row position="absolute" top=10 right=10 height=24 padding="0 7px" border-radius=7 align-items="center" gap=4
          background-color="media.kaca" color="media.teks" font-size=11
          image "symbol:icon.mata"
          text hitung(s.penonton, t("angka.ribuan", utuh=ribuUtuh(s.penonton), desimal=ribuDesimal(s.penonton))) font-size=10 font-weight=600 letter-spacing=0.4 font-variant-numeric="tabular-nums"
      column padding="9px 12px 11px" gap=5 align-items="flex-start"
        text s.judul font-size=15 line-height=1.2 font-weight=700 line-clamp=2
        text `${s.nama} · ${lalu(s.mulai, kini, t("waktu.baruSaja"), t("waktu.menitLalu", n=floor((kini - s.mulai) / 60000)), t("waktu.jamLalu", n=floor((kini - s.mulai) / 3600000)))}`.toUpperCase() font-size=9.5 font-weight=500 letter-spacing=0.5
          color="teks.redup" line-clamp=1

// Video bisu pelapor (assets/live/tonton.html mode pratinjau) menutupi sampul; ketukan diteruskan ke kartunya.
component PratinjauSiaran
  props
    s: SiaranPublik
    bahasa: string
  view
    web-halaman alamat="file:///android_asset/app/assets/live/tonton.html"
      isi=`{"url":"${s.pratinjauUrl}","token":"${s.pratinjauToken}","pratinjau":true,"bahasa":"${bahasa == "EN" ? "en" : "id"}"}`
      position="absolute" inset=0 pointer-events="none" aria-label=t("siaran.pratinjau", judul=s.judul) testId=`pratinjau-${s.ruang}`

// Layar Live (live.tsx, persiapan-live.tsx, siaran-live.tsx laporin-apps): siapkan (GPS, judul, kualitas) → siaran
// (kamera di assets/live/siar.html, kepala, komentar, kontrol, lembar kualitas & penonton) → selesai.
component HalamanLive
  props
    tahap: string
    judul: string
    ubahJudul: action
    mulai: action
    menyiapkan: bool
    galat: string
    masuk: bool
    keProfil: action
    tutup: action
    lokasiAda: bool
    lat: number
    lng: number
    akurasi: number
    mencariLokasi: bool
    gagalLokasi: bool
    isi: string
    pesan: action
    terhubung: bool
    durasi: number
    penonton: number
    suka: number
    kirimSuka: action
    komentar: string[]
    nama: string
    lokasiTeks: string
    bisu: bool
    gantiBisu: action
    balik: action
    akhiri: action
    isiKomentar: string
    ubahKomentar: action
    kirimKomentar: action
    putus: bool
    durasiAkhir: number
    lengkapi: action
    keBeranda: action
    mutu: string
    pilihMutu: action
    lembar: string
    bukaLembar: action
    tutupLembar: action
    daftar: string[]
    sinyal: string
    tertahan: bool
    sinyalTeks: string
    gantiMutu: bool
    putusSementara: bool
    ktp: string
    verifikasi: action
  derive teksKtp = ktp == "menunggu" ? t("ktp.status.menunggu") : ktp == "ditolak" ? t("ktp.teks.ditolak") : ktp == "disetujui" ? t("ktp.teks.disetujui") : t("ktp.teks.belum")
  derive labelMutu = labelMutuSiar(mutu, t("live.mutu.hemat"), t("live.mutu.otomatis"))
  view
    if tahap == "siaran"
      column flex=1 min-height=0 position="relative" background-color="media.tinta" color="media.teks"
        web-halaman alamat="file:///android_asset/app/assets/live/siar.html" isi=isi message=pesan position="absolute"
          inset=0 aria-label=t("live.kamera") testId="kamera-siaran"
        button press=kirimSuka aria-label=t("live.kirimHati") testId="live-ketuk-hati" position="absolute" inset=0 padding=0
          border="none" background-color="transparent"
        if not terhubung or gantiMutu or putusSementara
          column position="absolute" inset=0 align-items="center" justify-content="center" gap=8
            background-color="media.selubung" pointer-events="none"
            progress aria-label=t("live.menyambung")
            text (not terhubung ? t("live.menyambungServer") : gantiMutu ? t("live.gantiMutu") : t("live.sinyalPutus"))
              font-size=15 font-weight=600 testId="live-menyambung"
        column position="absolute" top=0 left=0 right=0 padding="8px 12px 24px 16px" gap=10
          background-image="linear-gradient(180deg, media.kepala 0%, transparent 100%)"
          row gap=6 align-items="center"
            LencanaLive(terhubung=terhubung)
            if terhubung
              PilLive(ikon="", teks=durasiTeks(durasi), uji="live-durasi")
              button press=bukaLembar("penonton") aria-label=t("live.penontonLabel", n=penonton) testId="live-penonton" padding=0
                background-color="transparent" border="none"
                PilLive(ikon="symbol:icon.mata", teks=`${penonton}`, uji="")
              row flex=1 min-width=0 justify-content="flex-end"
                button press=bukaLembar("mutu") aria-label=t("live.mutu.judul") testId="live-sinyal" height=30
                  padding="0 10px" border-radius=9 border="none" background-color="media.kaca" color="media.teks"
                  display="flex" align-items="center" gap=5 min-width=0
                  box font-size=14 display="flex" color=warnaSinyal(sinyal, tertahan)
                    image "symbol:icon.sinyal"
                  if sinyalTeks != ""
                    text sinyalTeks font-size=11 font-weight=600 letter-spacing=0.6 font-variant-numeric="tabular-nums"
                      line-clamp=1
                  box font-size=12 display="flex"
                    image "symbol:icon.bawah"
          row gap=10 align-items="center"
            box width=32 height=32 border-radius=16 flex-shrink=0 background-color="media.teks" color="media.tinta"
              display="flex" align-items="center" justify-content="center"
              text (nama.trim() == "" ? "A" : inisialNama(nama)) font-size=13 font-weight=700
            column flex=1 min-width=0
              text (judul.trim() != "" ? judul.trim() : t("live.judulBawaan")) font-size=14 font-weight=700 line-clamp=1
              row gap=2 align-items="center" margin-top=1
                TitikLive(warna=(lokasiAda ? "media.hijau" : "media.mati"), ukuran=6, berdenyut=lokasiAda)
                text lokasiTeks font-size=10 font-weight=500 letter-spacing=0.3 color="media.redup" line-clamp=1
                  font-variant-numeric="tabular-nums" testId="live-lokasi"
          row align-self="flex-start" gap=6 padding="6px 10px" border-radius=9 align-items="center"
            background-color="media.kaca"
            box font-size=14 color="aksen.isi" display="flex"
              image "symbol:icon.awas"
            text (terhubung and penonton == 0 ? t("live.menungguPenonton") : t("live.jagaJarak"))
              font-size=12 font-weight=500
        column position="absolute" left=0 right=0 bottom=0 gap=12
          padding="40px 12px calc(env(safe-area-inset-bottom) + 16px) 16px"
          background-image="linear-gradient(180deg, transparent 0%, media.bayang 35%)"
          row align-items="flex-end" gap=12
            DaftarKomentarLive(komentar=komentar)
            column gap=10 align-items="center"
              TombolSamping(ikon="symbol:icon.atur", label=t("live.mutu.judul"), tekan=bukaLembar("mutu"), angka=0,
                aksen=false, uji="live-mutu")
              TombolSamping(ikon="symbol:heart-fill", label=t("live.kirimHati"), tekan=kirimSuka, angka=suka, aksen=true,
                uji="live-suka")
          KolomKomentarLive(isi=isiKomentar, ubah=ubahKomentar, kirim=kirimKomentar, petunjuk=t("live.tulisKomentar"))
          row justify-content="space-between" align-items="center" padding="0 16px"
            TombolKontrol(ikon=(bisu ? "symbol:icon.mikMati" : "symbol:microphone"),
              label=(bisu ? t("live.mikNyala") : t("live.mikMati")), tekan=gantiBisu, aktif=bisu, uji="live-mikrofon")
            button press=akhiri aria-label=t("live.akhiri") testId="akhiri-siaran" width=68 height=68 border-radius=34
              padding=0 border="4px solid media.teks" background-color="transparent" display="flex"
              align-items="center" justify-content="center"
              box width=26 height=26 border-radius=7 background-color="aksen.isi"
            TombolKontrol(ikon="symbol:icon.balik", label=t("live.balikKamera"), tekan=balik, aktif=false, uji="live-balik")
        if lembar == "mutu"
          LembarPilihanLive(judul=t("live.mutu.judul"), tutup=tutupLembar)
            for m in ["fhd60", "otomatis", "hd30", "hemat"] key=m
              BarisPilihanLive(label=labelMutuSiar(m, t("live.mutu.hemat"), t("live.mutu.otomatis")), keterangan=ketMutuSiar(m, t("live.mutu.ketFhd60"), t("live.mutu.ketHd30"), t("live.mutu.ketHemat"), t("live.mutu.ketOtomatis")), dipilih=(m == mutu), pilih=pilihMutu(m),
                uji=`mutu-${m}`)
        else if lembar == "penonton"
          PanelPenonton(daftar=daftar, tutup=tutupLembar)
    else if tahap == "selesai"
      column flex=1 min-height=0 padding="30px 20px calc(env(safe-area-inset-bottom) + 24px)" justify-content="center"
        text (putus ? t("live.selesai.terputus", durasi=durasiTeks(durasiAkhir)) : t("live.selesai.selesai", durasi=durasiTeks(durasiAkhir))) font-size=11
          font-weight=600 letter-spacing=0.9 color="aksen.teks" testId="live-selesai"
        column margin-top=16 padding-top=4
          text (putus ? t("live.selesai.putus1") : t("live.selesai.terima1")) font-size=40 line-height=1.22 font-weight=700 letter-spacing=-0.4
          text (putus ? t("live.selesai.putus2") : t("live.selesai.terima2")) font-size=40 line-height=1.22 font-weight=700 letter-spacing=-0.4
        text (putus ? t("live.selesai.ajakanPutus") : t("live.selesai.ajakan"))
          font-size=15 line-height=1.47 color="teks.redup" margin-top=16 max-width=360
        column gap=10 margin-top=28
          button press=lengkapi testId="lengkapi-laporan" min-height=56 border-radius=28 background-color="chip.aktif"
            color="chip.di-aktif" display="flex" align-items="center" justify-content="center"
            text t("live.selesai.lengkapi") font-size=15 font-weight=700
          button press=keBeranda testId="live-ke-beranda" min-height=56 border-radius=28 border="1px solid garis.tegas"
            background-color="transparent" color="teks.utama" display="flex" align-items="center" justify-content="center"
            text t("umum.keBeranda") font-size=15 font-weight=700
    else
      column flex=1 min-height=0 position="relative"
        row padding="8px 16px 0 20px" align-items="center" justify-content="space-between" gap=12
          text t("live.siapkan.judul") font-size=11 font-weight=600 letter-spacing=0.9 color="teks.redup"
          button press=tutup aria-label=t("umum.tutup") testId="tutup-live" width=36 height=36 padding=0 border-radius=18
            border="1px solid garis.tipis" background-color="transparent" color="teks.utama" display="flex"
            align-items="center" justify-content="center" font-size=17
            image "symbol:close"
        column padding="10px 20px 0"
          text t("siaran.judul1") font-size=32 line-height=1.22 font-weight=700 letter-spacing=-0.4
          text t("siaran.judul2") font-size=32 line-height=1.22 font-weight=700 letter-spacing=-0.4 color="aksen.teks"
        scroll flex=1 min-height=0 scrollbar-width="none"
          column padding="18px 20px 20px" gap=14
            KartuGps(ada=lokasiAda, lat=lat, lng=lng, akurasi=akurasi, gagal=gagalLokasi)
            Isian(label=t("live.siapkan.judulSiaran"), petunjuk="")
              input value=judul input=ubahJudul submit=mulai placeholder=t("live.siapkan.contohJudul")
                aria-label=t("live.siapkan.judulSiaran") maxlength=255 testId="judul-live" border="none" outline="none" margin="-6px -16px" padding="6px 16px" background-color="transparent"
                font-size=15 color="teks.utama"
            text (masuk ? t("live.siapkan.info") : t("live.siapkan.infoTamu"))
              font-size=12.5 line-height=1.44 color="teks.redup" margin-top=-6
            column
              box height=1 background-color="garis.tipis"
              // Verifikasi KTP: syarat siaran; ketuk = layar verifikasi (juga dibuka sendiri oleh Mulai siaran).
              if masuk and ktp != ""
                button press=verifikasi testId="live-verifikasi" aria-label=t("live.ktp.label", status=teksKtp)
                  min-height=62 padding="10px 0" border="none" background-color="transparent" color="teks.utama"
                  display="flex" align-items="center" gap=10 text-align="left"
                  column flex=1 min-width=0 gap=3 align-items="flex-start"
                    text t("live.ktp.judul") font-size=10 font-weight=600 letter-spacing=0.6 color="teks.redup"
                    text teksKtp font-size=15 font-weight=700 color=(ktp == "ditolak" ? "status.bahaya" : "teks.utama")
                  box font-size=18 display="flex" color=(ktp == "disetujui" ? "aksen.teks" : "teks.utama")
                    image (ktp == "disetujui" ? "symbol:checkmark" : "symbol:icon.kanan")
                box height=1 background-color="garis.tipis"
              button press=bukaLembar("mutu") testId="pilih-mutu" aria-label=t("live.mutu.label", mutu=labelMutu)
                min-height=62 padding="10px 0" border="none" background-color="transparent" color="teks.utama"
                display="flex" align-items="center" gap=10 text-align="left"
                column flex=1 min-width=0 gap=3 align-items="flex-start"
                  text t("live.mutu.judul").toUpperCase() font-size=10 font-weight=600 letter-spacing=0.6 color="teks.redup"
                  text labelMutu font-size=15 font-weight=700 testId="mutu-terpilih"
                box font-size=18 display="flex"
                  image "symbol:icon.kanan"
              box height=1 background-color="garis.tipis"
        column padding="10px 20px calc(env(safe-area-inset-bottom) + 14px)" gap=10
          if galat != ""
            row gap=8 padding=12 border-radius=16 border="1px solid status.bahaya" align-items="flex-start"
              color="status.bahaya"
              box font-size=17 display="flex"
                image "symbol:icon.awas"
              text galat font-size=13 line-height=1.38 font-weight=500 flex=1 min-width=0 testId="galat-live"
            if not masuk
              button press=keProfil testId="live-masuk" height=44 border-radius=22 border="1px solid teks.utama"
                background-color="transparent" color="teks.utama" display="flex" align-items="center"
                justify-content="center"
                text t("live.masukDiProfil") font-size=14 font-weight=700
          button press=mulai testId="mulai-siaran" height=56 border-radius=28 background-color="aksen.isi"
            color="aksen.di" display="flex" align-items="center" justify-content="center" gap=6
            if menyiapkan
              progress aria-label=t("live.menyiapkan")
            else
              TitikLive(warna="aksen.di", ukuran=7, berdenyut=false)
              text t("live.mulaiSiaran") font-size=15 font-weight=700 letter-spacing=0.4
          text t("live.ketentuan") markup="markdown" font-size=11.5
            line-height=1.4 text-align="center" color="teks.redup"
        if lembar == "mutu"
          LembarPilihanLive(judul=t("live.mutu.judul"), tutup=tutupLembar)
            for m in ["fhd60", "otomatis", "hd30", "hemat"] key=m
              BarisPilihanLive(label=labelMutuSiar(m, t("live.mutu.hemat"), t("live.mutu.otomatis")), keterangan=ketMutuSiar(m, t("live.mutu.ketFhd60"), t("live.mutu.ketHd30"), t("live.mutu.ketHemat"), t("live.mutu.ketOtomatis")), dipilih=(m == mutu), pilih=pilihMutu(m),
                uji=`mutu-${m}`)

// StatusGps persiapan-live.tsx: titik berdenyut di lingkaran aksen lembut, koordinat dan akurasi berhuruf kapital.
component KartuGps
  props
    ada: bool
    lat: number
    lng: number
    akurasi: number
    gagal: bool
  view
    row align-items="center" gap=12 padding=14 border-radius=16 border="1px solid garis.tipis"
      background-color="latar.permukaan" testId="kartu-gps"
      box width=40 height=40 border-radius=20 flex-shrink=0 background-color="aksen.lembut" color="aksen.isi"
        font-size=18 display="flex" align-items="center" justify-content="center"
        if ada
          TitikLive(warna="aksen.isi", ukuran=8, berdenyut=true)
        else
          image "symbol:icon.titik"
      column flex=1 min-width=0
        text (ada ? `${lat.toFixed(6)}, ${lng.toFixed(6)}` : gagal ? t("gps.izinDitolak") : t("gps.mencari")) font-size=12.5
          font-weight=600 letter-spacing=0.3 testId="koordinat"
        text (ada ? t("gps.live", akurasi=round(akurasi)) : t("gps.tanpaLokasi")) font-size=10 font-weight=500
          letter-spacing=0.6 color="teks.redup" margin-top=3

// Layar Tonton (tonton-live.tsx, kepala-tonton.tsx laporin-apps): video pelapor dari assets/live/tonton.html, kepala,
// komentar, hati, mode bersih, lapor, lembar kualitas & penonton.
component HalamanTonton
  props
    isi: string
    pesan: action
    menyambung: bool
    status: string
    galat: string
    judul: string
    nama: string
    mulai: number
    kini: number
    penonton: number
    komentar: string[]
    masuk: bool
    suka: number
    kirimSuka: action
    isiKomentar: string
    ubahKomentar: action
    kirimKomentar: action
    tutup: action
    keBeranda: action
    sambungLagi: action
    keProfil: action
    putus: bool
    bersih: bool
    gantiBersih: action
    laporkan: action
    mutu: string
    kualitas: string
    laju: string
    lapisan: string[]
    pilihMutu: action
    lembar: string
    bukaLembar: action
    tutupLembar: action
    daftar: string[]
  view
    column flex=1 min-height=0 position="relative" background-color="media.tinta" color="media.teks"
      if status == "berakhir" or status == "galat"
        column flex=1 align-items="center" justify-content="center" gap=16 padding="0 24px 24px"
          box font-size=56 color="media.mati" display="flex"
            image (status == "galat" ? "symbol:icon.luring" : "symbol:icon.siaran")
          text (status == "galat" ? galat : t("tonton.berakhir")) font-size=21 line-height=1.24 font-weight=700
            text-align="center" testId="tonton-akhir"
          text judul font-size=14 line-height=1.43 color="media.redup" text-align="center" line-clamp=2
          if status == "galat"
            button press=sambungLagi testId="tonton-ulang" margin-top=16 align-self="stretch" min-height=56
              border-radius=28 padding="0 22px" background-color="aksen.isi" color="aksen.di" display="flex"
              align-items="center" justify-content="center"
              text t("tonton.sambungLagi") font-size=16 font-weight=700 letter-spacing=0.5
            button press=keBeranda testId="tonton-kembali" align-self="stretch" min-height=48 padding="0 22px"
              border="none" background-color="transparent" color="aksen.isi" display="flex" align-items="center"
              justify-content="center"
              text t("umum.keBeranda") font-size=15 font-weight=700
          else
            button press=keBeranda testId="tonton-kembali" margin-top=16 align-self="stretch" min-height=56
              border-radius=28 padding="0 22px" background-color="aksen.isi" color="aksen.di" display="flex"
              align-items="center" justify-content="center"
              text t("umum.keBeranda").toUpperCase() font-size=16 font-weight=700 letter-spacing=0.5
      else
        if not menyambung
          web-halaman alamat="file:///android_asset/app/assets/live/tonton.html" isi=isi message=pesan
            position="absolute" inset=0 aria-label=t("tonton.label", judul=judul) testId="video-tonton"
        if masuk and not bersih
          button press=kirimSuka aria-label=t("live.kirimHati") testId="tonton-ketuk-hati" position="absolute" inset=0 padding=0
            border="none" background-color="transparent"
        if status != "video" or putus
          column position="absolute" inset=0 align-items="center" justify-content="center" gap=16 padding="0 24px"
            pointer-events="none" background-color=(putus ? "media.selubung" : "transparent")
            progress aria-label=t("tonton.menyambungkan")
            text (putus ? t("live.sinyalPutus") : status == "menunggu" ? t("tonton.pelaporPutus") : status == "terhubung" ? t("tonton.menungguVideo") : t("tonton.menyambungkanTitik"))
              font-size=14 line-height=1.43 color="media.redup" text-align="center" testId="tonton-status"
        if not bersih
          column position="absolute" top=0 left=0 right=0 padding="8px 12px 24px 16px" gap=14
            background-image="linear-gradient(180deg, media.kepala 0%, transparent 100%)"
            row gap=8 align-items="center"
              LencanaLive(terhubung=(status == "video" or status == "terhubung"))
              if mulai > 0
                PilLive(ikon="", teks=durasiTeks(kini - mulai), uji="tonton-durasi")
              box flex=1
              button press=bukaLembar("penonton") aria-label=t("live.penontonLabel", n=max(penonton, 1)) testId="tonton-penonton"
                padding=0 border="none" background-color="transparent"
                PilLive(ikon="symbol:icon.mata", teks=`${max(penonton, 1)}`, uji="")
              button press=tutup aria-label=t("tonton.tutup") testId="tutup-tonton" width=44 height=44 padding=0
                border-radius=22 border="none" background-color="media.kaca" color="media.teks" display="flex"
                align-items="center" justify-content="center" font-size=20
                image "symbol:close"
            row gap=10 align-items="center"
              box width=36 height=36 border-radius=18 flex-shrink=0 background-color="media.teks" color="media.tinta"
                display="flex" align-items="center" justify-content="center"
                text inisialNama(nama) font-size=13 font-weight=700
              column flex=1 min-width=0
                text nama font-size=14 font-weight=700 line-clamp=1
                text judul.toUpperCase() font-size=10 font-weight=500 letter-spacing=0.6 color="media.redup"
                  line-clamp=1 margin-top=1
              if status == "video"
                button press=bukaLembar("mutu") aria-label=t("live.mutu.judul") testId="tonton-mutu" height=30
                  padding="0 10px" border-radius=9 border="none" background-color="media.kaca" color="media.teks"
                  display="flex" align-items="center" gap=5
                  box font-size=14 display="flex"
                    image "symbol:icon.atur"
                  text labelMutuTonton(mutu, kualitas, lapisan) font-size=11 font-weight=600 letter-spacing=0.6
                    font-variant-numeric="tabular-nums" testId="tonton-mutu-label"
        column position="absolute" left=0 right=0 bottom=0 gap=14
          padding="40px 12px calc(env(safe-area-inset-bottom) + 16px) 16px"
          background-image=(bersih ? "linear-gradient(180deg, transparent 0%, transparent 100%)" : "linear-gradient(180deg, transparent 0%, media.bayang 35%)")
          row align-items="flex-end" gap=12
            if bersih
              box flex=1
            else
              DaftarKomentarLive(komentar=komentar)
            column gap=10 align-items="center"
              TombolSamping(ikon=(bersih ? "symbol:icon.mata" : "symbol:icon.anonim"),
                label=(bersih ? t("tonton.tampilkanSemua") : t("tonton.modeBersih")), tekan=gantiBersih, angka=0, aksen=false,
                uji="tonton-bersih")
              if not bersih
                if masuk
                  TombolSamping(ikon="symbol:heart-fill", label=t("live.kirimHati"), tekan=kirimSuka, angka=suka, aksen=true,
                    uji="tonton-hati")
                TombolSamping(ikon="symbol:icon.bendera", label=t("tonton.laporkan"), tekan=laporkan, angka=0, aksen=false,
                  uji="tonton-lapor")
          if not bersih
            if masuk
              KolomKomentarLive(isi=isiKomentar, ubah=ubahKomentar, kirim=kirimKomentar,
                petunjuk=t("tonton.petunjukKomentar"))
            else
              button press=keProfil testId="tonton-masuk" min-height=52 border-radius=26 padding="0 18px"
                border="1px solid media.garis" background-color="media.kaca" color="media.teks" display="flex"
                align-items="center" gap=8 text-align="left"
                box font-size=18 color="aksen.isi" display="flex"
                  image "symbol:icon.komentar"
                text t("tonton.masukKomentar") font-size=14 font-weight=600 flex=1 min-width=0
        if lembar == "mutu"
          PanelLive(judul=t("live.mutu.judul"), sub=t("tonton.mutuDiingat"), tutup=tutupLembar)
            BarisPanelLive(label=t("tonton.otomatis"), keterangan=ketOtomatis(kualitas, laju, t("tonton.ketOtomatis"), t("tonton.sekarang", kini=kualitas)), dipilih=(mutu == "otomatis"),
              pertama=true, pilih=pilihMutu("otomatis"), uji="mutu-otomatis")
            for l, i in lapisan key=l
              BarisPanelLive(label=bagian(l, 0), keterangan=ketLapisan(bagian(l, 1), i, lapisan.length, t("tonton.kualitasAsli", laju=bagian(l, 1)), t("tonton.hematKuota", laju=bagian(l, 1))),
                dipilih=(mutu == `${lapisan.length - 1 - i}`), pertama=false, pilih=pilihMutu(`${lapisan.length - 1 - i}`),
                uji=`mutu-${lapisan.length - 1 - i}`)
        else if lembar == "penonton"
          PanelPenonton(daftar=daftar, tutup=tutupLembar)

// LencanaLive interaksi-live.tsx: titik tinta berkedip setelah tersambung, kaca selama menyambung.
component LencanaLive
  props
    terhubung: bool
  view
    row height=30 padding="0 10px" border-radius=9 align-items="center" gap=7 testId="lencana-live"
      background-color=(terhubung ? "aksen.isi" : "media.kaca") color=(terhubung ? "aksen.di" : "media.teks")
      if terhubung
        box width=8 height=8 border-radius=4 background-color="aksen.di" animation="kedip 1200ms steps(1) infinite"
        text "LIVE" font-size=13 font-weight=700 letter-spacing=0.4
      else
        text t("live.menghubungkan") font-size=11 font-weight=700 letter-spacing=0.4

// PilLive: kaca 30 px; tanpa ikon = durasi (angka sedikit lebih besar).
component PilLive
  props
    ikon: string
    teks: string
    uji: string
  view
    row height=30 padding="0 10px" border-radius=9 align-items="center" gap=5 background-color="media.kaca"
      color="media.teks" font-size=14 testId=uji
      if ikon != ""
        image ikon
      text teks font-size=(ikon == "" ? 12 : 11) font-weight=600 letter-spacing=(ikon == "" ? 0.3 : 0.6)
        font-variant-numeric="tabular-nums"

// TombolSamping interaksi-live.tsx: lingkaran kaca 52 px di kanan komentar, angkanya di bawah ikon bila ada.
component TombolSamping
  props
    ikon: string
    label: string
    tekan: action
    angka: number
    aksen: bool
    uji: string
  view
    button press=tekan aria-label=label testId=uji width=52 height=52 padding=0 border-radius=26
      border="1px solid media.garis" background-color="media.kaca" color=(aksen ? "aksen.isi" : "media.teks")
      display="flex" flex-direction="column" align-items="center" justify-content="center" gap=1
      box font-size=(angka > 0 ? 19 : 21) display="flex"
        image ikon
      if angka > 0
        text hitungHati(angka, t("angka.ribuanRapat", utuh=ribuUtuh(angka), desimal=ribuDesimal(angka))) font-size=9 font-weight=600 color="media.teks" testId=`${uji}-angka`

// Mikrofon dan balik kamera: lingkaran 52 px; `aktif` (mikrofon mati) terisi tulang.
component TombolKontrol
  props
    ikon: string
    label: string
    tekan: action
    aktif: bool
    uji: string
  view
    button press=tekan aria-label=label testId=uji width=52 height=52 padding=0 border-radius=26
      border=(aktif ? "1px solid media.teks" : "1px solid media.garis") background-color=(aktif ? "media.teks" : "media.kaca")
      color=(aktif ? "media.tinta" : "media.teks") display="flex" align-items="center" justify-content="center"
      font-size=23
      image ikon

// Enam komentar terakhir tanpa gelembung, yang lebih lama memudar; nama berpenanda peran ("BUDI · PETUGAS").
component DaftarKomentarLive
  props
    komentar: string[]
  view
    column flex=1 min-width=0 gap=12 justify-content="flex-end" align-items="flex-start"
      for c, i in komentar key=`${i}-${c}`
        column gap=2 opacity=(0.5 + 0.5 * (i + 1) / max(komentar.length, 1))
          text labelKomentar(c, t("live.anda"), t("peran.petugas"), t("peran.pelapor")) font-size=10 font-weight=600 letter-spacing=0.6 color=warnaKomentar(c) line-clamp=1
          text komentarIsi(c) font-size=14 line-height=1.36 color="media.teks"

component KolomKomentarLive
  props
    isi: string
    ubah: action
    kirim: action
    petunjuk: string
  view
    row gap=8 align-items="center"
      row flex=1 min-width=0 height=52 padding="0 18px" border-radius=26 border="1px solid media.garis"
        background-color="media.kaca" align-items="center"
        input value=isi input=ubah submit=kirim placeholder=petunjuk aria-label=t("live.komentar") maxlength=200
          testId="komentar-live" flex=1 min-width=0 border="none" outline="none" background-color="transparent" color="media.teks"
          font-size=14
      button press=kirim aria-label=t("komentar.kirim") testId="kirim-komentar-live" width=52 height=52 padding=0
        border-radius=26 border="none" background-color="media.teks" color="media.tinta" display="flex"
        align-items="center" justify-content="center" font-size=20 opacity=(isi.trim() == "" ? 0.45 : 1)
        image "symbol:send"

// TitikLive laporin-apps: titik dengan lingkaran halo yang membesar dan memudar tiap 1,4 detik.
component TitikLive
  props
    warna: string
    ukuran: number
    berdenyut: bool
  view
    box position="relative" width=(ukuran * 2) height=(ukuran * 2) flex-shrink=0 display="flex" align-items="center"
      justify-content="center"
      if berdenyut
        box position="absolute" inset=0 border-radius=ukuran background-color=warna
          animation="denyut 1400ms ease-out infinite"
      box width=ukuran height=ukuran border-radius=(ukuran / 2) background-color=warna

// LembarPilihan laporin-apps: lembar bertema dari bawah di atas tirai gelap, pegangan, judul, tombol tutup.
// CaptchaLaporan laporin-apps: lembar "Verifikasi singkat" dengan halaman Turnstile server di WebView (sentuhan
// diteruskan lewat hatch sentuh-web); tamu ditawari masuk dengan akun untuk melewatinya.
component LembarCaptcha
  props
    alamat: string
    pesan: action
    galat: string
    anonim: bool
    mengirim: bool
    tutup: action
    ulang: action
    masuk: action
  view
    column position="absolute" inset=0 justify-content="flex-end" z-index=10
      button press=tutup aria-label=t("captcha.tutup") testId="tutup-captcha-tirai" position="absolute" inset=0 padding=0
        border="none" background-color="latar.tirai"
      column position="relative" background-color="latar.permukaan" color="teks.utama" border-radius="28px 28px 0 0"
        padding="10px 20px calc(env(safe-area-inset-bottom) + 22px)" gap=12 testId="lembar-captcha"
        box align-self="center" width=40 height=4 border-radius=2 background-color="garis.tegas"
        row align-items="flex-start" justify-content="space-between" gap=12
          column flex=1 min-width=0 gap=2
            text t("captcha.tanpaAkun") font-size=11 font-weight=600 letter-spacing=0.8 color="aksen.teks"
            text t("captcha.judul") font-size=22 line-height=1.23 font-weight=700
          button press=tutup aria-label=t("umum.tutup") testId="tutup-captcha" width=44 height=44 padding=0 border-radius=22
            border="1px solid garis.tipis" background-color="transparent" color="teks.utama" display="flex"
            align-items="center" justify-content="center" font-size=19
            image "symbol:close"
        text t("captcha.pesan")
          font-size=13.5 line-height=1.48 color="teks.redup"
        column position="relative" height=150 border-radius=18 overflow="hidden" background-color="latar.halaman"
          hatch="sentuh-web" data-kunci="captcha"
          web-halaman alamat=alamat kunci="captcha" message=pesan flex=1 min-height=0 aria-label=t("captcha.label")
            testId="captcha"
          // Halaman galat bawaan WebView (berbahasa Inggris) ditutup; pesannya ada di bawah kotak.
          if galat != "" and not mengirim
            column position="absolute" inset=0 align-items="center" justify-content="center" gap=8
              background-color="latar.halaman" color="teks.redup" font-size=28
              image "symbol:icon.luring"
          if mengirim
            column position="absolute" inset=0 align-items="center" justify-content="center" gap=10
              background-color="latar.permukaan"
              progress aria-label=t("lapor.mengirim")
              text t("lapor.mengirimTitik") font-size=13 color="teks.redup"
        if galat != ""
          row gap=8 padding=12 border-radius=16 border="1px solid status.bahaya" align-items="flex-start"
            color="status.bahaya"
            box font-size=17 display="flex"
              image "symbol:icon.awas"
            text galat font-size=13 line-height=1.38 font-weight=500 flex=1 min-width=0 testId="galat-captcha"
          button press=ulang testId="captcha-coba-lagi" height=46 border-radius=23 border="1px solid garis.tegas"
            background-color="transparent" color="teks.utama" display="flex" align-items="center"
            justify-content="center" gap=8 font-size=17
            image "symbol:refresh"
            text t("umum.cobaLagi") font-size=14.5 font-weight=700
        if not anonim
          button press=masuk testId="captcha-masuk" height=46 border-radius=23 background-color="chip.aktif"
            color="chip.di-aktif" display="flex" align-items="center" justify-content="center"
            text t("captcha.masuk") font-size=14.5 font-weight=700

component LembarPilihanLive
  props
    judul: string
    tutup: action
  slot
  view
    column position="absolute" inset=0 justify-content="flex-end" z-index=10
      button press=tutup aria-label=t("umum.tutupLembar") testId="tutup-lembar-tirai" position="absolute" inset=0 padding=0
        border="none" background-color="latar.tirai"
      column position="relative" background-color="latar.permukaan" color="teks.utama" border-radius="28px 28px 0 0"
        padding="10px 20px calc(env(safe-area-inset-bottom) + 12px)"
        box align-self="center" width=40 height=4 border-radius=2 background-color="garis.tegas" margin-bottom=14
        row align-items="center" justify-content="space-between" gap=12 margin-bottom=6
          text judul font-size=22 line-height=1.23 font-weight=700
          button press=tutup aria-label=t("umum.tutup") testId="tutup-lembar" width=44 height=44 padding=0 border-radius=22
            border="1px solid garis.tipis" background-color="transparent" color="teks.utama" display="flex"
            align-items="center" justify-content="center" font-size=19
            image "symbol:close"
        children

component BarisPilihanLive
  props
    label: string
    keterangan: string
    dipilih: bool
    pilih: action
    uji: string
  view
    button press=pilih testId=uji min-height=56 padding="10px 0" border="none" border-bottom="1px solid garis.tipis"
      background-color="transparent" color="teks.utama" display="flex" align-items="center" gap=10 text-align="left"
      column flex=1 min-width=0 gap=3 align-items="flex-start"
        text label font-size=15 font-weight=(dipilih ? 700 : 600)
        text keterangan font-size=10.5 line-height=1.4 font-weight=500 letter-spacing=0.5 color="teks.redup"
      if dipilih
        box width=22 height=22 border-radius=11 flex-shrink=0 background-color="aksen.isi" color="aksen.di" display="flex"
          align-items="center" justify-content="center" font-size=13
          image "symbol:checkmark"

// PanelPilihanLive laporin-apps: lembar kaca gelap di atas video, tanpa tirai (ketuk di luar menutupnya).
component PanelLive
  props
    judul: string
    sub: string
    tutup: action
  slot
  view
    column position="absolute" inset=0 justify-content="flex-end" z-index=10
      button press=tutup aria-label=t("umum.tutupLembar") testId="tutup-panel" position="absolute" inset=0 padding=0
        border="none" background-color="transparent"
      column position="relative" gap=8 padding="20px 16px calc(env(safe-area-inset-bottom) + 8px)"
        border-radius="28px 28px 0 0" border="1px solid media.garis-lembar" background-color="media.lembar"
        color="media.teks"
        column gap=4 padding="0 4px"
          text judul font-size=21 line-height=1.24 font-weight=700
          if sub != ""
            text sub font-size=10 font-weight=500 letter-spacing=0.6 color="media.samar" testId="sub-panel"
        children

component BarisPanelLive
  props
    label: string
    keterangan: string
    dipilih: bool
    pertama: bool
    pilih: action
    uji: string
  view
    button press=pilih testId=uji min-height=58 padding="10px 4px" border="none"
      border-top=(pertama ? "0px solid transparent" : "1px solid media.garis-lembar") background-color="transparent"
      color="media.teks" display="flex" align-items="center" gap=12 text-align="left"
      column flex=1 min-width=0 gap=2 align-items="flex-start"
        text label font-size=15 font-weight=(dipilih ? 700 : 600)
        text keterangan font-size=12.5 line-height=1.36 color="media.samar"
      if dipilih
        box width=22 height=22 border-radius=11 flex-shrink=0 background-color="aksen.isi" color="aksen.di" display="flex"
          align-items="center" justify-content="center" font-size=14
          image "symbol:checkmark"

// PanelPenonton: petugas dulu, lalu yang paling baru bergabung; baris diri sendiri "Warga · Kamu".
component PanelPenonton
  props
    daftar: string[]
    tutup: action
  derive jumlahPetugas = daftar.filter(p => bagian(p, 0) == "petugas").length
  view
    PanelLive(judul=t("live.penonton.judul"), sub=(daftar.length == 0 ? "" : jumlahPetugas > 0 ? t("live.penonton.subPetugas", n=daftar.length, petugas=jumlahPetugas) : t("live.penonton.sub", n=daftar.length)), tutup=tutup)
      scroll max-height=360 scrollbar-width="none"
        column
          for p, i in daftar key=`${i}-${p}`
            row min-height=58 gap=12 padding="10px 4px" align-items="center"
              border-top=(i == 0 ? "0px solid transparent" : "1px solid media.garis-lembar")
              box width=36 height=36 border-radius=18 flex-shrink=0 background-color="media.avatar" display="flex"
                align-items="center" justify-content="center"
                border=(bagian(p, 0) == "petugas" ? "2px solid aksen.isi" : "2px solid transparent")
                text inisialNama(bagian(p, 1)) font-size=13 font-weight=700
              column flex=1 min-width=0 gap=2
                text bagian(p, 1) font-size=15 font-weight=600 line-clamp=1
                text ((bagian(p, 0) == "petugas" ? t("peran.petugas") : bagian(p, 0) == "pelapor" ? t("peran.pelapor") : t("peran.warga")) + (bagian(p, 2) == "1" ? t("live.penonton.kamu") : "")) font-size=12.5 line-height=1.36
                  color=(bagian(p, 0) == "petugas" ? "aksen.isi" : "media.samar")
          if daftar.length == 0
            text t("live.penonton.kosong") font-size=14 padding="16px 4px" testId="penonton-kosong"

// Profil tamu: kartu PanelMasuk laporin-apps (Lanjutkan dengan Google, masuk atau daftar dengan email).
component HalamanProfil
  props
    google: action
    galatGoogle: string
    memuatMasuk: bool
    galatMasuk: string
    masukEmail: action
  // Form email tertutup dulu, seperti aslinya; isian kosong dan sandi pendek dijawab di sini, sisanya oleh server.
  state formEmail = "tutup"
  state namaDaftar = ""
  state email = ""
  state sandi = ""
  state lihatSandi = false
  state galatEmail = ""
  derive daftar = formEmail == "daftar"
  action bukaForm(ke: string)
    formEmail = ke
    galatEmail = ""
  action ubahNamaDaftar(v: string)
    namaDaftar = v
  action ubahEmail(v: string)
    email = v
  action ubahSandi(v: string)
    sandi = v
  action gantiLihatSandi
    lihatSandi = not lihatSandi
  action kirimEmail
    if daftar and namaDaftar.trim() == ""
      galatEmail = t("profil.galat.nama")
    else if email.trim() == ""
      galatEmail = t("profil.galat.email")
    else if sandi == ""
      galatEmail = t("profil.galat.sandi")
    else if daftar and sandi.length < 8
      galatEmail = t("profil.galat.sandiPendek")
    else
      galatEmail = ""
      masukEmail(daftar, namaDaftar, email, sandi)
  view
    column padding-bottom=120
      KepalaProfil()
      // Kartu di tengah ruang antara kepala dan bilah bawah, seperti aslinya.
      column min-height="calc(100vh - 175px)" justify-content="center" padding="18px 16px 0"
        column padding="22px 22px" gap=14 border-radius=28 background-color="latar.permukaan" testId="panel-masuk"
          text t("profil.akunWarga") font-size=11 font-weight=600 letter-spacing=0.9 color="teks.redup"
          column
            text t("profil.masukKe") font-size=30 line-height=1.23 font-weight=700 letter-spacing=-0.4
            text "Laporin." font-size=30 line-height=1.23 font-weight=700 letter-spacing=-0.4 color="aksen.teks"
          text t("profil.ajakan") font-size=14
            line-height=1.5 color="teks.redup"
          button press=google disabled=memuatMasuk testId="masuk-google" min-height=52 border-radius=26 display="flex"
            align-items="center" justify-content="center" gap=10 background-color="chip.aktif" color="chip.di-aktif"
            if memuatMasuk and formEmail == "tutup"
              progress aria-label=t("profil.memuatGoogle")
            else
              text "G" font-size=19 font-weight=700
              text t("profil.google") font-size=15 font-weight=700
          if galatGoogle != ""
            text galatGoogle font-size=12.5 line-height=1.42 font-weight=500 color="status.bahaya" testId="galat-google"
          if formEmail == "tutup"
            button press=bukaForm("masuk") testId="masuk-email" min-height=52 border-radius=26 border="1px solid garis.tegas"
              display="flex" align-items="center" justify-content="center" gap=10 background-color="transparent"
              color="teks.utama" font-size=19
              image "symbol:icon.surel"
              text t("profil.emailBuka") font-size=15 font-weight=700
          else
            column gap=10 testId="form-email"
              text (daftar ? t("profil.daftarEmail").toUpperCase() : t("profil.masukEmail").toUpperCase()) font-size=11 font-weight=600 letter-spacing=0.9
                color="teks.redup"
              if daftar
                Isian(label=t("profil.nama"), petunjuk=t("profil.namaPetunjuk"))
                  input value=namaDaftar input=ubahNamaDaftar aria-label=t("profil.nama") maxlength=100 autocomplete="name"
                    testId="daftar-nama" border="none" outline="none" margin="-6px -16px" padding="6px 16px" background-color="transparent" font-size=15 font-weight=500
                    color="teks.utama"
              Isian(label=t("profil.email"), petunjuk="")
                input type="email" value=email input=ubahEmail aria-label=t("profil.email") maxlength=254 autocomplete="email"
                  testId="email" border="none" outline="none" margin="-6px -16px" padding="6px 16px" background-color="transparent" font-size=15 font-weight=500 color="teks.utama"
              Isian(label=t("profil.sandi"), petunjuk=(daftar ? t("profil.sandiPetunjuk") : ""))
                input type=(lihatSandi ? "text" : "password") value=sandi input=ubahSandi submit=kirimEmail
                  aria-label=t("profil.sandi") autocomplete=(daftar ? "new-password" : "current-password") testId="sandi"
                  border="none" outline="none" margin="-6px -16px" padding="6px 16px" background-color="transparent" font-size=15 font-weight=500 color="teks.utama"
              button press=gantiLihatSandi role="switch" aria-checked=lihatSandi testId="lihat-sandi" align-self="flex-start"
                display="flex" align-items="center" gap=6 padding=0 background-color="transparent" color="teks.redup"
                font-size=16
                image (lihatSandi ? "symbol:icon.anonim" : "symbol:icon.mata")
                text (lihatSandi ? t("profil.sembunyikanSandi") : t("profil.tampilkanSandi")) font-size=12 line-height=1.42
              button press=kirimEmail disabled=memuatMasuk testId="kirim-email" min-height=52 border-radius=26
                display="flex" align-items="center" justify-content="center" background-color="aksen.isi" color="aksen.di"
                text (memuatMasuk ? t("profil.memproses") : daftar ? t("profil.daftarMasuk") : t("umum.masuk")) font-size=15 font-weight=700
              if galatEmail != ""
                text galatEmail font-size=13 line-height=1.45 font-weight=500 color="status.bahaya" testId="galat-email"
              row flex-wrap="wrap" align-items="center" gap=4
                text (daftar ? t("profil.sudahPunya") : t("profil.belumPunya")) font-size=12 line-height=1.42 color="teks.redup"
                button press=bukaForm(daftar ? "masuk" : "daftar") testId="ganti-form-email" padding=0
                  background-color="transparent" color="aksen.teks"
                  text (daftar ? t("umum.masuk") : t("profil.daftarEmail")) font-size=12 line-height=1.42 font-weight=600
          if galatMasuk != "" and not memuatMasuk
            text galatMasuk font-size=13 line-height=1.45 font-weight=500 color="status.bahaya" testId="galat-masuk"
          text t("profil.ketentuan")
            markup="markdown" font-size=12 line-height=1.42 color="teks.redup"

// Logo Laporin: dua ikon dengan viewBox yang sama ditumpuk, "Lapor" berwarna teks (ikut tema) dan "in" + sinyal oranye.
component Merek
  props
    tinggi: number
  view
    // Ikon simbol digambar sebagai persegi seukuran font-size, logonya mengisi lebar dan berada di tengah tinggi:
    // persegi selebar logo digeser ke atas setengah selisihnya, jadi pita logonya pas di kotak setinggi `tinggi`.
    box position="relative" width=(tinggi * 276 / 75.4) height=tinggi flex-shrink=0 role="img" aria-label="Laporin"
      testId="merek"
      image "symbol:icon.merekLapor" position="absolute" left=0 top=((tinggi - tinggi * 276 / 75.4) / 2)
        font-size=(tinggi * 276 / 75.4) color="teks.utama"
      image "symbol:icon.merekIn" position="absolute" left=0 top=((tinggi - tinggi * 276 / 75.4) / 2)
        font-size=(tinggi * 276 / 75.4) color="merek.oranye"

component KepalaProfil
  view
    row min-height=64 padding="0 16px 0 20px" align-items="center" justify-content="space-between"
      Merek(tinggi=30)
      link href=path("pengaturan") aria-label=t("pengaturan.judul") testId="buka-pengaturan"
        box width=34 height=34 border-radius=17 border="1px solid garis.tipis" display="flex" align-items="center"
          justify-content="center" font-size=17
          image "symbol:icon.atur"

component ProfilAkun
  props
    sesi: Sesi
    laporan: LaporanAkun[]
    memuat: bool
    gagal: bool
    tersimpan: Laporan[]
    buatLaporan: action
    disukai: Laporan[]
    memuatSuka: bool
  state tab = "laporan"
  action pilihTab(t: string)
    tab = t
  view
    column padding-bottom=120
      KepalaProfil()
      column align-items="center" padding="5px 28px 20px"
        box width=96 height=96 border-radius=48 display="flex" align-items="center" justify-content="center"
          background-color="chip.aktif" color="chip.di-aktif"
          text sesi.inisial font-size=32 font-weight=700
        text sesi.nama font-size=24 line-height=1.21 font-weight=700 letter-spacing=-0.4 margin-top=14 testId="nama-akun"
        if sesi.tayang > 0
          text t("profil.pelaporTerverifikasi") font-size=9.5 font-weight=600 letter-spacing=0.6 padding="3px 6px" border-radius=4
            border="1px solid garis.tegas" margin-top=8
        if sesi.email != ""
          text sesi.email font-size=13 color="teks.redup" margin-top=8
      row margin="0 20px" border-top="1px solid garis.tipis" border-bottom="1px solid garis.tipis"
        Statistik(label=t("profil.laporan"), nilai=sesi.laporan, garis=false)
        Statistik(label=t("ktp.teks.disetujui"), nilai=sesi.tayang, garis=true)
        Statistik(label=t("profil.disukai"), nilai=sesi.disukai, garis=true)
      row padding="14px 16px 12px" margin-bottom=12 gap=8 border-bottom="1px solid garis.tipis"
        Chip(label=t("profil.laporan"), aktif=(tab == "laporan"), pilih=pilihTab("laporan"), uji="tab-laporan")
        Chip(label=t("profil.disukai"), aktif=(tab == "disukai"), pilih=pilihTab("disukai"), uji="tab-disukai")
        Chip(label=t("detail.tersimpan"), aktif=(tab == "tersimpan"), pilih=pilihTab("tersimpan"), uji="tab-tersimpan")
      if tab == "laporan"
        if gagal and laporan.length == 0
          KosongProfil(ikon="symbol:icon.luring", pesan=t("profil.gagalMuat"))
        else if memuat and laporan.length == 0
          column padding=40 align-items="center"
            progress aria-label=t("profil.memuatLaporan")
        else if laporan.length == 0
          KosongProfil(ikon="symbol:camera", pesan=t("profil.kosongLaporan"))
            button press=buatLaporan testId="akun-buat-laporan" margin-top=6 height=48 padding="0 22px" border-radius=26
              background-color="aksen.isi" color="aksen.di" display="flex" align-items="center" gap=8 font-size=18
              image "symbol:add"
              text t("profil.buatLaporan") font-size=15 font-weight=700 letter-spacing=0.4
        else
          row flex-wrap="wrap" gap=6 padding="0 16px"
            for l in laporan key=l.id
              Petak(gambar=l.sampul, judul=l.judul, uji=`akun-${l.id}`, penuh=false)
                row align-items="center" gap=4
                  box width=6 height=6 border-radius=3
                    background-color=(l.status == "tayang" ? "status.sukses" : l.status == "ditolak" ? "status.bahaya" : "status.peringatan")
                  text (l.status == "tayang" ? t("status.terverifikasi") : l.status == "ditolak" ? t("status.ditolak") : t("status.ditinjau")) font-size=9.5 font-weight=600 letter-spacing=0.4 color="media.teks"
      else if tab == "disukai"
        if disukai.length == 0 and memuatSuka
          column padding=40 align-items="center"
            progress aria-label=t("profil.memuatDisukai")
        else if disukai.length == 0
          KosongProfil(ikon="symbol:heart", pesan=t("profil.kosongDisukai"))
        else
          row flex-wrap="wrap" gap=6 padding="0 16px"
            for l in disukai key=l.id
              link href=path("laporan", l.id) width="calc((100% - 12px) / 3)" testId=`disukai-${l.id}`
                Petak(gambar=l.sampulKecil, judul=l.judul, uji=`petak-suka-${l.id}`, penuh=true)
                  row align-items="center" gap=4 font-size=10
                    box color="aksen.isi"
                      image "symbol:heart-fill"
                    text hitung(max(l.suka, 1), t("angka.ribuan", utuh=ribuUtuh(max(l.suka, 1)), desimal=ribuDesimal(max(l.suka, 1)))) font-size=9.5 font-weight=600 color="media.teks"
      else if tersimpan.length == 0
        KosongProfil(ikon="symbol:icon.simpan", pesan=t("profil.kosongTersimpan"))
      else
        row flex-wrap="wrap" gap=6 padding="0 16px"
          for l in tersimpan key=l.id
            link href=path("laporan", l.id) width="calc((100% - 12px) / 3)" testId=`tersimpan-${l.id}`
              Petak(gambar=l.sampulKecil, judul=l.judul, uji=`petak-${l.id}`, penuh=true)
                row align-items="center" gap=4 font-size=10
                  box color="aksen.isi"
                    image "symbol:heart"
                  text hitung(l.suka, t("angka.ribuan", utuh=ribuUtuh(l.suka), desimal=ribuDesimal(l.suka))) font-size=9.5 font-weight=600 color="media.teks"

// Petak kisi profil: 3 kolom, rasio 3:4, sudut 14, pil keterangan di kiri bawah. `penuh`: di dalam tautan yang
// sudah selebar satu kolom.
component Petak
  props
    gambar: string
    judul: string
    uji: string
    penuh: bool
  slot
  view
    box position="relative" width=(penuh ? "100%" : "calc((100% - 12px) / 3)") aspect-ratio="3 / 4" border-radius=14 overflow="hidden"
      background-color="latar.redup" testId=uji
      if gambar != ""
        image gambar alt=judul position="absolute" inset=0 width="100%" height="100%" object-fit="cover"
      else
        text judul position="absolute" inset=0 padding=10 font-size=13 line-height=1.23 font-weight=700 line-clamp=4
          display="flex" align-items="center" text-align="center"
      row position="absolute" left=6 bottom=6 padding="3px 6px" border-radius=6 background-color="media.kaca"
        children

component KosongProfil
  props
    ikon: string
    pesan: string
  slot
  view
    column align-items="center" gap=10 padding="40px 28px"
      box width=56 height=56 border-radius=28 display="flex" align-items="center" justify-content="center"
        background-color="latar.redup" font-size=24 color="teks.redup"
        image ikon
      text pesan font-size=13.5 line-height=1.48 color="teks.redup" text-align="center" testId="profil-kosong"
      children

component Statistik
  props
    label: string
    nilai: number
    garis: bool
  view
    column flex=1 min-width=0 gap=2 padding=(garis ? "10px 0 10px 12px" : "10px 0")
      border-left=(garis ? "1px solid garis.tipis" : "none")
      text label.toUpperCase() font-size=9.5 font-weight=500 letter-spacing=0.8 color="teks.redup"
      text nilai.toString() font-size=21 line-height=1.24 font-weight=700 font-variant-numeric="tabular-nums"

component BilahAtas
  props
    judul: string
    kembali: action
  view
    row min-height=64 padding="0 16px" align-items="center" gap=8 background-color="latar.halaman"
      button press=kembali aria-label=t("umum.kembali") testId="kembali" width=34 height=34 border-radius=17
        border="1px solid garis.tipis" display="flex" align-items="center" justify-content="center" font-size=17
        image "symbol:back"
      text judul role="heading" aria-level=1 flex=1 text-align="center" font-size=18 line-height=1.22 font-weight=700
      box width=34 height=34

component HalamanCari
  props
    kueri: string
    cari: action
    cariIni: action
    saringan: string
    pilihFilter: action
    hasil: Laporan[]
    jumlah: number
    mencari: bool
    umpan: Umpan
    lokasiGagal: bool
    kePeta: action
    kembali: action
    idIsi: string
  view
    column flex=1 min-height=0
      row padding="10px 16px 4px"
        TombolKecil(ikon="symbol:back", label=t("umum.kembali"), tekan=kembali, uji="kembali")
      scroll id=idIsi flex=1 min-height=0 scrollbar-width="none"
        column padding-bottom=120
          column padding="6px 20px 18px"
            text t("cari.judul1") font-size=31 line-height=1.23 font-weight=700 letter-spacing=-0.4
            text t("cari.judul2") font-size=31 line-height=1.23 font-weight=700 letter-spacing=-0.4 color="teks.redup"
          row margin="0 16px 14px" height=52 padding="0 18px" border-radius=26 background-color="latar.permukaan"
            border="1px solid garis.tipis" align-items="center" gap=11 font-size=20 color="teks.redup"
            image "symbol:search"
            input type="search" value=kueri input=cari placeholder=t("cari.petunjuk") aria-label=t("beranda.cari")
              testId="kolom-cari" flex=1 min-width=0 border="none" outline="none" background-color="transparent" font-size=15
              color="teks.utama"
            if kueri != ""
              button press=cariIni("") aria-label=t("cari.hapus") testId="hapus-cari" font-size=18 padding=0
                background-color="transparent" color="teks.redup"
                image "symbol:close"
          scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none"
            row gap=6 padding="0 16px"
              Chip(label=t("umum.semua"), aktif=(saringan == "semua"), pilih=pilihFilter("semua"), uji="filter-semua")
              Chip(label=t("cari.terdekat"), aktif=(saringan == "terdekat"), pilih=pilihFilter("terdekat"), uji="filter-terdekat")
              Chip(label=t("cari.video"), aktif=(saringan == "video"), pilih=pilihFilter("video"), uji="filter-video")
              Chip(label=t("urut.suka"), aktif=(saringan == "suka"), pilih=pilihFilter("suka"), uji="filter-suka")
          if saringan == "terdekat" and lokasiGagal
            text t("cari.galatLokasi") font-size=13 font-weight=500
              color="status.bahaya" padding="10px 20px 0"
          if mencari
            text (kueri.trim() != "" ? t("cari.jumlahHasil", n=jumlah) : t("cari.jumlahLaporan", n=jumlah)) font-size=11 font-weight=500
              letter-spacing=0.6 color="teks.redup" padding="18px 20px 6px" testId="jumlah-hasil"
            if jumlah == 0
              text t("cari.kosong") font-size=13.5 color="teks.redup" padding="8px 20px"
            for l in hasil key=l.id
              link href=path("laporan", l.id) testId=`hasil-${l.id}`
                row margin="0 16px" padding="10px 0" gap=12 align-items="center" border-bottom="1px solid garis.tipis"
                  box position="relative" width=105 height=70 border-radius=14 overflow="hidden" background-color="latar.redup"
                    flex-shrink=0
                    if l.sampulKecil != ""
                      image l.sampulKecil alt=l.judul width="100%" height="100%" object-fit="cover"
                    if l.adaVideo
                      box position="absolute" top=6 left=6 width=22 height=22 border-radius=11 display="flex"
                        align-items="center" justify-content="center" background-color="media.kaca" color="media.teks"
                        font-size=10
                        image "symbol:play-fill"
                  column flex=1 min-width=0 gap=4
                    text l.judul font-size=16 line-height=1.25 font-weight=700 line-clamp=2
                    text `${l.tempat.toUpperCase()} · ${l.tanggalPendek}` font-size=10 font-weight=500 letter-spacing=0.5
                      color="teks.redup" line-clamp=1
          else
            text t("cari.ramai") font-size=21 line-height=1.24 font-weight=700 padding="22px 20px 12px"
            row flex-wrap="wrap" gap=8 padding="0 16px"
              for p in umpan.provinsi key=p.nama
                ChipTitik(label=p.nama, aktif=false, netral=false, pilih=cariIni(p.nama), uji=`ramai-${p.nama}`)
            for l in umpan.laporan.filter(x => x.sampul != "").slice(0, 1) key=l.id
              button press=kePeta testId="kartu-peta" margin="28px 16px 0" border="1px solid garis.tipis" border-radius=28
                overflow="hidden" padding=0 display="flex" flex-direction="column" background-color="transparent"
                color="teks.utama" text-align="left"
                box position="relative" height=168
                  image l.sampul alt=t("cari.petaKejadian") width="100%" height="100%" object-fit="cover"
                  row position="absolute" top=16 left=16
                    Pil(label=l.desa)
                column padding="18px 18px 15px" gap=6 align-items="flex-start"
                  text t("cari.petaKejadian").toUpperCase() font-size=11 font-weight=600 letter-spacing=0.8 color="teks.redup"
                  column
                    text t("cari.jumlahKejadian", n=umpan.laporan.length) font-size=22 line-height=1.23 font-weight=700 color="aksen.teks"
                    text t("cari.tercatat") font-size=22 line-height=1.23 font-weight=700
                  row margin-top=6 height=36 padding="0 14px" border-radius=18 border="1px solid teks.utama"
                    align-items="center" gap=6 font-size=13
                    image "symbol:icon.peta"
                    text t("cari.lihatPeta") font-size=11 font-weight=600 letter-spacing=0.7
            if umpan.sumber.length > 0
              text t("cari.sumber") font-size=21 line-height=1.24 font-weight=700 padding="28px 20px 12px"
              scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none"
                row gap=19 padding="0 16px"
                  for su in umpan.sumber key=su.nama
                    button press=cariIni(su.nama) testId=`sumber-${su.nama}` width=76 padding=0 display="flex"
                      flex-direction="column" align-items="center" gap=6 background-color="transparent" color="teks.utama"
                      box position="relative" width=60 height=60
                        box width=60 height=60 border-radius=30 display="flex" align-items="center" justify-content="center"
                          background-color="avatar.isi" color="avatar.teks"
                          text su.inisial font-size=20 font-weight=700
                        box position="absolute" left=-2 bottom=-2 width=20 height=20 border-radius=10 display="flex"
                          align-items="center" justify-content="center" background-color="chip.aktif" color="chip.di-aktif"
                          border="2px solid latar.halaman" font-size=10
                          image "symbol:checkmark"
                      text su.nama font-size=13 font-weight=700 line-clamp=1 text-align="center"
                      text t("cari.jumlahLaporan", n=su.jumlah) font-size=9.5 font-weight=500 color="teks.redup"
            text t("cari.terbaru") font-size=21 line-height=1.24 font-weight=700 padding="28px 20px 12px"
            scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none"
              row gap=10 padding="0 16px"
                for l in umpan.laporan.slice(0, 10) key=l.id
                  link href=path("laporan", l.id) testId=`poster-${l.id}`
                    column width=168 border-radius=20 overflow="hidden" background-color="latar.permukaan"
                      box position="relative" height=112 background-color="latar.redup"
                        if l.sampulKecil != ""
                          image l.sampulKecil alt=l.judul width="100%" height="100%" object-fit="cover"
                        if l.adaVideo
                          box position="absolute" top=10 left=10 width=26 height=22 border-radius=6 display="flex"
                            align-items="center" justify-content="center" background-color="media.kaca" color="media.teks"
                            font-size=11
                            image "symbol:play-fill"
                      text l.judul font-size=15 line-height=1.2 font-weight=700 line-clamp=2 padding="12px 10px 12px"

// Isian laporin-apps: panel bergaris, label huruf kapital, isian, petunjuk.
component Isian
  props
    label: string
    petunjuk: string
  slot
  view
    column gap=7 padding="13px 16px" border-radius=16 border="1px solid garis.tipis" background-color="latar.permukaan"
      text label.toUpperCase() font-size=10.5 font-weight=600 letter-spacing=0.6 color="teks.redup"
      children
      if petunjuk != ""
        text petunjuk font-size=11.5 line-height=1.4 color="teks.redup" opacity=0.8 margin-top=1

component FormLapor
  props
    judul: string
    deskripsi: string
    nama: string
    anonim: bool
    galat: string
    mengirim: bool
    akun: string
    pilihan: string[]
    gambarFoto: string[]
    menyalin: bool
    hapusFoto: action
    bukaKamera: action
    bukaGaleri: action
    lokasiAda: bool
    lat: number
    lng: number
    akurasi: number
    mencariLokasi: bool
    gagalLokasi: bool
    lokasiDitolak: bool
    perbaruiLokasi: action
    bukaIzin: action
    ubahJudul: action
    ubahDeskripsi: action
    ubahNama: action
    ubahAnonim: action
    kirim: action
    kembali: action
    idIsi: string
  view
    column flex=1 min-height=0
      BilahAtas(judul=t("tab.lapor"), kembali=kembali)
      scroll id=idIsi flex=1 min-height=0 scrollbar-width="none"
        column padding="12px 20px 24px" gap=12
          Alis(teks=t("lapor.alis"), aksen=false)
          column padding="4px 0 0"
            text t("lapor.judul1") font-size=31 line-height=1.23 font-weight=700 letter-spacing=-0.4
            text t("lapor.judul2") font-size=31 line-height=1.23 font-weight=700 letter-spacing=-0.4 color="aksen.teks"
          text t("lapor.sub") font-size=14 line-height=1.5 color="teks.redup"
          Isian(label=t("lapor.judulSingkat"), petunjuk="")
            input value=judul input=ubahJudul placeholder=t("lapor.contohJudul")
              aria-label=t("lapor.judulSingkat") maxlength=255 testId="judul" border="none" outline="none" margin="-6px -16px" padding="6px 16px" background-color="transparent"
              font-size=15 font-weight=500 color="teks.utama"
          KartuLokasi(ada=lokasiAda, lat=lat, lng=lng, akurasi=akurasi, mencari=mencariLokasi, gagal=gagalLokasi,
            ditolak=lokasiDitolak, perbarui=perbaruiLokasi, bukaIzin=bukaIzin)
          Isian(label=t("lapor.deskripsi"), petunjuk=t("lapor.deskripsiPetunjuk"))
            textarea value=deskripsi input=ubahDeskripsi rows=5 maxlength=5000 aria-label=t("lapor.deskripsi")
              placeholder=t("lapor.contohDeskripsi")
              testId="deskripsi" border="none" outline="none" margin="-6px -16px" padding="6px 16px" background-color="transparent" font-size=14.5 line-height=1.45
              color="teks.utama"
          // Lampiran: kisi tiga kolom, lalu kotak unggah bergaris putus-putus: Ambil foto membuka kamera, GALERI galeri HP.
          if pilihan.length > 0
            row flex-wrap="wrap" gap=8 testId="lampiran"
              for id, i in pilihan key=id
                box position="relative" width="calc((100% - 16px) / 3)" aspect-ratio="1 / 1" border-radius=14
                  overflow="hidden" border="1px solid garis.tipis" background-color="latar.redup"
                  image (match gambarFoto.at(i) { case some(g) => g, case none => "" }) alt=t("lapor.lampiran", n=i + 1)
                    width="100%" height="100%" object-fit="cover"
                  button press=hapusFoto(id) aria-label=t("lapor.hapusLampiran", n=i + 1) testId=`hapus-${i + 1}` position="absolute"
                    top=6 right=6 width=28 height=28 border-radius=14 display="flex" align-items="center"
                    justify-content="center" background-color="media.kaca" color="media.teks" font-size=12 padding=0
                    image "symbol:close"
          row min-height=70 border-radius=16 border="1px dashed garis.tegas" align-items="stretch" testId="kotak-unggah"
            button press=bukaKamera testId="ambil-foto" flex=1 display="flex" align-items="center" gap=14
              padding="12px 16px" background-color="transparent" color="teks.utama" text-align="left" font-size=21
              image "symbol:camera"
              column gap=3 flex=1 min-width=0
                text (pilihan.length == 0 ? t("lapor.ambilFoto") : t("lapor.tambahFoto")) font-size=14 font-weight=700
                text (menyalin ? t("lapor.menyiapkanFoto") : pilihan.length == 0 ? t("lapor.maksBerkas") : t("lapor.jumlahBerkas", n=pilihan.length))
                  font-size=10.5 font-weight=500 letter-spacing=0.4 color="teks.redup"
            box width=1 margin="12px 0" background-color="garis.tipis"
            button press=bukaGaleri testId="buka-galeri" width=70 display="flex" flex-direction="column" align-items="center"
              justify-content="center" gap=4 background-color="transparent" color="teks.utama" font-size=20
              image "symbol:icon.gambar"
              text t("lapor.galeri") font-size=10 font-weight=600 letter-spacing=0.6
          row gap=10 padding=14 border-radius=16 background-color="status.peringatan-lembut"
            border="1px solid status.peringatan-garis" align-items="flex-start" color="status.peringatan" font-size=18
            image "symbol:icon.awas"
            text t("lapor.keselamatan") markup="markdown"
              font-size=12 line-height=1.5 flex=1 min-width=0
          row gap=12 padding="12px 16px" border-radius=16 border="1px solid garis.tipis" background-color="latar.permukaan"
            align-items="center" font-size=18
            image "symbol:icon.anonim"
            column flex=1 min-width=0 gap=2
              text t("lapor.anonim") font-size=14 font-weight=700
              text (anonim ? (akun != "" ? t("lapor.anonimAkun") : t("lapor.namaTersembunyi")) : akun != "" ? t("lapor.sebagai", nama=akun) : t("lapor.namaTersembunyi"))
                font-size=12 color="teks.redup"
            input type="checkbox" switch checked=anonim change=ubahAnonim aria-label=t("lapor.anonim") testId="anonim"
          if not anonim and akun == ""
            Isian(label=t("lapor.namaOpsional"), petunjuk="")
              input value=nama input=ubahNama placeholder=t("lapor.namaPelapor") aria-label=t("lapor.namaPelapor") maxlength=100
                testId="nama" border="none" outline="none" margin="-6px -16px" padding="6px 16px" background-color="transparent" font-size=15 font-weight=500 color="teks.utama"
          text t("lapor.ketentuan") markup="markdown" font-size=12 line-height=1.42
            color="teks.redup" text-align="center"
      column padding="12px 20px calc(env(safe-area-inset-bottom) + 14px)" gap=9 background-color="latar.halaman"
        if galat != ""
          row gap=8 padding=12 border-radius=16 border="1px solid status.bahaya" color="status.bahaya" font-size=17
            align-items="center"
            image "symbol:alert"
            text galat font-size=13 line-height=1.38 font-weight=500 flex=1 min-width=0 testId="galat"
        button press=kirim disabled=mengirim testId="kirim" height=56 border-radius=28 display="flex"
          align-items="center" justify-content="center" background-color="aksen.isi" color="aksen.di"
          text (mengirim ? t("lapor.mengirimKapital") : t("lapor.kirim")) font-size=16 font-weight=700 letter-spacing=0.5

component HalamanTerkirim
  props
    masuk: bool
    keBeranda: action
    keProfil: action
  view
    column padding="40px 20px 40px" gap=16
      text t("terkirim.alis") font-size=11 font-weight=600 letter-spacing=0.8 color="aksen.teks"
      column
        text t("terkirim.judul1") font-size=38 line-height=1.21 font-weight=700 letter-spacing=-0.4
        text t("terkirim.judul2") font-size=38 line-height=1.21 font-weight=700 letter-spacing=-0.4
        text t("terkirim.judul3") font-size=38 line-height=1.21 font-weight=700 letter-spacing=-0.4 color="aksen.teks"
      text (masuk ? t("terkirim.pesanAkun") : t("terkirim.pesanTamu"))
        font-size=15 line-height=1.47 max-width=340 testId="terima-kasih"
      column border-top="1px solid garis.tipis"
        Langkah(judul=t("terkirim.diterima"), status=t("waktu.baruSaja").toUpperCase(), selesai=true)
        Langkah(judul=t("terkirim.verifikasi"), status=t("terkirim.menunggu"), selesai=false)
        Langkah(judul=t("terkirim.tayang"), status=t("terkirim.bilaDisetujui"), selesai=false)
      row gap=10 margin-top=8
        if masuk
          button press=keProfil testId="pantau-status" flex=1 height=52 border-radius=26 border="1px solid garis.tegas"
            display="flex" align-items="center" justify-content="center"
            text t("terkirim.pantau") font-size=15 font-weight=700
        button press=keBeranda testId="ke-beranda" flex=1 height=52 border-radius=26 background-color="chip.aktif"
          color="chip.di-aktif" display="flex" align-items="center" justify-content="center"
          text t("terkirim.keBeranda") font-size=15 font-weight=700

component Langkah
  props
    judul: string
    status: string
    selesai: bool
  view
    row min-height=54 align-items="center" gap=12 border-bottom="1px solid garis.tipis"
      // Selesai: cincin aksen 6 px berpusat warna teks; menunggu: cincin tipis.
      box width=20 height=20 border-radius=10 flex-shrink=0 display="flex" align-items="center" justify-content="center"
        background-color=(selesai ? "aksen.isi" : "transparent") border=(selesai ? "none" : "2px solid garis.tegas")
        if selesai
          box width=8 height=8 border-radius=4 background-color="teks.utama"
      text judul font-size=15 font-weight=700 flex=1
      text status font-size=10.5 font-weight=600 letter-spacing=0.6 color=(selesai ? "aksen.teks" : "teks.redup")

// TombolIkon kecil laporin-apps: lingkaran 34 px bergaris, ikon 17 px.
component TombolKecil
  props
    ikon: string
    label: string
    tekan: action
    uji: string
  view
    button press=tekan aria-label=label testId=uji width=34 height=34 border-radius=17 border="1px solid garis.tipis"
      display="flex" align-items="center" justify-content="center" font-size=17 color="teks.utama" padding=0
      background-color="transparent" flex-shrink=0
      image ikon

// KartuLokasi laporin-apps: titik GPS dari @exact/geolocation saat formulir dibuka.
component KartuLokasi
  props
    ada: bool
    lat: number
    lng: number
    akurasi: number
    mencari: bool
    gagal: bool
    ditolak: bool
    perbarui: action
    bukaIzin: action
  view
    column padding="13px 16px" gap=8 border-radius=16 border="1px solid garis.tipis" background-color="latar.permukaan"
      testId="kartu-lokasi"
      row align-items="center" gap=8
        box width=14 height=14 border-radius=7 display="flex" align-items="center" justify-content="center"
          background-color="aksen.lembut"
          box width=7 height=7 border-radius=4 background-color="aksen.isi"
        text t("lokasi.judul") font-size=10.5 font-weight=600 letter-spacing=0.6 color="teks.redup"
      if ada
        row align-items="center" gap=8
          text `${lat.toFixed(6)}, ${lng.toFixed(6)}` font-size=14 font-weight=600 flex=1 min-width=0 testId="koordinat"
          button press=perbarui testId="ubah-lokasi" padding=0 background-color="transparent" color="aksen.teks"
            text t("lokasi.ubah") font-size=11 font-weight=600 letter-spacing=0.6
        text t("lokasi.akurasi", akurasi=round(akurasi)) font-size=10.5 line-height=1.43 font-weight=500
          letter-spacing=0.4 color="teks.redup"
      else if mencari
        row align-items="center" gap=8
          progress aria-label=t("lokasi.mencari")
          text t("lokasi.mencariTitik") font-size=13 color="teks.redup"
      else
        row align-items="center" gap=8 font-size=16 color="status.peringatan"
          image "symbol:icon.awas"
          // Seperti kartu-lokasi aslinya: izin ditolak = buka Pengaturan HP (dialog izin tidak muncul lagi); selain itu
          // GPS mati atau sinyal lemah = coba lagi.
          text (ditolak ? t("lokasi.ditolak") : gagal ? t("lokasi.gagal") : t("lokasi.belum")) font-size=13
            flex=1 min-width=0 color="teks.utama"
          if ditolak
            button press=bukaIzin testId="izin-lokasi" padding=0 background-color="transparent" color="aksen.teks"
              text t("lokasi.bukaPengaturan") font-size=13 font-weight=700
          else
            button press=perbarui testId="coba-lokasi" padding=0 background-color="transparent" color="aksen.teks"
              text t("umum.cobaLagi") font-size=13 font-weight=700

// Kamera Lapor seperti layar kamera aslinya: jendela bidik penuh, kepala (tutup · LAPORAN BARU), bingkai bidik bersudut
// dengan pesan keselamatan, lampu dan balik kamera di kanan, lalu baris rana: foto terakhir (atau unggah dari galeri),
// rana, Selesai. Mode video dan Live belum ada: hanya FOTO.
component HalamanKamera
  props
    track: string
    status: CameraStatus
    membuka: bool
    galatBuka: string
    galatJepret: string
    jumlah: number
    terakhir: string
    menjepret: bool
    lampu: bool
    bisaBalik: bool
    jepret: action
    balik: action
    gantiLampu: action
    tutup: action
    keGaleri: action
    bukaIzin: action
    // Mode KTP (verifikasi): bingkai kartu, tanpa galeri dan hitungan, lalu foto diperiksa dulu (Ulangi / Pakai).
    ktp: bool
    fotoKtp: string
    ulangi: action
    pakai: action
  derive ditolak = status.state == "denied" or galatBuka == "NotAllowedError"
  view
    column flex=1 min-height=0 position="relative" background-color="media.tinta" color="media.teks"
      // Pratinjau kamera 3:4 digambar utuh (object-fit belum sampai ke view native Android): dibuat setinggi layar
      // dan selebar 3/4 tingginya, di tengah, sisi yang berlebih terpotong — sama dengan `cover`.
      if track != ""
        row position="absolute" inset=0 justify-content="center" overflow="hidden"
          exact-camera srcObject=track object-fit="cover" height="100%" aspect-ratio="3 / 4" flex-shrink=0
            aria-label=t("kamera.jendela") testId="jendela-bidik"
        // Bayangan atas dan bawah supaya kepala dan baris rana terbaca di atas pemandangan terang.
        box position="absolute" top=0 left=0 right=0 height=140
          background-image="linear-gradient(180deg, media.redam 0%, transparent 100%)"
        box position="absolute" bottom=0 left=0 right=0 height=280
          background-image="linear-gradient(0deg, media.kaca 0%, transparent 100%)"
      if ditolak or galatBuka != ""
        column position="absolute" inset=0 align-items="center" justify-content="center" gap=16 padding="0 36px"
          box font-size=30
            image "symbol:camera"
          text (ditolak ? t("kamera.ditolak") : t("kamera.galatBuka", kode=galatBuka))
            font-size=13.5 line-height=1.48 text-align="center" testId="kamera-galat"
          if ditolak
            button press=bukaIzin testId="kamera-izin" height=44 padding="0 20px" border-radius=22
              background-color="media.teks" color="media.tinta" display="flex" align-items="center"
              text t("kamera.bukaPengaturan") font-size=14 font-weight=700
      else if track == "" or membuka
        column position="absolute" inset=0 align-items="center" justify-content="center"
          progress aria-label=t("kamera.membuka")
      else if ktp
        column position="absolute" left=0 right=0 top="22%" align-items="center" gap=14 padding="0 7%"
          box width="100%" aspect-ratio="85.6 / 54" border-radius=16 border="2px solid media.teks"
            testId="bingkai-ktp"
          column align-items="center" gap=4 padding="8px 14px" border-radius=14 background-color="media.kaca"
            text t("kamera.ktpPas") font-size=15 font-weight=700 text-align="center"
            text t("kamera.ktpSudut") font-size=12 line-height=1.45 text-align="center"
      else
        column position="absolute" left=0 right=0 top="24%" align-items="center" gap=16
          box position="relative" width=230 height=230
            box position="absolute" top=0 left=0 width=28 height=28 border-top="2px solid media.teks"
              border-left="2px solid media.teks"
            box position="absolute" top=0 right=0 width=28 height=28 border-top="2px solid media.teks"
              border-right="2px solid media.teks"
            box position="absolute" bottom=0 left=0 width=28 height=28 border-bottom="2px solid media.teks"
              border-left="2px solid media.teks"
            box position="absolute" bottom=0 right=0 width=28 height=28 border-bottom="2px solid media.teks"
              border-right="2px solid media.teks"
            box position="absolute" top=114 left=105 width=20 height=2 background-color="media.redup"
            box position="absolute" top=105 left=114 width=2 height=20 background-color="media.redup"
          text t("kamera.jagaJarak") font-size=12 line-height=1.45
            text-align="center" max-width=250 padding="6px 12px" border-radius=12 background-color="media.kaca"
      row position="absolute" top=8 left=16 right=16 align-items="center" justify-content="space-between"
        button press=tutup aria-label=t("kamera.tutup") testId="tutup-kamera" width=44 height=44 border-radius=22
          padding=0 display="flex" align-items="center" justify-content="center" background-color="media.kaca"
          color="media.teks" font-size=19
          image "symbol:close"
        text (ktp ? t("kamera.fotoKtp").toUpperCase() : t("kamera.laporanBaru")) font-size=12 font-weight=700 letter-spacing=1.4
        box width=44 height=44
      column position="absolute" right=14 top="40%" gap=16 align-items="center"
        TombolAlat(ikon="symbol:icon.lampu", label=t("kamera.lampu"), aktif=lampu, tekan=gantiLampu, uji="kamera-lampu")
        if bisaBalik
          TombolAlat(ikon="symbol:icon.balik", label=t("kamera.balik"), aktif=false, tekan=balik, uji="kamera-balik")
      column position="absolute" left=0 right=0 bottom=0 padding="0 28px calc(env(safe-area-inset-bottom) + 26px)" gap=16
        align-items="center"
        if galatJepret != ""
          text t("kamera.galatJepret", kode=galatJepret) font-size=12.5 padding="8px 14px" border-radius=14
            background-color="media.kaca" color="status.bahaya" testId="jepret-galat"
        else if jumlah >= 6 and not ktp
          text t("kamera.batas") font-size=12.5 padding="8px 14px" border-radius=14
            background-color="media.kaca"
        column align-items="center" gap=4
          text t("kamera.foto") font-size=12 font-weight=700 letter-spacing=1.2 color="aksen.isi"
          box width=5 height=5 border-radius=3 background-color="aksen.isi"
        row width="100%" align-items="center" justify-content="space-between"
          column width=72 align-items="center" gap=6
            if ktp
              box width=52 height=52
            else if jumlah > 0 and terakhir != ""
              button press=tutup aria-label=t("kamera.lihatBerkas") testId="kamera-terakhir" width=52 height=52
                border-radius=14 padding=0 overflow="hidden" position="relative" border="2px solid media.teks"
                background-color="media.kaca"
                image terakhir alt=t("kamera.fotoTerakhir") width="100%" height="100%" object-fit="cover"
                box position="absolute" top=3 right=3 min-width=18 height=18 border-radius=9 padding="0 4px"
                  display="flex" align-items="center" justify-content="center" background-color="aksen.isi"
                  color="aksen.di"
                  text `${jumlah}` font-size=10.5 font-weight=700
            else
              button press=keGaleri aria-label=t("kamera.unggahGaleri") testId="kamera-galeri" width=52 height=52
                border-radius=14 padding=0 display="flex" align-items="center" justify-content="center"
                background-color="media.kaca" color="media.teks" font-size=21
                image "symbol:icon.gambar"
              text t("kamera.unggah") font-size=10 font-weight=600 letter-spacing=0.6
          button press=jepret disabled=(track == "" or menjepret or (jumlah >= 6 and not ktp))
            aria-label=(ktp ? t("kamera.potretKtp") : t("kamera.ambilFoto")) testId="rana"
            width=80 height=80 min-width=80 min-height=80 flex-shrink=0 border-radius="50%" padding=5
            border="4px solid media.teks" background-color="transparent" display="flex" align-items="center"
            justify-content="center" opacity=(track == "" or (jumlah >= 6 and not ktp) ? 0.4 : 1)
            box width=62 height=62 border-radius="50%" background-color=(menjepret ? "media.redup" : "media.teks")
          column width=72 align-items="center"
            if not ktp
              button press=tutup testId="kamera-selesai" height=40 padding="0 16px" border-radius=20
                display="flex" align-items="center" background-color="media.teks" color="media.tinta"
                text t("umum.selesai") font-size=13 font-weight=700
      // Periksa foto KTP sebelum dipakai, seperti kamera-ktp aslinya.
      if ktp and fotoKtp != ""
        column position="absolute" inset=0 background-color="media.tinta" padding="calc(env(safe-area-inset-top) + 24px) 20px calc(env(safe-area-inset-bottom) + 24px)"
          gap=14 testId="periksa-ktp"
          text t("kamera.periksa") font-size=24 line-height=1.25 font-weight=700
          text t("kamera.periksaSub") font-size=14 line-height=1.45 color="media.samar"
          box flex=1 min-height=0 border-radius=18 overflow="hidden" background-color="media.kaca"
            image fotoKtp alt=t("kamera.fotoKtp") width="100%" height="100%" object-fit="contain"
          row gap=10
            button press=ulangi testId="ktp-ulangi" flex=1 height=52 border-radius=26 border="1px solid media.teks"
              background-color="transparent" color="media.teks" display="flex" align-items="center"
              justify-content="center" gap=8 font-size=17
              image "symbol:refresh"
              text t("kamera.ulangi") font-size=15 font-weight=700
            button press=pakai testId="ktp-pakai" flex=1 height=52 border-radius=26 background-color="aksen.isi"
              color="aksen.di" display="flex" align-items="center" justify-content="center" gap=8 font-size=17
              image "symbol:checkmark"
              text t("kamera.pakai") font-size=15 font-weight=700

component TombolAlat
  props
    ikon: string
    label: string
    aktif: bool
    tekan: action
    uji: string
  view
    column align-items="center" gap=5
      button press=tekan aria-label=label aria-pressed=aktif testId=uji width=46 height=46 border-radius=23 padding=0
        display="flex" align-items="center" justify-content="center" font-size=20
        background-color=(aktif ? "aksen.isi" : "media.kaca") color=(aktif ? "aksen.di" : "media.teks")
        image ikon
      text label font-size=9.5 font-weight=600 letter-spacing=0.6 padding="1px 6px" border-radius=6
        background-color="media.redam"

component HalamanGaleri
  props
    galeri: PhotoAssetList
    status: PhotoLibraryStatus
    memuat: bool
    pilihan: string[]
    menyalin: bool
    pilihFoto: action
    muatUlang: action
    kembali: action
    idIsi: string
  view
    column flex=1 min-height=0
      BilahAtas(judul=t("galeri.judul"), kembali=kembali)
      text (menyalin ? t("galeri.infoMenyiapkan", n=pilihan.length) : t("galeri.info", n=pilihan.length)) font-size=10.5
        font-weight=500 letter-spacing=0.4 color="teks.redup" padding="0 20px 10px"
      scroll id=idIsi flex=1 min-height=0 scrollbar-width="none"
        column padding="0 16px 32px"
          if status.state == "denied"
            Kosong(ikon="symbol:icon.gambar", pesan=t("galeri.ditolak"))
          else if galeri.assets.length == 0
            if memuat
              column padding=40 align-items="center" gap=14
                progress aria-label=t("galeri.memuat")
                button press=muatUlang testId="muat-galeri" height=36 padding="0 14px" border-radius=18
                  border="1px solid garis.tegas" display="flex" align-items="center" background-color="transparent"
                  text t("galeri.muatUlang") font-size=12 font-weight=600
            else
              Kosong(ikon="symbol:icon.gambar", pesan=t("galeri.kosong"))
          else
            row flex-wrap="wrap" gap=6 testId="galeri"
              for a, i in galeri.assets key=a.id
                button press=pilihFoto(a.id, a.picture) testId=`foto-${i + 1}` aria-label=t("galeri.foto", n=i + 1)
                  aria-pressed=pilihan.includes(a.id) width="calc((100% - 12px) / 3)" aspect-ratio="1 / 1" border-radius=14
                  overflow="hidden" position="relative" padding=0 background-color="latar.redup"
                  border=(pilihan.includes(a.id) ? "3px solid aksen.isi" : "1px solid garis.tipis")
                  image a.picture alt=t("galeri.foto", n=i + 1) width="100%" height="100%" object-fit="cover"
                  if pilihan.includes(a.id)
                    box position="absolute" top=6 right=6 width=24 height=24 border-radius=12 display="flex"
                      align-items="center" justify-content="center" background-color="aksen.isi" color="aksen.di"
                      text `${pilihan.indexOf(a.id) + 1}` font-size=12 font-weight=700
      column padding="12px 20px calc(env(safe-area-inset-bottom) + 14px)" background-color="latar.halaman"
        border-top="1px solid garis.tipis"
        button press=kembali testId="galeri-selesai" height=56 border-radius=28 display="flex" align-items="center"
          justify-content="center" background-color="chip.aktif" color="chip.di-aktif"
          text (pilihan.length == 0 ? t("umum.kembali") : t("galeri.pakai", n=pilihan.length)) font-size=16 font-weight=700

component HalamanKomentar
  props
    komentar: Komentar[]
    memuat: bool
    masuk: bool
    isi: string
    ubahIsi: action
    kirim: action
    mengirim: bool
    galat: string
    keProfil: action
    kembali: action
    idIsi: string
  view
    column flex=1 min-height=0 background-color="latar.permukaan"
      row padding="14px 16px 14px 20px" align-items="center" gap=8 border-bottom="1px solid garis.tipis"
        row flex=1 align-items="baseline" gap=8
          text t("umum.komentar") font-size=25 line-height=1.2 font-weight=700 role="heading" aria-level=1
          text komentar.length.toString() font-size=25 line-height=1.2 font-weight=700 color="aksen.teks"
        TombolBulat(ikon="symbol:close", label=t("umum.tutup"), tekan=kembali, uji="tutup-komentar")
      scroll id=idIsi flex=1 min-height=0 scrollbar-width="none"
        column padding="4px 16px 24px"
          if memuat and komentar.length == 0
            column padding=40 align-items="center"
              progress aria-label=t("komentar.memuat")
          else if komentar.length == 0
            text t("komentar.kosong") font-size=13.5 color="teks.redup" padding="40px 0" text-align="center"
              testId="tanpa-komentar"
          for k in komentar key=k.id
            row gap=10 align-items="flex-start" padding="14px 0" border-bottom="1px solid garis.tipis"
              box width=34 height=34 border-radius=17 display="flex" align-items="center" justify-content="center"
                background-color="avatar.isi" color="avatar.teks" flex-shrink=0
                text k.inisial font-size=12 font-weight=700
              column flex=1 min-width=0 gap=3
                row align-items="baseline" gap=8
                  text k.nama font-size=13 font-weight=700 line-clamp=1
                  text k.waktu.toUpperCase() font-size=10 font-weight=500 letter-spacing=0.4 color="teks.redup"
                text k.isi font-size=14 line-height=1.43
                if k.balasan > 0
                  text t("komentar.balasan", n=k.balasan) font-size=12 font-weight=600 color="teks.redup"
      column padding="12px 16px calc(env(safe-area-inset-bottom) + 12px)" gap=8 border-top="1px solid garis.tipis"
        if masuk
          row gap=8 align-items="center"
            column flex=1 min-width=0 min-height=48 padding="0 18px" border-radius=24 justify-content="center"
              background-color="latar.redup"
              input value=isi input=ubahIsi submit=kirim placeholder=t("komentar.petunjuk") maxlength=2000
                aria-label=t("komentar.tulis") testId="isi-komentar" border="none" outline="none" margin="0 -18px" padding="13px 18px" background-color="transparent" font-size=15
                color="teks.utama"
            button press=kirim disabled=mengirim aria-label=t("komentar.kirim") testId="kirim-komentar" width=48 height=48
              border-radius=24 display="flex" align-items="center" justify-content="center" background-color="aksen.isi"
              color="aksen.di" font-size=19 padding=0
              image "symbol:send"
          if galat != "" and not mengirim
            text galat font-size=12.5 color="status.bahaya"
        else
          button press=keProfil testId="masuk-komentar" min-height=48 border-radius=24 display="flex" align-items="center"
            justify-content="center" gap=8 background-color="latar.redup" color="teks.utama" font-size=17
            image "symbol:icon.pengguna"
            text t("komentar.masuk") font-size=14 font-weight=600

component HalamanFoto
  props
    gambar: string
    video: string
    kembali: action
  view
    column flex=1 min-height=0 position="relative" background-color="media.tinta"
      if video != ""
        column flex=1 min-height=0 position="relative" padding-bottom="env(safe-area-inset-bottom)"
          PemutarVideo(sumber=video, sampul=gambar, aktif=true, bisu=false, pas="contain", adaSebelum=false,
            adaSesudah=false, sebelum=kembali, sesudah=kembali)
      else
        image gambar alt=t("foto.laporan") flex=1 min-height=0 width="100%" object-fit="contain"
      button press=kembali aria-label=t("foto.tutup") testId="tutup-foto" position="absolute" top=8 right=12
        width=44 height=44 border-radius=22 display="flex" align-items="center" justify-content="center"
        background-color="media.kaca" color="media.teks" font-size=19 padding=0
        image "symbol:close"

component HalamanLaporkan
  props
    judul: string
    alasan: string
    pilihAlasan: action
    catatan: string
    ubahCatatan: action
    kirim: action
    mengirim: bool
    selesai: bool
    galat: string
    tutup: action
    idIsi: string
  derive judulAlasan = alasan == "palsu" ? t("alasan.palsu") : alasan == "tidak-pantas" ? t("alasan.tidakPantas") : alasan == "kebencian" ? t("alasan.kebencian") : alasan == "spam" ? t("alasan.spam") : alasan == "bahaya" ? t("alasan.bahaya") : t("alasan.lainnya")
  view
    column flex=1 min-height=0 background-color="latar.permukaan"
      row padding="14px 16px 6px 20px" align-items="center"
        text t("laporkan.alis") font-size=11 font-weight=600 letter-spacing=0.9 color="teks.redup" flex=1
        TombolBulat(ikon="symbol:close", label=t("umum.tutup"), tekan=tutup, uji="tutup-laporkan")
      if selesai
        column padding="12px 20px" gap=14 flex=1
          text t("terkirim.alis") font-size=11 font-weight=600 letter-spacing=0.8 color="aksen.teks"
          column
            text t("live.selesai.terima1") font-size=40 line-height=1.22 font-weight=700 letter-spacing=-0.4
            text t("live.selesai.terima2") font-size=40 line-height=1.22 font-weight=700 letter-spacing=-0.4
          text t("laporkan.selesai", alasan=judulAlasan)
            font-size=14 line-height=1.45 color="teks.redup" testId="laporkan-selesai"
          button press=tutup testId="laporkan-tutup" height=56 border-radius=28 margin-top=8 display="flex"
            align-items="center" justify-content="center" background-color="chip.aktif" color="chip.di-aktif"
            text t("umum.selesai") font-size=16 font-weight=700
      else
        scroll id=idIsi flex=1 min-height=0 scrollbar-width="none"
          column padding="6px 20px 24px" gap=14
            column
              text t("laporkan.judul1") font-size=32 line-height=1.22 font-weight=700 letter-spacing=-0.4
              text t("laporkan.judul2") font-size=32 line-height=1.22 font-weight=700 letter-spacing=-0.4 color="aksen.teks"
            text t("laporkan.sub") font-size=14
              line-height=1.43 color="teks.redup"
            if judul != ""
              text `“${judul}”` font-size=13.5 line-height=1.4 color="teks.redup" line-clamp=2
            column border-top="1px solid garis.tipis" role="radiogroup" aria-label=t("laporkan.alasan")
              for a, i in ["palsu", "tidak-pantas", "kebencian", "spam", "bahaya", "lainnya"] key=a
                button press=pilihAlasan(a) role="radio" aria-checked=(alasan == a) testId=`alasan-${a}` min-height=58
                  display="flex" align-items="center" gap=10 padding=0 border-bottom="1px solid garis.tipis"
                  background-color="transparent" color="teks.utama" text-align="left"
                  text `0${i + 1}` font-size=11 font-weight=500 width=22 color=(alasan == a ? "aksen.teks" : "teks.redup")
                  column flex=1 min-width=0 gap=1
                    text (a == "palsu" ? t("alasan.palsu") : a == "tidak-pantas" ? t("alasan.tidakPantas") : a == "kebencian" ? t("alasan.kebencian") : a == "spam" ? t("alasan.spam") : a == "bahaya" ? t("alasan.bahaya") : t("alasan.lainnya")) font-size=15 font-weight=700
                    text (a == "palsu" ? t("alasan.palsuPetunjuk") : a == "tidak-pantas" ? t("alasan.tidakPantasPetunjuk") : a == "kebencian" ? t("alasan.kebencianPetunjuk") : a == "spam" ? t("alasan.spamPetunjuk") : a == "bahaya" ? t("alasan.bahayaPetunjuk") : t("alasan.lainnyaPetunjuk")) font-size=12 color="teks.redup"
                  box width=20 height=20 border-radius=10 flex-shrink=0 display="flex" align-items="center"
                    justify-content="center" background-color=(alasan == a ? "aksen.isi" : "transparent")
                    border=(alasan == a ? "none" : "2px solid garis.tegas")
                    if alasan == a
                      box width=8 height=8 border-radius=4 background-color="media.teks"
            column min-height=72 padding="12px 16px" border-radius=16 background-color="latar.redup"
              textarea value=catatan input=ubahCatatan rows=3 maxlength=500 aria-label=t("laporkan.rincian")
                placeholder=t("laporkan.rincianPetunjuk") testId="catatan-laporkan" border="none" outline="none"
                background-color="transparent" font-size=14 color="teks.utama"
            if galat != "" and not mengirim
              text galat font-size=13 color="status.bahaya"
        column padding="12px 20px calc(env(safe-area-inset-bottom) + 14px)" border-top="1px solid garis.tipis"
          button press=kirim disabled=(alasan == "" or mengirim) testId="kirim-laporkan" height=56 border-radius=28
            display="flex" align-items="center" justify-content="center" background-color="aksen.isi" color="aksen.di"
            opacity=(alasan == "" ? 0.45 : 1)
            text (mengirim ? t("lapor.mengirimKapital") : t("lapor.kirim")) font-size=16 font-weight=700 letter-spacing=0.5

// Verifikasi KTP laporin-apps (app/verifikasi.tsx): syarat siaran langsung. NIK dan foto KTP (kamera mode KTP), lalu
// status tinjauan petugas; foto dihapus server setelah diputuskan.
component HalamanVerifikasi
  props
    masuk: bool
    status: StatusKtp
    memuat: bool
    gagal: bool
    periksa: action
    nik: string
    ubahNik: action
    foto: string
    potret: action
    kirim: action
    mengirim: bool
    galat: string
    bidang: string
    dariLive: bool
    lanjut: action
    keProfil: action
    kembali: action
    idIsi: string
  derive formulir = masuk and (status.status == "belum" or status.status == "ditolak")
  view
    column flex=1 min-height=0
      BilahAtas(judul=t("ktp.judul"), kembali=kembali)
      scroll id=idIsi flex=1 min-height=0 scrollbar-width="none"
        column padding="12px 20px 120px" gap=14
          text t("ktp.syarat") font-size=11 font-weight=600 letter-spacing=0.8 color="teks.redup"
          column margin-top=-2
            text t("ktp.judul1") font-size=31 line-height=1.23 font-weight=700 letter-spacing=-0.4
            text t("ktp.judul2") font-size=31 line-height=1.23 font-weight=700 letter-spacing=-0.4 color="aksen.teks"
          text t("ktp.pembuka")
            font-size=14 line-height=1.5 color="teks.redup"
          if not masuk
            column padding=18 gap=6 border-radius=20 border="1px solid garis.tipis" background-color="latar.permukaan"
              text t("perluMasuk.judul") font-size=16 font-weight=700
              text t("ktp.melekat") font-size=13.5 line-height=1.45 color="teks.redup"
              button press=keProfil testId="verifikasi-masuk" margin-top=8 height=46 border-radius=23
                background-color="chip.aktif" color="chip.di-aktif" display="flex" align-items="center"
                justify-content="center"
                text t("umum.masuk") font-size=14.5 font-weight=700
          else if status.status == ""
            column align-items="center" gap=12 padding="24px 0"
              if memuat or not gagal
                progress aria-label=t("ktp.memuat")
              else
                text t("ktp.gagalMuat") font-size=13.5 color="teks.redup"
                button press=periksa testId="verifikasi-coba-lagi" height=44 padding="0 20px" border-radius=22
                  border="1px solid garis.tegas" background-color="transparent" color="teks.utama"
                  text t("umum.cobaLagi") font-size=14 font-weight=700
          else if status.status == "menunggu"
            column padding=18 gap=8 border-radius=20 border="1px solid garis.tipis" background-color="latar.permukaan"
              testId="ktp-menunggu"
              row gap=8 align-items="center" font-size=18 color="aksen.teks"
                image "symbol:icon.jam"
                text t("ktp.status.menunggu") font-size=16 font-weight=700 color="teks.utama"
              text t("ktp.menungguSub") font-size=13.5 line-height=1.45
                color="teks.redup"
              button press=periksa disabled=memuat testId="ktp-periksa" margin-top=6 height=44 border-radius=22
                border="1px solid garis.tegas" background-color="transparent" color="teks.utama" display="flex"
                align-items="center" justify-content="center"
                if memuat
                  progress aria-label=t("ktp.memeriksa")
                else
                  text t("ktp.periksaLagi") font-size=14 font-weight=700
          else if status.status == "ditolak"
            column padding=18 gap=8 border-radius=20 border="1px solid status.bahaya" background-color="latar.permukaan"
              testId="ktp-ditolak"
              row gap=8 align-items="center" font-size=18 color="status.bahaya"
                image "symbol:icon.awas"
                text t("ktp.ditolak") font-size=16 font-weight=700 color="teks.utama"
              text t("ktp.ditolakAlasan", alasan=(status.alasan == "" ? t("ktp.belumBisa") : status.alasan))
                font-size=13.5 line-height=1.45 color="teks.redup"
          else if status.status == "disetujui"
            column padding=18 gap=8 border-radius=20 border="1px solid garis.tipis" background-color="latar.permukaan"
              testId="ktp-disetujui"
              row gap=8 align-items="center" font-size=18 color="aksen.teks"
                image "symbol:checkmark"
                text t("ktp.disetujui") font-size=16 font-weight=700 color="teks.utama"
              text t("ktp.disetujuiSub") font-size=13.5 line-height=1.45 color="teks.redup"
              button press=lanjut testId="ktp-lanjut" margin-top=6 height=46 border-radius=23 background-color="chip.aktif"
                color="chip.di-aktif" display="flex" align-items="center" justify-content="center" gap=8 font-size=17
                image "symbol:icon.siaran"
                text (dariLive ? t("ktp.lanjutSiaran") : t("siaran.mulai")) font-size=14.5 font-weight=700
          if formulir
            Isian(label="NIK", petunjuk=t("ktp.nikPetunjuk"))
              input value=nik input=ubahNik inputmode="numeric" maxlength=16 autocomplete="off" aria-label="NIK"
                testId="nik" disabled=mengirim border="none" outline="none" margin="-6px -16px" padding="6px 16px" background-color="transparent" font-size=15 font-weight=500
                color=(bidang == "nik" ? "status.bahaya" : "teks.utama")
            button press=potret disabled=mengirim testId="foto-ktp"
              aria-label=(foto == "" ? t("ktp.potret") : t("ktp.sudahDipotret"))
              position="relative" aspect-ratio="85.6 / 54" border-radius=20 overflow="hidden" padding=0
              border=(bidang == "ktp" ? "1.5px dashed status.bahaya" : "1.5px dashed garis.tegas")
              background-color="latar.permukaan" color="teks.utama" display="flex" flex-direction="column"
              align-items="center" justify-content="center" gap=6
              if foto == ""
                box font-size=24 color="teks.redup"
                  image "symbol:icon.kartu"
                text t("kamera.fotoKtp") font-size=15 font-weight=700
                text t("ktp.fotoPetunjuk") font-size=12 line-height=1.4
                  color="teks.redup" text-align="center" padding="0 24px"
              else
                image foto alt=t("kamera.fotoKtp") position="absolute" inset=0 width="100%" height="100%" object-fit="cover"
                row position="absolute" left=10 bottom=10 gap=5 padding="5px 9px" border-radius=10
                  background-color="media.kaca" color="media.teks" align-items="center" font-size=11
                  image "symbol:refresh"
                  text t("kamera.fotoKtp").toUpperCase() font-size=10.5 font-weight=700 letter-spacing=0.6
            row gap=10 padding=14 border-radius=16 border="1px solid garis.tipis" background-color="latar.permukaan"
              align-items="flex-start"
              box font-size=16 color="teks.redup" display="flex" margin-top=1
                image "symbol:lock"
              text t("ktp.privasi")
                markup="markdown" font-size=12.5 line-height=1.48 color="teks.redup" flex=1 min-width=0
            if galat != ""
              row gap=8 padding=12 border-radius=16 border="1px solid status.bahaya" align-items="flex-start"
                color="status.bahaya"
                box font-size=17 display="flex"
                  image "symbol:icon.awas"
                text galat font-size=13 line-height=1.38 font-weight=500 flex=1 min-width=0 testId="galat-ktp"
            button press=kirim disabled=mengirim testId="kirim-ktp" min-height=56 border-radius=28
              background-color="aksen.isi" color="aksen.di" display="flex" align-items="center"
              justify-content="center"
              if mengirim
                progress aria-label=t("ktp.mengirim")
              else
                text t("ktp.kirim") font-size=15 font-weight=700

component HalamanPengaturan
  props
    sesi: Sesi
    ktp: string
    verifikasi: action
    tema: string
    pilihTema: action
    bukaIzin: action
    bukaSitus: action
    keluar: action
    kembali: action
    idIsi: string
    hapusAkun: action
    menghapus: bool
    galatHapus: string
    gelap: bool
    notifLive: bool
    notifLaporan: bool
    izinNotif: string
    gantiNotif: action
    bukaIzinNotif: action
  view
    column flex=1 min-height=0
      BilahAtas(judul=t("pengaturan.judul"), kembali=kembali)
      scroll id=idIsi flex=1 min-height=0 scrollbar-width="none"
        column padding="8px 16px 120px"
          if sesi.masuk
            row padding=16 gap=13 border-radius=20 background-color="latar.permukaan" align-items="center"
              box width=50 height=50 border-radius=25 display="flex" align-items="center" justify-content="center"
                background-color="chip.aktif" color="chip.di-aktif" flex-shrink=0
                text sesi.inisial font-size=17 font-weight=700
              column flex=1 min-width=0 gap=2
                text sesi.nama font-size=18 line-height=1.22 font-weight=700
                text sesi.email font-size=13 color="teks.redup"
          LabelGrup(teks=(sesi.masuk ? t("pengaturan.akunPrivasi") : t("pengaturan.privasi")))
          column border-radius=20 background-color="latar.permukaan"
            BarisInfo(ikon="symbol:icon.anonim", judul=t("pengaturan.anonim"),
              sub=t("pengaturan.anonimSub"))
            box height=1 margin-left=62 background-color="garis.tipis"
            if sesi.masuk
              BarisTombol(ikon="symbol:icon.kartu", judul=t("ktp.judul"), sub=(ktp == "menunggu" ? t("ktp.status.menunggu") : ktp == "ditolak" ? t("ktp.ket.ditolak") : ktp == "disetujui" ? t("ktp.ket.disetujui") : t("ktp.ket.belum")), tekan=verifikasi,
                uji="buka-verifikasi")
              box height=1 margin-left=62 background-color="garis.tipis"
            BarisTombol(ikon="symbol:lock", judul=t("pengaturan.izin"), sub=t("pengaturan.izinSub"), tekan=bukaIzin,
              uji="izin-hp")
          LabelGrup(teks=t("notifikasi.judul"))
          column border-radius=20 background-color="latar.permukaan"
            BarisSakelarIkon(ikon="symbol:icon.siaran", judul=t("notifikasi.live"), sub=t("notifikasi.liveSub"),
              nyala=(notifLive and izinNotif == "diberi"), tekan=gantiNotif("live"), uji="notif-live")
            box height=1 margin-left=62 background-color="garis.tipis"
            BarisSakelarIkon(ikon="symbol:icon.lonceng", judul=t("notifikasi.laporan"), sub=t("notifikasi.laporanSub"),
              nyala=(notifLaporan and izinNotif == "diberi"), tekan=gantiNotif("laporan"), uji="notif-laporan")
            if izinNotif == "ditolak"
              box height=1 margin-left=62 background-color="garis.tipis"
              BarisTombol(ikon="symbol:icon.loncengMati", judul=t("notifikasi.diblokir"), sub=t("notifikasi.diblokirSub"),
                tekan=bukaIzinNotif, uji="notif-diblokir")
          // Tanpa Firebase tidak ada push dari server: HP sendiri yang memeriksa, jadi kabarnya bisa terlambat.
          text t("notifikasi.catatan") font-size=11.5 line-height=1.4 color="teks.redup" padding="8px 6px 0"
          // Selalu tampil (aslinya hanya selama tema dikunci, jadi barisnya hilang begitu diketuk).
          LabelGrup(teks=t("pengaturan.tampilan"))
          column border-radius=20 background-color="latar.permukaan" padding="12px 14px 14px" gap=12
            row align-items="center" gap=12
              box width=36 height=36 border-radius=18 display="flex" align-items="center" justify-content="center"
                background-color="latar.redup" font-size=18 flex-shrink=0
                image (gelap ? "symbol:moon" : "symbol:icon.matahari")
              column flex=1 min-width=0 gap=2
                text t("pengaturan.tema") font-size=14.5 font-weight=600
                text (tema == "gelap" ? t("pengaturan.temaGelap") : tema == "terang" ? t("pengaturan.temaTerang") : t("pengaturan.temaIkut"))
                  font-size=12.5 line-height=1.36 color="teks.redup"
            row role="radiogroup" aria-label=t("pengaturan.tema") gap=4 padding=4 border-radius=22 background-color="latar.redup"
              PilihTema(label=t("pengaturan.ikutiHp"), aktif=(tema == ""), tekan=pilihTema(""), uji="tema-hp")
              PilihTema(label=t("pengaturan.terang"), aktif=(tema == "terang"), tekan=pilihTema("terang"), uji="tema-terang")
              PilihTema(label=t("pengaturan.gelap"), aktif=(tema == "gelap"), tekan=pilihTema("gelap"), uji="tema-gelap")
          LabelGrup(teks=t("pengaturan.bantuan"))
          column border-radius=20 background-color="latar.permukaan"
            BarisTombol(ikon="symbol:link", judul="fire.nusantara.earth", sub=t("pengaturan.bukaSitus"), tekan=bukaSitus,
              uji="buka-situs")
          if sesi.masuk
            button press=keluar disabled=menghapus testId="keluar" margin-top=24 height=52 border-radius=26
              border="1px solid garis.tegas" display="flex" align-items="center" justify-content="center" gap=8
              background-color="transparent" color="aksen.teks" font-size=17
              image "symbol:sign-out"
              text t("pengaturan.keluar") font-size=15 font-weight=700
            // Hapus akun: teks redup di bawah Keluar, seperti aslinya; konfirmasinya dialog di root.
            button press=hapusAkun disabled=menghapus testId="hapus-akun" margin-top=8 height=44 padding="0 16px"
              border="none" display="flex" align-items="center" justify-content="center" gap=8
              background-color="transparent" color="teks.redup" aria-busy=menghapus
              if menghapus
                progress aria-label=t("hapusAkun.menghapus")
                text t("hapusAkun.menghapus") font-size=13.5 font-weight=600
              else
                text t("hapusAkun.tombol") font-size=13.5 font-weight=600
            if galatHapus != ""
              text galatHapus font-size=12.5 line-height=1.4 color="status.bahaya" text-align="center" padding="2px 12px 0"
                testId="hapus-akun-galat"
          text t("pengaturan.versi") font-size=10.5 font-weight=500 color="teks.redup" text-align="center"
            margin-top=28

// Baris Pengaturan dengan ikon dan sakelar (Notifikasi), sejajar dengan BarisTombol; sakelarnya seperti BarisSakelar.
component BarisSakelarIkon
  props
    ikon: string
    judul: string
    sub: string
    nyala: bool
    tekan: action
    uji: string
  view
    button press=tekan testId=uji role="switch" aria-checked=nyala aria-label=judul display="flex" align-items="center" gap=12
      padding="12px 14px" background-color="transparent" color="teks.utama" text-align="left"
      box width=36 height=36 border-radius=18 display="flex" align-items="center" justify-content="center"
        background-color="latar.redup" font-size=18 flex-shrink=0
        image ikon
      column flex=1 min-width=0 gap=2
        text judul font-size=14.5 font-weight=600
        text sub font-size=12.5 line-height=1.36 color="teks.redup"
      row width=40 height=22 border-radius=14 padding=3 flex-shrink=0 background-color=(nyala ? "aksen.isi" : "garis.tegas")
        align-items="center" justify-content=(nyala ? "flex-end" : "flex-start")
        box width=22 height=22 border-radius=11 background-color="media.teks"

// Satu pilihan pemilih tema Pengaturan, seperti chip aktif aplikasi.
component PilihTema
  props
    label: string
    aktif: bool
    tekan: action
    uji: string
  view
    button press=tekan role="radio" aria-checked=aktif testId=uji flex=1 min-width=0 height=36 padding=0 border="none"
      border-radius=18 background-color=(aktif ? "chip.aktif" : "transparent") color=(aktif ? "chip.di-aktif" : "teks.utama")
      display="flex" align-items="center" justify-content="center"
      text label font-size=13 font-weight=600

component LabelGrup
  props
    teks: string
  view
    text teks.toUpperCase() font-size=11 font-weight=600 letter-spacing=0.8 color="teks.redup" padding="18px 4px 9px"

component BarisInfo
  props
    ikon: string
    judul: string
    sub: string
  view
    row padding="12px 14px" gap=12 align-items="center"
      box width=36 height=36 border-radius=18 display="flex" align-items="center" justify-content="center"
        background-color="latar.redup" font-size=18 flex-shrink=0
        image ikon
      column flex=1 min-width=0 gap=2
        text judul font-size=14.5 font-weight=600
        text sub font-size=12.5 line-height=1.36 color="teks.redup"

component BarisTombol
  props
    ikon: string
    judul: string
    sub: string
    tekan: action
    uji: string
  view
    button press=tekan testId=uji display="flex" align-items="center" gap=12 padding="12px 14px" background-color="transparent"
      color="teks.utama" text-align="left"
      box width=36 height=36 border-radius=18 display="flex" align-items="center" justify-content="center"
        background-color="latar.redup" font-size=18 flex-shrink=0
        image ikon
      column flex=1 min-width=0 gap=2
        text judul font-size=14.5 font-weight=600
        text sub font-size=12.5 line-height=1.36 color="teks.redup"
      box font-size=18 color="teks.redup"
        image "symbol:forward-chevron"
