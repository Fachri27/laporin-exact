tamber laporin

// Bahasa rupa SAKSI dari laporin-apps (src/constants/theme.ts): tinta #0C0E0D, tulang #EDE8DF,
// sinyal #FF4A1C. Mode gelap adalah rancangan aslinya; mode terang kebalikannya. Teks di atas
// sinyal selalu tinta, tidak pernah putih.
theme
  latar.halaman = light-dark(#EDE8DF, #0C0E0D)
  latar.permukaan = light-dark(#E2DDD4, #1A1B1A)
  latar.redup = light-dark(#D9D4CC, #232422)
  garis.tipis = light-dark(#CAC5BC, #30312F)
  garis.tegas = light-dark(#A9A69F, #4F4F4C)
  teks.utama = light-dark(#0C0E0D, #EDE8DF)
  teks.redup = light-dark(#5E5E5A, #979590)
  aksen.isi = #FF4A1C  scheme=fixed
  aksen.teks = light-dark(#B02C08, #FF4A1C)
  aksen.lembut = light-dark(rgba(255, 74, 28, 0.12), rgba(255, 74, 28, 0.16))
  aksen.di = #0C0E0D  scheme=fixed
  bilah.isi = light-dark(#0C0E0D, #EDE8DF)
  bilah.ikon = light-dark(#EDE8DF, #0C0E0D)
  chip.aktif = light-dark(#0C0E0D, #EDE8DF)
  chip.di-aktif = light-dark(#EDE8DF, #0C0E0D)
  status.bahaya = light-dark(#B3261E, #FF7A57)
  status.peringatan = light-dark(#8A5A00, #E8BD55)
  status.peringatan-lembut = light-dark(rgba(176, 120, 0, 0.12), rgba(232, 189, 85, 0.12))
  status.peringatan-garis = light-dark(rgba(138, 90, 0, 0.18), rgba(232, 189, 85, 0.18))
  status.sukses = light-dark(#1E6B43, #7FD6A0)
  media.kartu = #161817  scheme=fixed
  media.kaca = rgba(12, 14, 13, 0.86)  scheme=fixed
  media.pita = rgba(12, 14, 13, 0.93)  scheme=fixed
  media.teks = #EDE8DF  scheme=fixed
  media.redup = rgba(237, 232, 223, 0.75)  scheme=fixed
  media.tinta = #0C0E0D  scheme=fixed
  media.garis = rgba(237, 232, 223, 0.25)  scheme=fixed
  media.redam = rgba(12, 14, 13, 0.5)  scheme=fixed
  // Layar siaran (interaksi-live.tsx laporin-apps): selubung kepala & kaki, lembar gelap, nama warga, sinyal.
  media.kepala = rgba(12, 14, 13, 0.55)  scheme=fixed
  media.bayang = rgba(12, 14, 13, 0.8)  scheme=fixed
  media.selubung = rgba(12, 14, 13, 0.6)  scheme=fixed
  media.lembar = rgba(12, 14, 13, 0.92)  scheme=fixed
  media.garis-lembar = rgba(237, 232, 223, 0.16)  scheme=fixed
  media.samar = rgba(237, 232, 223, 0.62)  scheme=fixed
  media.warga = rgba(237, 232, 223, 0.7)  scheme=fixed
  media.mati = rgba(237, 232, 223, 0.5)  scheme=fixed
  media.avatar = rgba(237, 232, 223, 0.2)  scheme=fixed
  media.hijau = #7FD6A0  scheme=fixed
  merek.oranye = #F98006  scheme=fixed
  media.kuning = #E8BD55  scheme=fixed
  media.oranye = #FF8A3D  scheme=fixed
  latar.tirai = rgba(0, 0, 0, 0.6)  scheme=fixed
  // Palet asap Aerosol Karhutla (palet-asap.ts laporin-apps): ikon legenda dan pita gradiennya.
  palet.firewatch = light-dark(#A21CAF, #E879F9)
  palet.bara = light-dark(#B45309, #FBBF24)
  palet.spektrum = light-dark(#0369A1, #38BDF8)
  palet.fw-0 = rgba(255, 247, 243, 0.2)  scheme=fixed
  palet.fw-1 = #FDE1DE  scheme=fixed
  palet.fw-2 = #FCC7C3  scheme=fixed
  palet.fw-3 = #FAA3B6  scheme=fixed
  palet.fw-4 = #F872A4  scheme=fixed
  palet.fw-5 = #E23E99  scheme=fixed
  palet.fw-6 = #B90D84  scheme=fixed
  palet.fw-7 = #91017A  scheme=fixed
  palet.fw-8 = #680172  scheme=fixed
  palet.fw-9 = #49006A  scheme=fixed
  palet.bara-0 = #FFF7EE  scheme=fixed
  palet.bara-1 = #FFAA26  scheme=fixed
  palet.bara-2 = #F57D00  scheme=fixed
  palet.bara-3 = #E65200  scheme=fixed
  palet.bara-4 = #BF360C  scheme=fixed
  palet.spektrum-0 = #0055FF  scheme=fixed
  palet.spektrum-1 = #00E5FF  scheme=fixed
  palet.spektrum-2 = #1AFF1A  scheme=fixed
  palet.spektrum-3 = #FFFF00  scheme=fixed
  palet.spektrum-4 = #FF3300  scheme=fixed
  palet.spektrum-5 = #80001A  scheme=fixed
  // Skala AQI (US EPA) di legenda Angin dan Kualitas Udara.
  aqi.baik = #00E400  scheme=fixed
  aqi.sedang = #FFFF00  scheme=fixed
  aqi.sensitif = #FF7E00  scheme=fixed
  aqi.buruk = #FF0000  scheme=fixed
  aqi.parah = #8F3F97  scheme=fixed
  aqi.bahaya = #7E0023  scheme=fixed
  avatar.isi = light-dark(rgba(12, 14, 13, 0.12), rgba(237, 232, 223, 0.2))
  avatar.teks = light-dark(#0C0E0D, #EDE8DF)
  bayangan.bilah = rgba(0, 0, 0, 0.35)  scheme=fixed
  bayangan.kartu = rgba(0, 0, 0, 0.18)  scheme=fixed
  // Tingkat kepercayaan hotspot (SiPongi): sama di kedua mode, seperti legenda petanya.
  kepercayaan.tinggi = #F01E1E  scheme=fixed
  kepercayaan.sedang = #FBC02D  scheme=fixed
  kepercayaan.rendah = #4CAF50  scheme=fixed

// Ikon Feather yang tidak ada di simbol bawaan Exact (garis 2 px, satu warna).
icons
  icon.peta = icon(sf "map", svg "icons/peta.svg")
  icon.siaran = icon(sf "dot.radiowaves.left.and.right", svg "icons/siaran.svg")
  icon.mata = icon(sf "eye", svg "icons/mata.svg")
  icon.titik = icon(sf "mappin", svg "icons/titik.svg")
  icon.bawah = icon(sf "chevron.down", svg "icons/bawah.svg")
  icon.luring = icon(sf "wifi.slash", svg "icons/luring.svg")
  icon.awas = icon(sf "exclamationmark.triangle", svg "icons/awas.svg")
  icon.anonim = icon(sf "eye.slash", svg "icons/anonim.svg")
  icon.api = icon(sf "flame", svg "icons/api.svg")
  icon.pengguna = icon(sf "person", svg "icons/pengguna.svg")
  icon.salin = icon(sf "square.on.square", svg "icons/salin.svg")
  icon.matahari = icon(sf "sun.max", svg "icons/matahari.svg")
  icon.atur = icon(sf "gearshape", svg "icons/atur.svg")
  icon.senyap = icon(sf "speaker.slash", svg "icons/senyap.svg")
  icon.komentar = icon(sf "bubble.left", svg "icons/komentar.svg")
  icon.penuh = icon(sf "arrow.up.left.and.arrow.down.right", svg "icons/penuh.svg")
  icon.bagikan = icon(sf "square.and.arrow.up", svg "icons/bagikan.svg")
  icon.bendera = icon(sf "flag", svg "icons/bendera.svg")
  icon.gambar = icon(sf "photo", svg "icons/gambar.svg")
  icon.kiri = icon(sf "chevron.left", svg "icons/kiri.svg")
  icon.surel = icon(sf "envelope", svg "icons/surel.svg")
  icon.simpan = icon(sf "bookmark", svg "icons/simpan.svg")
  icon.lampu = icon(sf "bolt", svg "icons/lampu.svg")
  icon.mundur = icon(sf "gobackward", svg "icons/mundur.svg")
  icon.maju = icon(sf "goforward", svg "icons/maju.svg")
  icon.balik = icon(sf "arrow.triangle.2.circlepath.camera", svg "icons/balik.svg")
  icon.bidik = icon(sf "location", svg "icons/bidik.svg")
  icon.kanan = icon(sf "chevron.right", svg "icons/kanan.svg")
  icon.mikMati = icon(sf "mic.slash", svg "icons/mikmati.svg")
  icon.sinyal = icon(sf "cellularbars", svg "icons/sinyal.svg")
  icon.kartu = icon(sf "creditcard", svg "icons/kartu.svg")
  icon.jam = icon(sf "clock", svg "icons/jam.svg")
  // Logo Laporin (dari LaporinLogo.png, dijiplak potrace jadi dua bagian dengan viewBox sama 276 × 75,4): "Lapor"
  // diwarnai warna teks (terang/gelap ikut tema), "in" + sinyal diwarnai merek.oranye. Ditumpuk di komponen Merek.
  icon.merekLapor = icon(sf "textformat", svg "icons/merek-lapor.svg")
  icon.merekIn = icon(sf "dot.radiowaves.right", svg "icons/merek-in.svg")
  icon.bola = icon(sf "globe", svg "icons/bola.svg")
  icon.daftar = icon(sf "list.bullet", svg "icons/daftar.svg")
  icon.lonceng = icon(sf "bell", svg "icons/lonceng.svg")
  icon.loncengMati = icon(sf "bell.slash", svg "icons/lonceng-mati.svg")
