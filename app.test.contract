// Teks diuji dalam bahasa Indonesia (strings/id.json): driver agen memakai locale en-US bila tidak disebut, dan
// strings/en.json akan dipakai untuk locale itu.
locale "id-ID"

test "tab bawah berpindah dan tombol LAPOR membuka formulir"
  tap "tab-peta"
  expect state nav.tab == "peta"
  tap "tab-profil"
  expect state nav.tab == "profil"
  tap "tombol-lapor"
  clock settle
  expect tree has "kirim"

test "formulir menolak judul kosong lalu deskripsi kosong"
  tap "tombol-lapor"
  clock settle
  tap "kirim"
  expect text "galat" == "Isi judul singkat dulu."
  type "judul" "Asap tebal di tepi jalan"
  tap "kirim"
  expect text "galat" == "Ceritakan kondisinya sedikit."

test "formulir meminta foto bukti sebelum mengirim ke server"
  tap "tombol-lapor"
  clock settle
  type "judul" "Asap tebal di tepi jalan"
  type "deskripsi" "Asap dari arah timur sejak pagi."
  tap "kirim"
  expect text "galat" == "Sertakan minimal satu foto sebagai bukti."
  expect state nav.tab == "beranda"

// Umpan dibaca dari LAPORIN_SITUS (bawaan mock-server di 127.0.0.1:4000, lihat data/build.rs).
test "umpan yang gagal dimuat menawarkan coba lagi"
  fail fetch "http://127.0.0.1:4000"
  clock data
  expect tree has "coba-lagi"

test "tamu melihat Masuk dengan Google dan email di Profil, tanpa Masuk uji"
  tap "tab-profil"
  clock settle
  expect tree has "panel-masuk"
  expect tree has "masuk-google"
  expect tree has "masuk-email"
  expect tree missing "masuk-uji"

test "tamu yang menyukai sorotan Beranda diminta masuk dulu"
  clock data
  tap "sorotan-suka"
  clock settle
  expect tree has "perlu-masuk-ya"

test "tamu yang menyimpan laporan diminta masuk dulu"
  clock data
  tap "sorotan"
  clock settle
  tap "simpan"
  clock settle
  expect text "perlu-masuk-pesan" == "Masuk dulu untuk menyimpan laporan. Melapor tetap bisa tanpa akun."
  expect tree has "perlu-masuk-ya"

test "form email menolak isian kosong dan sandi pendek saat daftar"
  tap "tab-profil"
  clock settle
  tap "masuk-email"
  tap "kirim-email"
  expect text "galat-email" == "Isi alamat email."
  tap "ganti-form-email"
  tap "kirim-email"
  expect text "galat-email" == "Isi nama Anda."
  type "daftar-nama" "Sari Warga"
  type "email" "sari@contoh.test"
  type "sandi" "pendek"
  tap "kirim-email"
  expect text "galat-email" == "Kata sandi minimal 8 karakter."

test "Ambil foto membuka kamera, dan Tutup kembali ke formulir"
  tap "tombol-lapor"
  clock settle
  tap "ambil-foto"
  clock settle
  expect tree has "tutup-kamera"
  expect tree has "rana"
  tap "tutup-kamera"
  clock settle
  expect tree has "kirim"

test "Peta: Di sekitar Anda dengan tiga mode, lembar Lapisan, dan Panduan"
  tap "tab-peta"
  clock settle
  expect text "judul-peta" == "Di sekitar Anda"
  expect tree has "peta-sekitar"
  expect tree has "peta-lokasiku"
  expect tree has "peta-nusantara"
  expect tree missing "peta-legenda"
  tap "mode-asap"
  expect tree has "peta-legenda"
  tap "peta-lapisan"
  expect tree has "lapisan-asap"
  tap "lapisan-s1"
  tap "tutup-lembar"
  expect tree missing "lapisan-asap"
  tap "mode-laporan"
  expect tree has "peta-legenda"
  tap "peta-panduan"
  expect tree has "panduan-hotspot"
  tap "topik-aerosol"
  expect tree has "panduan-aerosol"

test "Mulai live membuka Siapkan siaran yang meminta judul, lalu Tutup kembali ke tab Live"
  tap "tab-siaran"
  clock settle
  tap "mulai-live"
  clock settle
  expect tree has "mulai-siaran"
  expect text "mutu-terpilih" == "Otomatis · HD 60 fps"
  tap "pilih-mutu"
  expect tree has "mutu-hemat"
  tap "mutu-hd30"
  expect text "mutu-terpilih" == "HD 30 fps"
  expect tree missing "mutu-hemat"
  tap "mulai-siaran"
  expect text "galat-live" == "Tulis singkat apa yang sedang terjadi."
  tap "tutup-live"
  clock settle
  expect tree has "mulai-live"

// strings/en.json: locale Inggris memakai tabel terjemahan (di Android, atur-bahasa mengikuti state `bahasa` = "ID").
test "locale en-US memakai teks bahasa Inggris" on web
  locale "en-US"
  tap "tombol-lapor"
  clock settle
  tap "kirim"
  expect text "galat" == "Add a short title first."
